[Unit]
Description=Nightly disk map for disk-now (gdu over /, folders of 100 MB or more; changes nothing)
ConditionFileIsExecutable=%h/.local/bin/disk-now

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/disk-now --scan
