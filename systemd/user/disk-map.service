[Unit]
Description=Nightly disk map for disk-now (du over /, folders of 100 MB or more; changes nothing)
ConditionFileIsExecutable=%h/.local/bin/disk-now

[Service]
Type=oneshot
Nice=19
# The script sets its own lowest best-effort IO priority (ionice -c2 -n7), so idle here would
# be overridden; heavy-slot admits it by measured load.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/disk-now --scan
