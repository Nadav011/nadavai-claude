[Unit]
Description=What oh-my-claudecode changed upstream since the copy in nadavai (omc-upstream-news --notify)
ConditionFileIsExecutable=%h/.local/bin/omc-upstream-news

[Service]
Type=oneshot
Nice=19
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/omc-upstream-news --notify
# A run that fails (exit 1: upstream could not be read, or it no longer has the shape the script
# reads) shows as failed here and sends its own notification; the next month's run tries again.
