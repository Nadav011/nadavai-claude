[Unit]
Description=Remove superseded unused Docker images and old build cache (docker-tidy; never volumes)
ConditionFileIsExecutable=%h/.local/bin/docker-tidy

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/docker-tidy --apply
