[Unit]
Description=Report git worktrees nobody needs any more (worktree-clean --report; removes nothing)
ConditionFileIsExecutable=%h/.local/bin/worktree-clean

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# PATH without ~/.config/orca shims: the script calls orca-ide, never the bare orca screen reader.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Report only (Nadav, 2026-11-03: nothing is removed automatically). It writes
# ~/Archive/worktree-clean/<date>/REPORT.md; removal is `worktree-clean --apply`, run by a person or the owner session.
ExecStart=%h/.local/bin/worktree-clean --report
