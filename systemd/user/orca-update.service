[Unit]
Description=Build the newest Orca release package (orca-start installs it on the next Orca start)

[Service]
Type=oneshot
Nice=19
# 3 = the newest release could not be read (offline, or gh not logged in): the next daily run retries.
SuccessExitStatus=3
ExecStart=%h/.local/bin/orca-update --build-only
