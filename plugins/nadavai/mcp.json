{
  "mcpServers": {
    "brightdata": {
      "type": "http",
      "url": "https://mcp.brightdata.com/mcp?token=${BRIGHTDATA_API_TOKEN}&groups=social,research,advanced_scraping"
    },
    "scrapling": {
      "command": "scrapling",
      "args": [
        "mcp"
      ],
      "env": {
        "TMPDIR": "/dev/shm"
      }
    }
  }
}
