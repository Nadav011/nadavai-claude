{
  "mcpServers": {
    "brightdata": {
      "type": "http",
      "url": "https://mcp.brightdata.com/mcp?token=${BRIGHTDATA_API_TOKEN}&groups=social,research,advanced_scraping"
    },
    "scrapling": {
      "command": "scrapling",
      "args": [
        "mcp"
      ],
      "env": {
        "TMPDIR": "/dev/shm"
      }
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headersHelper": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/posthog-mcp-headers.sh"
    }
  }
}
