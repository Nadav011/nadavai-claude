{
  "mcpServers": {
    "nadavai-context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "nadavai-playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.84"]
    },
    "nadavai-chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0"]
    },
    "nadavai-scrapling": {
      "command": "scrapling",
      "args": ["mcp"],
      "env": { "TMPDIR": "/dev/shm" }
    },
    "nadavai-posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "nadavai-supabase": {
      "url": "https://mcp.supabase.com/mcp"
    },
    "nadavai-cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
