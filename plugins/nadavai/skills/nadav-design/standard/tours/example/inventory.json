{
  "$schema": "../inventory.schema.json",
  "anchorWindows": {
    "cal.ended-appointment": "screen",
    "appt.happened": "appt.drawer",
    "appt.note": "appt.drawer",
    "appt.paid": "appt.drawer",
    "pay.method": "pay.sheet",
    "pay.confirm": "pay.sheet",
    "pay.practice-receipt": "pay.sheet",
    "appt.patient-picker": "appt.create",
    "appt.service": "appt.create",
    "appt.save": "appt.create"
  },
  "pickingWindows": {
    "appt.create": true,
    "appt.drawer": false,
    "pay.sheet": false
  },
  "screens": {
    "cal-week": {
      "title": "יומן · שבוע",
      "menu": true,
      "recordAnchors": ["cal.ended-appointment", "appt.happened", "appt.note", "appt.paid", "pay.method", "pay.confirm", "pay.practice-receipt"],
      "bulkAnchors": ["cal.print"],
      "containerAnchors": ["cal.grid", "cal.appointment"],
      "tasks": [
        { "text": "לקבוע תור", "tour": "book", "anchors": ["cal.new-appointment", "appt.save"] },
        { "text": "לסגור טיפול שהסתיים", "tour": "close-1", "anchors": ["appt.happened", "appt.note", "appt.paid"] },
        { "text": "להדפיס את היומן", "anchors": ["cal.print"] }
      ]
    },
    "cal-day": {
      "title": "יומן · יום",
      "viewOf": "cal-week",
      "recordAnchors": ["cal.ended-appointment", "appt.happened", "appt.note", "appt.paid", "pay.method", "pay.confirm", "pay.practice-receipt"],
      "bulkAnchors": ["cal.print"],
      "containerAnchors": ["cal.grid", "cal.appointment"],
      "menu": true,
      "tasks": [
        { "text": "לקבוע תור", "tour": "book" },
        { "text": "לסגור טיפול שהסתיים", "tour": "close-1" }
      ]
    },
    "appt-new": {
      "title": "תור חדש",
      "menu": false,
      "recordAnchors": ["appt.patient-picker", "appt.service", "appt.save"],
      "tasks": [
        { "text": "לקבוע תור", "tour": "book", "anchors": ["appt.patient-picker", "appt.service", "appt.save"] }
      ]
    },
    "patients": {
      "title": "מטופלים",
      "menu": true,
      "containerAnchors": ["patients.row", "patients.charge"],
      "tasks": [
        { "text": "לגבות ממי שלא שילם", "tour": "pat-debt", "anchors": [{ "anchor": "patients.filter", "arg": "debt" }, "patients.charge"] }
      ]
    },
    "settings-msgs": {
      "title": "הגדרות · הודעות",
      "menu": true,
      "tasks": [
        { "text": "לשנות תזכורת", "tour": "reminder", "anchors": [{ "anchor": "settings.row-edit", "arg": "reminder-before" }, "settings.save"] }
      ]
    },
    "import": {
      "title": "ייבוא מטופלים",
      "menu": true,
      "tasks": [
        { "text": "לייבא קובץ מטופלים" }
      ]
    }
  }
}
