[Unit]
Description=Cap CPU peak clock at 4.2 GHz (2026-10-24 A/B: same average clock under the 40 W limit, 5-7C cooler than 4.6 GHz)
After=msi-turbo.service power-profiles-daemon.service

[Service]
Type=oneshot
# Re-run every minute by cpu-maxfreq.timer: on 2026-11-03 the cap applied at boot was back at
# 4.6 GHz three minutes later (the EC's Turbo switch or a cpufreq limit update resets scaling_max_freq).
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do [ "$(cat $f)" = 4200000 ] || echo 4200000 > $f; done'

[Install]
WantedBy=multi-user.target
