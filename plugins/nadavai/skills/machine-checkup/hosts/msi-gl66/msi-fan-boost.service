[Unit]
Description=MSI cooler boost under load only (on >= 80 C, off <= 65 C)
After=msi-turbo.service

[Service]
ExecStart=/usr/local/bin/msi-fan-boost
ExecStopPost=-/bin/sh -c 'echo off > /sys/devices/platform/msi-ec/cooler_boost'
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
