[Unit]
Description=MSI cooler boost for sustained load only (on: >= 85 C for 9 s, off: <= 65 C for 90 s)
After=msi-turbo.service

[Service]
ExecStart=/usr/local/bin/msi-fan-boost
ExecStopPost=-/bin/sh -c 'echo off > /sys/devices/platform/msi-ec/cooler_boost'
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
