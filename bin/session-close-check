#!/usr/bin/env python3
# session-close-check [--no-fetch] [--json] [dir ...]: can this session be closed? Read-only.
#
# Why: Nadav asks "are we done, can I close?" about 13 times a day and then checks the same things
# by hand. This answers from facts, for the git repo that holds each dir (default: the current directory;
# pass every worktree and repo the session changed), one block per repo:
#   1. working tree: uncommitted or untracked files (not git-ignored ones), a rebase, merge, cherry-pick,
#      revert or bisect in progress, and stashes on this branch or from the recent window
#   2. branch: commits not pushed (to a branch upstream; against every remote when there is none, or when the
#      upstream is main itself); other local branches checked out in no worktree whose tip is in the recent
#      window with commits on no remote and no PR merged into main
#   3. main (origin/HEAD, else origin/main or origin/master): HEAD contained in it, else a PR merged into main
#      whose head is HEAD, else the open PR
#   4. deploy (repos in lib/woodpecker-repos.txt): whether this session's landed commit is live, from
#      `nadavai-deploy pages-live` and `hold-status` over `ssh nadavai-vm`. The landed commit is HEAD when it is
#      in main and the branch is not main itself and has commits of its own (a commit, merge or cherry-pick in
#      its reflog and still reachable from HEAD), or the merge commit of its PR; main ahead of live for other
#      commits is a NOTE. When HEAD is in main with none of its own, the landed work HEAD no longer shows is looked
#      up: commits made in this worktree in the window that are in main (a commit on main itself), then the PRs
#      merged into main of the branches HEAD left in the window (by head name, so a deleted branch counts too).
#      Only with none of these is Deploy SKIP, and then ssh is not called.
#   5. other worktrees that are dirty, have commits on no remote or are not in main: listed as NOTE (other
#      sessions'), not counted
#   A repo that never had a remote is local-only: no fetch, and Branch, Main, Branches and Deploy are SKIP; when
#   its remote was removed (a clone, pull or fetch in a reflog, or a branch upstream left), Branch is UNCHECKED.
# Then once, for the machine:
#   6. nadavai: dirty, ahead/behind origin, installed plugin == HEAD (as plugins/nadavai/scripts/session-check.sh)
#   7. client-message drafts changed in the recent window
#   8. user systemd timers that fire once more and were set in the recent window (transient, fixed-date
#      OnCalendar, OnActiveSec only; age = the unit file's mtime); `atq` jobs as NOTE (their age is not readable)
# The recent window is CLOSE_CHECK_RECENT_HOURS (24) hours.
# Line statuses: OK, OPEN (counted), UNCHECKED (could not be checked: ssh, gh or fetch failed or timed out,
# --no-fetch, the deadline, a git error, a dir that does not exist, a removed remote), SKIP (not applicable: no
# deploy for this repo, a held repo, a repo that never had a remote, not a git repo) and NOTE (printed, never counted). The last line, over every dir, is
# "CLOSE: no (<n> open)" when anything is OPEN, else "CLOSE: unknown (<k> not checked: <checks>)" when anything
# is UNCHECKED, else "CLOSE: yes", or "CLOSE: yes (no git repo checked)" when no dir was in a git repo.
# Exit 0 in all three cases, 2 on an unknown option. It changes nothing; the only writes are `git fetch --quiet` of the
# repo and of nadavai (no gc). --no-fetch makes no network call at all (no fetch, gh or ssh), so the checks that
# need one are UNCHECKED. Every call has a 10 s timeout and is stopped with SIGTERM first, so git cleans its locks;
# after a total of CLOSE_CHECK_DEADLINE (60) s the remaining network checks are UNCHECKED, so the CLOSE line prints.
# Not seen: git-ignored files, unpushed submodule commits, commits reachable only from the reflog.
# Overrides (tests): NADAVAI_HOME, CLAUDE_CONFIG_DIR, CLOSE_CHECK_DRAFTS, CLOSE_CHECK_RECENT_HOURS, CLOSE_CHECK_TIMEOUT,
# CLOSE_CHECK_DEADLINE.
import json, os, re, shutil, signal, subprocess, sys, time

HOME = os.path.expanduser('~')
HERE = os.path.dirname(os.path.realpath(__file__))


def env_float(name, default):
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return float(default)


TIMEOUT = env_float('CLOSE_CHECK_TIMEOUT', 10)
HOURS = env_float('CLOSE_CHECK_RECENT_HOURS', 24)
CUT = time.time() - HOURS * 3600
DEADLINE = time.monotonic() + env_float('CLOSE_CHECK_DEADLINE', 60)  # for all network calls together
MAX_BRANCH_PRS = 10  # gh calls for other recent branches, at most
MAX_WORKTREES = 8  # worktree lines in the NOTE
ENV = dict(os.environ, LC_ALL='C', GIT_TERMINAL_PROMPT='0')
OPS = (('rebase-merge', 'rebase'), ('rebase-apply', 'rebase or am'), ('MERGE_HEAD', 'merge'),
       ('CHERRY_PICK_HEAD', 'cherry-pick'), ('REVERT_HEAD', 'revert'), ('BISECT_LOG', 'bisect'))
# Branch reflog entries that made a commit on the branch (not a checkout, reset, pull or fast-forward).
OWN = re.compile(r'(?:commit(?: \((?:amend|merge|initial)\))?|cherry-pick|revert|am|merge [^:]*: Merge made by)[:\s]')
lines = []  # (status, check, text, details, repo)
block = [None]  # the repo toplevel the next lines belong to (None: the machine-wide checks)
fetched = {}  # git common dir -> fetch result, so a repo given twice is fetched once


def add(status, check, text, details=()):
    lines.append((status, check, text, list(details), block[0]))


def net(cmd, cwd=None):
    """run() for a network call, inside the total deadline: (None, '', 'deadline reached') once it has passed."""
    left = DEADLINE - time.monotonic()
    if left <= 0:
        return None, '', 'deadline reached'
    return run(cmd, cwd=cwd, timeout=min(TIMEOUT, left))


def run(cmd, cwd=None, timeout=None):
    """(rc, stdout, stderr); rc None when the command is missing or timed out (reason in stderr).
    On a timeout the whole process group gets SIGTERM, then SIGKILL 5 s later."""
    timeout = timeout or TIMEOUT
    try:
        p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, env=ENV, start_new_session=True)
    except FileNotFoundError:
        return None, '', f'{cmd[0]} not installed'
    try:
        out, err = p.communicate(timeout=timeout)
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
            try:
                os.killpg(p.pid, sig)
            except OSError:
                pass
            try:
                p.communicate(timeout=wait)
                break
            except subprocess.TimeoutExpired:
                continue
        return None, '', f'timed out after {timeout:.3g} s'


def git(path, *args):
    rc, out, _ = run(['git', '--no-optional-locks', '-C', path, *args])
    return out.strip() if rc == 0 else None


def count(path, *args):
    out = git(path, 'rev-list', '--count', *args)
    return int(out) if out and out.isdigit() else None


def fetch(path):
    """None when fetched, else the reason (the first fatal: line). Each repo once. No gc or maintenance: the
    repo is shared by other sessions."""
    key = os.path.realpath(git(path, 'rev-parse', '--path-format=absolute', '--git-common-dir') or path)
    if key not in fetched:
        rc, _, err = net(['git', '-C', path, '-c', 'gc.auto=0', '-c', 'maintenance.auto=false', 'fetch', '--quiet', 'origin'])
        errs = [l.strip() for l in (err or '').splitlines() if l.strip()]
        first = next((l for l in errs if l.startswith('fatal:')), errs[0] if errs else f'exit {rc}')
        fetched[key] = None if rc == 0 else first[:160]
    return fetched[key]


def short(s):
    return (s or '')[:7]


def reason(err, rc=None):
    err = (err or '').strip().splitlines()
    return err[-1][:120] if err else f'exit {rc}'


def changed_files(path):
    rc, out, _ = run(['git', '--no-optional-locks', '-C', path, 'status', '--porcelain=v1', '-z', '-uall'])
    if rc != 0:
        return None
    files, parts = [], out.split('\0')
    i = 0
    while i < len(parts):
        e = parts[i]
        if len(e) > 3:
            files.append(e[3:])
            if e[0] in 'RC':
                i += 1  # the original path of a rename or copy follows
        i += 1
    return files


def main_ref(path):
    """origin's default branch (origin/HEAD), else origin/main or origin/master; None when none exists."""
    head = git(path, 'symbolic-ref', '-q', '--short', 'refs/remotes/origin/HEAD')
    for r in ([head] if head else []) + ['origin/main', 'origin/master']:
        if git(path, 'rev-parse', '--verify', '-q', r + '^{commit}'):
            return r
    return None


def has_own_commits(top, branch):
    """A commit made on the branch (from its reflog) is still reachable from HEAD. A fresh branch from main, main
    after a pull, and a branch whose own commits were dropped (reset --hard origin/main, a rebase after a squash
    merge) have none."""
    out = git(top, 'reflog', 'show', '-n', '200', '--format=%H%x09%gs', f'refs/heads/{branch}', '--')
    own = [l.split('\t', 1)[0] for l in (out or '').splitlines() if OWN.match((l.split('\t', 1) + [''])[1])]
    return any(git(top, 'merge-base', '--is-ancestor', sha, 'HEAD') is not None for sha in list(dict.fromkeys(own))[:30])


def head_reflog(top):
    """[(sha, subject)] of this worktree's HEAD reflog inside the recent window, newest first."""
    out = git(top, 'reflog', 'show', '-n', '500', '--date=unix', '--format=%gd%x09%H%x09%gs', 'HEAD', '--')
    entries = []
    for l in (out or '').splitlines():
        gd, sha, gs = (l.split('\t', 2) + ['', ''])[:3]
        m = re.search(r'@\{(\d+)\}$', gd)
        if m and int(m.group(1)) >= CUT:  # not ordered by time when GIT_COMMITTER_DATE was set: no early stop
            entries.append((sha, gs))
    return entries


def find_landed(top, mref, branch, fetch_on):
    """HEAD is in main and has no commit of its own: look for this worktree's landed work that HEAD no longer shows.
    Returns (landed commits, state, reason). Both sources are collected, because one session can have both: the
    newest commit made here in the window that is in main (on main itself, or merged without a squash), and the
    PRs merged into main of the branches HEAD left in the window (and of the current branch), found by head name,
    so also when `gh pr merge -d` deleted the branch. A PR lookup that failed stays 'pr-unknown' even when an own
    commit was found: the squash merge it could not read may be the one that is not live."""
    base = mref.split('/', 1)[1]
    log = head_reflog(top)
    own = list(dict.fromkeys(sha for sha, gs in log if OWN.match(gs)))[:30]
    landed = []
    for sha in own:  # newest first: main holds its ancestors too, so the newest one in main is enough
        if git(top, 'merge-base', '--is-ancestor', sha, mref) is not None:
            landed.append(sha)
            break
    left = [branch] if branch and branch not in ('main', 'master', base) else []
    for _, gs in log:
        m = re.match(r'checkout: moving from (\S+) to ', gs)
        b = m.group(1) if m else None
        if b and b not in left and b not in ('main', 'master', base) and not re.fullmatch(r'[0-9a-f]{40}', b):
            left.append(b)
    left = left[:3]
    if not left:
        return (landed, 'own', None) if landed else ([], 'none', None)
    if not fetch_on:
        return landed, 'pr-unknown', f'PRs of {", ".join(left)} not checked: --no-fetch'
    unknown = []
    for b in left:
        prs, why = prs_for(top, b)
        if prs is None:
            unknown.append(f'PR of {b} not checked: {why}')
            continue
        for p in prs:
            if p.get('state') == 'MERGED' and p.get('baseRefName') == base:
                oid = (p.get('mergeCommit') or {}).get('oid')
                if oid:
                    if oid not in landed:
                        landed.append(oid)
                else:
                    unknown.append(f'PR #{p.get("number")} of {b} merged, but gh gave no merge commit')
    if unknown:
        return landed, 'pr-unknown', '; '.join(unknown)
    return (landed, 'own', None) if landed else ([], 'none', None)


def prs_for(top, branch):
    """The branch's PRs from gh, or (None, reason)."""
    rc, out, err = net(['gh', 'pr', 'list', '--head', branch, '--state', 'all', '--limit', '10',
                        '--json', 'number,isDraft,url,state,headRefOid,baseRefName,mergeCommit'], cwd=top)
    try:
        prs = json.loads(out) if rc == 0 else None
    except ValueError:
        prs = None
    return (prs, None) if isinstance(prs, list) else (None, reason(err, rc))


def merged_into(prs, base, head):
    return next((p for p in prs if p.get('state') == 'MERGED' and p.get('baseRefName') == base
                 and p.get('headRefOid') == head), None)


def check_tree(top):
    files = changed_files(top)
    if files is None:
        add('UNCHECKED', 'Working tree', 'git status failed')
    elif files:
        add('OPEN', 'Working tree', f'{len(files)} uncommitted or untracked file(s) in {top}', files[:5])
    else:
        add('OK', 'Working tree', f'clean ({top})')

    paths = git(top, 'rev-parse', '--path-format=absolute', *[a for n, _ in OPS for a in ('--git-path', n)])
    if paths is None:
        add('UNCHECKED', 'Operation', 'git rev-parse --git-path failed')
    else:
        busy = [label for (_, label), p in zip(OPS, paths.splitlines()) if os.path.exists(p)]
        if busy:
            add('OPEN', 'Operation', f'{" and ".join(dict.fromkeys(busy))} in progress: finish or abort it')


def check_stash(top, branch):
    out = git(top, 'stash', 'list', '--format=%ct%x09%gd%x09%gs')
    if out is None:
        add('UNCHECKED', 'Stash', 'git stash list failed')
        return
    mine, other = [], []
    for l in out.splitlines():
        ct, ref, subj = (l.split('\t', 2) + ['', ''])[:3]
        m = re.match(r'(?:WIP on|On) (.+?): ', subj)
        on = m.group(1) if m else ''
        recent = ct.isdigit() and int(ct) >= CUT
        (mine if (branch and on == branch) or recent else other).append(f'{ref} {subj}'[:110])
    if mine:
        add('OPEN', 'Stash', f'{len(mine)} stash(es) on {branch or "this HEAD"} or from the last {HOURS:g} h', mine[:3])
    else:
        add('OK', 'Stash', 'none on this branch or from the last ' f'{HOURS:g} h')
    if other:
        add('NOTE', 'Stash', f'{len(other)} older stash(es) of other branches, not counted', other[:3])


def check_branch_and_main(top, fetch_on):
    """Branch and Main lines. Returns (head, mref, landed, state): landed is this session's commit in main or
    None; state is 'own' (landed is set), 'none' (HEAD is in main with no commit of this session's),
    'not-in-main', 'merge-unknown' (its PR merged but gh gave no merge commit) or 'local' (no remote)."""
    branch = git(top, 'symbolic-ref', '--quiet', '--short', 'HEAD')
    head = git(top, 'rev-parse', '--verify', '-q', 'HEAD')
    if git(top, 'remote') == '':
        # A clone, pull or fetch in a reflog, or a branch upstream still configured: the repo had a remote that was
        # removed, so unpushed work may be hidden. Only a repo that never had one is local-only.
        had = (git(top, 'config', '--get-regexp', r'^branch\..*\.remote$') or '') + '\n'.join(
            l for l in (git(top, 'reflog', 'show', '--all', '--format=%gs') or '').splitlines()
            if re.match(r'(?:clone|pull|fetch)\b', l))
        if had:
            add('UNCHECKED', 'Branch', f'{branch or "detached HEAD"}: the remote was removed: push state unknown')
        else:
            add('SKIP', 'Branch', f'{branch or "detached HEAD"}: local-only repo, no remote')
        add('SKIP', 'Main', f'{branch or "detached HEAD"}: {"no remote any more" if had else "local-only repo, no remote"}')
        return head, None, None, 'local'
    if fetch_on:
        why = fetch(top)
        if why:
            add('UNCHECKED', 'Fetch', f'not fetched: {why} (comparisons use the last fetched refs)')
    if not head:
        add('SKIP', 'Branch', f'{branch or "?"}: no commits yet')
        return None, None, None, 'not-in-main'
    mref = main_ref(top)
    base = mref.split('/', 1)[1] if mref else None

    # Main first: a PR merged into main also settles the Branch line.
    main_line, merged, landed, state = None, None, None, 'not-in-main'
    if not mref:
        main_line = ('UNCHECKED', 'no main ref found (origin/HEAD, origin/main, origin/master)')
    elif git(top, 'merge-base', '--is-ancestor', 'HEAD', mref) is not None:
        main_line = ('OK', f'HEAD {short(head)} is in {mref}')
        if branch and branch not in ('main', 'master', base) and has_own_commits(top, branch):
            landed, state = head, 'own'
        else:
            state = 'none'
    elif not branch:
        main_line = ('OPEN', f'detached HEAD {short(head)} is not in {mref}')
    elif not fetch_on:
        main_line = ('UNCHECKED', f'{branch} is not in {mref}; its PR not checked: --no-fetch')
    else:
        prs, why = prs_for(top, branch)
        if prs is None:
            main_line = ('UNCHECKED', f'{branch} is not in {mref}; its PR not checked: {why}')
        else:
            opn = [p for p in prs if p.get('state') == 'OPEN']
            merged = merged_into(prs, base, head)
            other = next((p for p in prs if p.get('state') == 'MERGED' and p.get('headRefOid') == head), None)
            if merged:
                main_line = ('OK', f'{branch} merged into {base} as PR #{merged["number"]}: {merged.get("url", "")}')
                landed = (merged.get('mergeCommit') or {}).get('oid')
                state = 'own' if landed else 'merge-unknown'
            elif opn:
                p = opn[0]
                main_line = ('OPEN', f'{branch} is not in {mref}; PR #{p["number"]} open into {p.get("baseRefName", "?")}'
                             f'{" (draft)" if p.get("isDraft") else ""}: {p.get("url", "")}')
            elif other:
                main_line = ('OPEN', f'{branch} merged as PR #{other["number"]} into {other.get("baseRefName", "?")}, '
                             f'not into {base}')
            else:
                main_line = ('OPEN', f'{branch} is not in {mref} and has no open PR')

    # Branch: against a real branch upstream; against every remote when there is none or it is main itself.
    if not branch:
        add('OK', 'Branch', f'detached HEAD at {short(head)}')
    else:
        info = git(top, 'for-each-ref', '--format=%(upstream:short)%09%(upstream:track)', f'refs/heads/{branch}') or ''
        up, track = (info.split('\t') + [''])[:2]
        if up and '[gone]' not in track and up != mref:
            ahead = count(top, '@{u}..HEAD')
            if ahead is None:
                add('UNCHECKED', 'Branch', f'{branch}: git rev-list against {up} failed')
            elif ahead:
                add('OPEN', 'Branch', f'{branch}: {ahead} commit(s) not pushed to {up}')
            else:
                add('OK', 'Branch', f'{branch}: pushed to {up}')
        else:
            loose = count(top, 'HEAD', '--not', '--remotes')
            where = 'upstream gone' if '[gone]' in track else (f'tracks {up}' if up else 'no upstream')
            if loose is None:
                add('UNCHECKED', 'Branch', f'{branch}: git rev-list failed')
            elif not loose:
                add('OK', 'Branch', f'{branch}: {where}, every commit is on a remote')
            elif merged:
                add('OK', 'Branch', f'{branch}: {where}, landed as PR #{merged["number"]}')
            elif main_line and main_line[0] == 'UNCHECKED' and '[gone]' in track:
                add('UNCHECKED', 'Branch', f'{branch}: upstream gone, {loose} commit(s) on no remote; '
                    'whether its PR was merged is not checked')
            else:
                add('OPEN', 'Branch', f'{branch}: {where}, {loose} commit(s) on no remote')
    add(main_line[0], 'Main', main_line[1])
    return head, mref, landed, state


def check_other_branches(top, current, mref, fetch_on):
    """Recent local branches checked out in no worktree (a branch checked out elsewhere is that worktree's,
    listed under Worktrees)."""
    out = git(top, 'for-each-ref', '--format=%(refname:short)%09%(objectname)%09%(committerdate:unix)%09%(worktreepath)',
              'refs/heads')
    if out is None:
        add('UNCHECKED', 'Branches', 'git for-each-ref failed')
        return
    base = mref.split('/', 1)[1] if mref else None
    loose, unchecked, calls = [], [], 0
    for l in out.splitlines():
        name, sha, ct, wt = (l.split('\t') + ['', '', ''])[:4]
        if name == current or wt or not ct.isdigit() or int(ct) < CUT:
            continue
        n = count(top, sha, '--not', '--remotes')
        if n is None:
            unchecked.append(f'{name}: git rev-list failed')
            continue
        if not n:
            continue
        if not fetch_on:
            unchecked.append(f'{name}: {n} commit(s) on no remote; PR not checked: --no-fetch')
            continue
        if calls >= MAX_BRANCH_PRS:
            unchecked.append(f'{name}: {n} commit(s) on no remote; PR not checked: more than {MAX_BRANCH_PRS} branches')
            continue
        calls += 1
        prs, why = prs_for(top, name)
        if prs is None:
            unchecked.append(f'{name}: {n} commit(s) on no remote; PR not checked: {why}')
        elif not (base and merged_into(prs, base, sha)):
            loose.append(f'{name}: {n} commit(s) on no remote')
    if loose:
        add('OPEN', 'Branches', f'{len(loose)} other local branch(es) changed in the last {HOURS:g} h with commits on '
            f'no remote and no PR merged into {base or "main"}', loose[:5] + ([f'+{len(loose) - 5} more'] if len(loose) > 5 else []))
    if unchecked:
        add('UNCHECKED', 'Branches', f'{len(unchecked)} other recent local branch(es) not fully checked', unchecked[:5])
    if not loose and not unchecked:
        add('OK', 'Branches', f'no other local branch from the last {HOURS:g} h with unpushed or unmerged work')


def repo_names(top):
    names = set()
    common = git(top, 'rev-parse', '--path-format=absolute', '--git-common-dir')
    if common:
        names.add(os.path.basename(os.path.dirname(common.rstrip('/'))))
    names.add(os.path.basename(top))
    url = git(top, 'remote', 'get-url', 'origin')
    if url:
        names.add(re.sub(r'\.git$', '', url.rstrip('/').split('/')[-1].split(':')[-1]))
    return names


def check_deploy(top, mref, landed, state, fetch_on):
    try:
        with open(os.path.join(HERE, '..', 'lib', 'woodpecker-repos.txt')) as f:
            known = [l.strip() for l in f if l.strip() and not l.startswith('#')]
    except OSError:
        add('UNCHECKED', 'Deploy', 'lib/woodpecker-repos.txt not readable')
        return
    hits = [r for r in known if r in repo_names(top)]
    if not hits:
        return  # not a deployed repo: no line
    repo = hits[0]
    if not re.fullmatch(r'[A-Za-z0-9._-]+', repo):
        add('UNCHECKED', 'Deploy', f'{repo}: unexpected repo name')
        return
    landed = [landed] if landed else []
    if state == 'none':
        landed, state, why = find_landed(top, mref, git(top, 'symbolic-ref', '--quiet', '--short', 'HEAD'), fetch_on)
        if state == 'pr-unknown':
            add('UNCHECKED', 'Deploy', f'{repo}: HEAD is in {mref}; whether this session landed work it left: {why}')
            return
    if state == 'none':  # nothing of this session's to deploy: no ssh, so an unreachable VM changes nothing
        add('SKIP', 'Deploy', f'{repo}: no commit of this session to deploy (HEAD is in {mref}, none of its own, '
            f'no PR merged from a branch it left in the last {HOURS:g} h)')
        return
    if not fetch_on:
        add('UNCHECKED', 'Deploy', f'{repo}: not checked: --no-fetch')
        return
    if state == 'merge-unknown':
        add('UNCHECKED', 'Deploy', f'{repo}: this session\'s PR is merged, but gh gave no merge commit to compare '
            'with live')
        return
    remote = (f'nadavai-deploy hold-status {repo} 2>&1; echo "rc=$?"; '
              f'nadavai-deploy pages-live {repo} 2>&1; echo "rc=$?"')
    rc, out, err = net(['ssh', '-o', 'ConnectTimeout=8', '-o', 'BatchMode=yes', 'nadavai-vm', remote])
    parts = re.findall(r'(.*?)\nrc=(\d+)\n', out or '', re.S)
    if rc != 0 or len(parts) != 2:
        add('UNCHECKED', 'Deploy', f'{repo}: not checked: ssh nadavai-vm: {reason(err, rc)}')
        return
    (hold, hrc), (live, lrc) = [(t.strip(), int(c)) for t, c in parts]
    if lrc == 2 or hrc == 2:
        add('SKIP', 'Deploy', f'{repo}: not handled by the deploy service')
        return
    if lrc != 0:
        add('UNCHECKED', 'Deploy', f'{repo}: live commit not readable: {reason(live, lrc)}')
        return
    fields = live.split()
    live_sha = fields[1] if len(fields) >= 2 else '-'
    main_sha = git(top, 'rev-parse', mref) if mref else None
    if not main_sha or not re.fullmatch(r'[0-9a-f]{7,40}', live_sha) or not git(top, 'rev-parse', '--verify', '-q',
                                                                                  live_sha + '^{commit}'):
        add('UNCHECKED', 'Deploy', f'{repo}: live "{live}" not comparable with {mref or "main"} (not in this clone?)')
        return
    gap = count(top, f'{live_sha}..{main_sha}')
    others = (f'{mref} is {gap} commit(s) ahead of live {short(live_sha)}' if gap else
              f'live {short(live_sha)} is not on {mref}') if not main_sha.startswith(live_sha) else ''
    gone = [c for c in landed if git(top, 'merge-base', '--is-ancestor', c, live_sha) is None]
    if gone:
        text = f'{repo}: this session\'s commit {short(gone[0])} is in {mref} but not live (live {short(live_sha)})'
        if hold in ('held', 'off'):
            add('SKIP', 'Deploy', f'{text}; deploys are {hold}, so not this session\'s to deploy')
        else:
            add('OPEN', 'Deploy', f'{text}: ssh nadavai-vm nadavai-deploy deploy {repo} {main_sha}')
        return
    if landed:
        add('OK', 'Deploy', f'{repo}: production serves this session\'s commit {short(landed[0])} (hold-status: {hold})')
    else:
        add('SKIP', 'Deploy', f'{repo}: this session\'s work is not in {mref} yet (hold-status: {hold})')
    if others:
        add('NOTE', 'Deploy', f'{others}: other sessions\' merges, not counted (hold-status: {hold})')


def check_worktrees(top, mref, local, checked):
    """Other worktrees of the repo that are dirty, have commits on no remote, or whose HEAD is not in main.
    Worktrees in `checked` (given as dirs themselves) have their own block and are left out."""
    out = git(top, 'worktree', 'list', '--porcelain')
    if out is None:
        add('UNCHECKED', 'Worktrees', 'git worktree list failed')
        return
    here = os.path.realpath(top)
    others, found = 0, []
    for blk in out.split('\n\n'):
        e = dict((l.split(' ', 1) + [''])[:2] for l in blk.splitlines() if l)
        p = e.get('worktree')
        if not p or 'bare' in e or os.path.realpath(p) in (here, *checked):
            continue
        others += 1
        why, sha = [], e.get('HEAD')
        if os.path.isdir(p):
            files = changed_files(p)
            if files is None:
                why.append('git status failed')
            elif files:
                why.append(f'{len(files)} uncommitted file(s)')
        if sha and not local:
            n = count(top, sha, '--not', '--remotes')
            if n is None:
                why.append('git rev-list failed')
            elif n:
                why.append(f'{n} commit(s) on no remote')
            if mref and git(top, 'merge-base', '--is-ancestor', sha, mref) is None:
                why.append(f'not in {mref}')
        if why:
            where = e['branch'].removeprefix('refs/heads/') if e.get('branch') else f'detached {short(sha)}'
            gone = '' if os.path.isdir(p) else ', directory missing'
            found.append(f'{p} ({where}{gone}): {", ".join(why)}')
    if found:
        add('NOTE', 'Worktrees', f'{len(found)} other worktree(s) with uncommitted, unpushed or unmerged work, not counted '
            '(other sessions\'; name any that are this session\'s)',
            found[:MAX_WORKTREES] + ([f'+{len(found) - MAX_WORKTREES} more'] if len(found) > MAX_WORKTREES else []))
    else:
        add('OK', 'Worktrees', f'no other worktree with uncommitted, unpushed or unmerged work ({others} other(s))')


def check_nadavai(fetch_on):
    repo = os.environ.get('NADAVAI_HOME') or os.path.join(HOME, 'nadavai')
    if not os.path.isdir(os.path.join(repo, '.git')):
        add('SKIP', 'nadavai', f'{repo} is not a git checkout')
        return
    start = len(lines)
    files = changed_files(repo)
    if files is None:
        add('UNCHECKED', 'nadavai', 'git status failed')
    elif files:
        add('OPEN', 'nadavai', f'{len(files)} uncommitted file(s) in {repo}', files[:5])
    if fetch_on:  # once: a repo block of nadavai itself already fetched it
        why = fetch(repo)
        if why:
            add('UNCHECKED', 'nadavai', f'not fetched: {why}')
    ahead, behind = count(repo, '@{u}..HEAD'), count(repo, 'HEAD..@{u}')
    if ahead is None or behind is None:
        add('UNCHECKED', 'nadavai', 'no upstream, or git rev-list failed: push state unknown')
    if ahead:
        add('OPEN', 'nadavai', f'{ahead} commit(s) not pushed to origin')
    if behind:
        add('OPEN', 'nadavai', f'origin has {behind} newer commit(s): run {repo}/update.sh')
    head = git(repo, 'rev-parse', 'HEAD')
    cfg = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(HOME, '.claude')
    installed = git(os.path.join(cfg, 'plugins', 'marketplaces', 'nadavai'), 'rev-parse', 'HEAD')
    if not installed:
        add('UNCHECKED', 'nadavai', 'installed plugin not found')
    elif installed != head and ahead == 0 and behind == 0:
        add('OPEN', 'nadavai', f'installed plugin is at {short(installed)}, repo at {short(head)}: run {repo}/update.sh')
    if len(lines) == start:
        add('OK', 'nadavai', f'clean, pushed and installed ({short(head)}){"" if fetch_on else ", not fetched"}')


def check_drafts():
    d = os.environ.get('CLOSE_CHECK_DRAFTS') or os.path.join(HOME, '.local', 'state', 'client-messages', 'drafts')
    try:
        entries = sorted(((os.path.getmtime(os.path.join(d, n)), n) for n in os.listdir(d)), reverse=True)
    except OSError:
        add('OK', 'Client messages', f'no drafts folder ({d})')
        return
    recent = [n for t, n in entries if t >= CUT]
    old = len(entries) - len(recent)
    if recent:
        add('OPEN', 'Client messages', f'{len(recent)} draft(s) changed in the last {HOURS:g} h, confirm each was sent '
            f'or dropped ({old} older not counted; {d})', recent[:10])
    else:
        add('OK', 'Client messages', f'no draft changed in the last {HOURS:g} h ({old} older, not counted)')


def check_timers():
    rc, out, err = run(['systemctl', '--user', 'list-timers', '--all', '--no-pager', '--output=json'])
    timers = None
    if rc == 0:
        try:
            timers = {t['unit']: t.get('next') for t in json.loads(out) if t.get('unit') and t.get('next')}
        except (ValueError, TypeError, KeyError):
            pass
    if timers is None:
        add('UNCHECKED', 'Timers', f'systemd user timers not read: {reason(err, rc)}')
    else:
        new, old, recurring = [], [], 0
        if timers:
            _, props, _ = run(['systemctl', '--user', 'show', '-p', 'Id', '-p', 'Transient', '-p', 'FragmentPath',
                               '-p', 'TimersCalendar', '-p', 'TimersMonotonic', *timers])
            for block in (props or '').split('\n\n'):
                m = re.search(r'^Id=(.+)$', block, re.M)
                if not m or m.group(1) not in timers:
                    continue
                uid = m.group(1)
                cal = re.findall(r'OnCalendar=([^;]*);', block)
                mono = re.findall(r'^TimersMonotonic=\{ (On\w+)=', block, re.M)
                transient = re.search(r'^Transient=yes$', block, re.M) is not None
                fixed = bool(cal) and not mono and all(re.fullmatch(r'\s*\d{4}-\d{2}-\d{2}[ \d:]*', c) for c in cal)
                active_only = bool(mono) and not cal and set(mono) <= {'OnActiveUSec'}
                if not (transient or fixed or active_only):
                    recurring += 1
                    continue
                frag = (re.search(r'^FragmentPath=(.*)$', block, re.M) or [None, ''])[1]
                try:
                    is_new = transient or os.lstat(frag).st_mtime >= CUT
                except OSError:
                    is_new = True
                when = time.strftime('%Y-%m-%d %H:%M', time.localtime(timers[uid] / 1e6))
                (new if is_new else old).append(f'{uid} at {when}')
        if new:
            add('OPEN', 'Timers', f'{len(new)} one-shot user timer(s) set in the last {HOURS:g} h, still to fire: '
                'confirm each is wanted', new[:5] + ([f'+{len(new) - 5} more'] if len(new) > 5 else []))
        add('OK', 'Timers', f'{recurring} recurring user timer(s); {len(old)} older one-shot(s), not counted', old[:5])
    if shutil.which('atq'):
        rc, out, err = run(['atq'])
        jobs = [l for l in (out or '').splitlines() if l.strip()]
        if rc != 0:
            add('UNCHECKED', 'at', f'atq failed: {reason(err, rc)}')
        elif jobs:
            add('NOTE', 'at', f'{len(jobs)} at job(s) queued, not counted (atq shows no age): name any this session set',
                jobs[:5])
        else:
            add('OK', 'at', 'no queued jobs')


def check_repo(top, fetch_on, checked):
    branch = git(top, 'symbolic-ref', '--quiet', '--short', 'HEAD')
    check_tree(top)
    check_stash(top, branch)
    head, mref, landed, state = check_branch_and_main(top, fetch_on)
    if state == 'local':
        for c in ('Branches', 'Deploy'):
            add('SKIP', c, 'local-only repo, no remote')
    elif head:
        check_other_branches(top, branch, mref, fetch_on)
        check_deploy(top, mref, landed, state, fetch_on)
    check_worktrees(top, mref, state == 'local', checked)


USAGE = 'usage: session-close-check [--no-fetch] [--json] [dir ...]'


def main(argv):
    fetch_on, as_json, targets = True, False, []
    for a in argv:
        if a == '--no-fetch':
            fetch_on = False
        elif a == '--json':
            as_json = True
        elif a in ('-h', '--help'):
            head = open(os.path.realpath(__file__)).read().split('\nimport ')[0].splitlines()[1:]
            print('\n'.join(re.sub(r'^# ?', '', l) for l in head))
            return 0
        elif a.startswith('-'):
            print(f'session-close-check: unexpected argument {a}\n{USAGE}', file=sys.stderr)
            return 2
        else:
            targets.append(os.path.abspath(a))
    targets = targets or [os.path.abspath('.')]

    missing = [t for t in targets if not os.path.isdir(t)]
    tops = {t: git(t, 'rev-parse', '--show-toplevel') for t in targets if t not in missing}
    repos = list(dict.fromkeys(top for top in tops.values() if top))  # a repo given twice is checked once
    not_repos = [t for t, top in tops.items() if not top]
    checked = {os.path.realpath(top) for top in repos}
    for t in missing:  # a removed worktree, a typo: not checked, so never a yes
        block[0] = t
        add('UNCHECKED', 'Repo', f'{t}: no such directory')
    for t in not_repos:
        block[0] = t
        add('SKIP', 'Repo', f'{t} is not in a git repo: pass each repo or worktree this session changed as an argument')
    for top in repos:
        block[0] = top
        check_repo(top, fetch_on, checked)
    block[0] = None
    check_nadavai(fetch_on)
    check_drafts()
    check_timers()

    n_open = sum(1 for l in lines if l[0] == 'OPEN')
    many = len(repos) > 1
    unchecked = [f'{l[1]} ({os.path.basename(l[4])})' if many and l[4] in repos else l[1]
                 for l in lines if l[0] == 'UNCHECKED']
    if n_open:
        verdict, close = 'no', f'CLOSE: no ({n_open} open)'
    elif unchecked:
        names = ', '.join(dict.fromkeys(unchecked))
        verdict, close = 'unknown', f'CLOSE: unknown ({len(unchecked)} not checked: {names})'
    else:
        verdict, close = 'yes', 'CLOSE: yes' if repos else 'CLOSE: yes (no git repo checked)'
    if as_json:
        print(json.dumps({'dir': targets[0], 'repo': tops.get(targets[0]),
                          'dirs': [{'dir': t, 'repo': tops.get(t)} for t in targets],
                          'not_repos': not_repos, 'missing': missing, 'close': verdict, 'open': n_open, 'unchecked': len(unchecked),
                          'checks': [{'status': s, 'check': c, 'text': t, 'details': d, 'repo': r}
                                     for s, c, t, d, r in lines]},
                         ensure_ascii=False, indent=1))
        return 0
    last = object()
    for s, c, t, d, r in lines:
        if r != last:
            last = r
            print(f'== {r}' if r else '== this machine: nadavai, client messages, timers')
        print(f'{s:<9} {c}: {t}')
        for x in d:
            print(f'            {x}')
    print(close)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
