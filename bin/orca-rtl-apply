#!/usr/bin/env bash
# Re-apply the Orca terminal RTL/BiDi patch (idempotent). Run after an Orca update.
# Patches the vendored xterm DOM renderer so Hebrew renders right-to-left while
# English/numbers stay LTR-correct. Requires passwordless sudo + DOM renderer
# (Settings -> terminal GPU acceleration = OFF; the patch is inert under WebGL).
set -euo pipefail
# The engine lives in nadavai (lib/orca-rtl); runtime data (backups, node_modules for
# the old layout) stays in ~/.local/share/orca-rtl.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/../lib/orca-rtl" && pwd)"
ASAR=/opt/Orca/resources/app.asar
MARK=orca-rtl-chat
# Newer Orca keeps out/renderer unpacked next to the asar; the mark then lives there.
CSSDIR=/opt/Orca/resources/app.asar.unpacked/out/renderer/assets
patched() { if [ -d "$CSSDIR" ]; then grep -lq "$MARK" "$CSSDIR"/*.css 2>/dev/null; else grep -aq "$MARK" "$ASAR"; fi; }

# ponytail: the .path unit fires on the FIRST inotify event of a dpkg upgrade and
# does not re-queue while this service runs. On 1.4.155 that made patch.mjs read the
# pre-upgrade asar, log "already patched", and leave the NEW asar unpatched silently.
# Wait for size+mtime to hold still, then verify against the live file and retry once.
settle() {
  local prev="" cur
  # pacman writes app.asar early and the thousands of unpacked files after it: also wait for
  # its database lock to go, or the patch lands on a half-extracted tree.
  for _ in $(seq 60); do
    cur=$(stat -c '%Y %s' "$ASAR" 2>/dev/null || echo missing)
    if [ "$cur" != missing ] && [ "$cur" = "$prev" ] && [ ! -e /var/lib/pacman/db.lck ]; then return 0; fi
    prev=$cur
    sleep 2
  done
}

# One apply at a time: the .path unit, orca-update and a hand run share the same
# `<file>.orca-rtl-new` sibling names and would otherwise break each other's rename.
mkdir -p "$HOME/.local/share/orca-rtl"
exec 8>"$HOME/.local/share/orca-rtl/.apply.lock"
flock 8

# A failed patch.mjs may already have written some files; the asar header must still be brought
# in line with them, or Orca opens a white window (1.4.246).
run_patch() {
  if ! node "$DIR/patch.mjs" "$@"; then
    echo "[orca-rtl] patch.mjs FAILED; syncing the asar header with whatever it wrote"
    if [ -d "$CSSDIR" ]; then node "$DIR/sync-header.mjs" "$ASAR" || true; fi
    exit 1
  fi
}

settle
run_patch "$@"

# The asar can still be swapped while we extract/repack (a ~2 min window).
if ! patched; then
  echo "[orca-rtl] live asar is unpatched (replaced mid-run) — retrying once"
  settle
  run_patch "$@"
  patched || { echo "[orca-rtl] FAILED: live asar still unpatched"; exit 1; }
fi
echo "[orca-rtl] verified: live Orca carries the patch."

# The pointer part (selection, double click and link clicks landing on the characters under the
# pointer in a Hebrew row) is left out when its hooks do not fit this Orca build, while Hebrew
# itself keeps reading right to left. Say so where Nadav sees it: without this he only meets it
# as a selection that takes the wrong text.
if [ -d "$CSSDIR" ] && [ -z "${ORCA_RTL_NO_MOUSE:-}" ] && ! grep -lq '__orcaRtlMouse.coords(' "$CSSDIR"/*.js 2>/dev/null; then
  echo "[orca-rtl] WARNING: the pointer part is NOT in this Orca: selection and link clicks in Hebrew rows are off until lib/orca-rtl/patch.mjs fits this build (tests/orca-rtl-mouse.sh shows what fails)"
  notify-send -a Orca "סימון בעברית ב-Orca לא מדויק בגרסה הזאת" "העברית בטרמינל תקינה, אבל סימון ולחיצה על קישורים בשורות עברית יפגעו במקום אחר עד שהתיקון יותאם לגרסה. פירוט: orca-rtl-apply" 2>/dev/null || true
fi

# Unpacked layout: Electron reads those files by the size in app.asar's header, so a
# patched file that grew is cut off and Orca opens a white window (1.4.246, 2026-11-03).
# Record the new sizes; if that cannot be done safely, put the originals back.
if [ -d "$CSSDIR" ] && ! node "$DIR/sync-header.mjs" "$ASAR"; then
  echo "[orca-rtl] FAILED to update the asar header; restoring the original files"
  "$(dirname "$(readlink -f "$0")")/orca-rtl-remove"
  exit 1
fi

# The phone checks each mobile-web asset against manifest.json and the desktop refuses to serve
# one that differs (mobile_web_bundle_asset_changed), so the phone cannot install the page bundle:
# "cannot run the latest update from the computer" (1.4.247, 2026-11-09). patch.mjs re-syncs the
# manifest; fail loudly here if anything still differs.
if ! node "$DIR/patch.mjs" --check-manifest; then
  echo "[orca-rtl] FAILED: the phone bundle's manifest does not match the patched files"
  exit 1
fi
