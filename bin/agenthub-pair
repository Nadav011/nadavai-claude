#!/usr/bin/env bash
set -euo pipefail

TOKEN_FILE="${AGENT_HUB_TOKEN_FILE:-$HOME/.config/agent-hub/token}"
# Default: this machine's own Tailscale HTTPS name (agenthub runs on whichever machine is the main one).
TS_HOST="$(tailscale status --json 2>/dev/null | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null || true)"
PAIRING_URL="${AGENT_HUB_PAIRING_URL:-https://${TS_HOST:-msi.tailda1373.ts.net}:9443}"
QR_VIEWER="${AGENT_HUB_QR_VIEWER:-xdg-open}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

fail() {
  printf 'agenthub-pair: %s\n' "$1" >&2
  exit 1
}

[[ -f "$TOKEN_FILE" ]] || fail "קובץ קוד הגישה לא נמצא"
[[ "$(stat -c '%a' "$TOKEN_FILE")" == "600" ]] || fail "קובץ קוד הגישה חייב להיות בהרשאת 0600"
command -v python3 >/dev/null 2>&1 || fail "python3 אינו מותקן"
python3 -c 'import qrcode' >/dev/null 2>&1 || fail "החבילה המקומית python-qrcode אינה מותקנת"
[[ -x "$QR_VIEWER" ]] || command -v "$QR_VIEWER" >/dev/null 2>&1 || fail "מציג התמונות אינו זמין"
[[ -d "$RUNTIME_DIR" ]] || fail "תיקיית runtime אינה קיימת"

IFS= read -r TOKEN <"$TOKEN_FILE"
[[ ${#TOKEN} -ge 24 && ${#TOKEN} -le 4096 && ! "$TOKEN" =~ [[:space:]] ]] || fail "קוד הגישה בקובץ אינו תקין"

umask 077
QR_PATH="$(mktemp "$RUNTIME_DIR/agenthub-pairing-XXXXXX.png")"
cleanup() {
  rm -f -- "$QR_PATH"
  unset TOKEN AGENT_HUB_PAIRING_TOKEN
}
trap cleanup EXIT HUP INT TERM

export AGENT_HUB_PAIRING_TOKEN="$TOKEN"
export AGENT_HUB_PAIRING_URL="$PAIRING_URL"
export AGENT_HUB_PAIRING_QR="$QR_PATH"
python3 - <<'PY'
import os
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

import qrcode

base_url = os.environ["AGENT_HUB_PAIRING_URL"].rstrip("/")
token = os.environ["AGENT_HUB_PAIRING_TOKEN"]
path = os.environ["AGENT_HUB_PAIRING_QR"]
parsed = urlsplit(base_url)
if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment:
    raise SystemExit("invalid secure pairing URL")
query = dict(parse_qsl(parsed.query, keep_blank_values=True))
query["token"] = token
if parsed.port is not None:
    query["daemon_port"] = str(parsed.port)
pairing_path = f"{parsed.path.rstrip('/')}/"
pairing_url = urlunsplit((parsed.scheme, parsed.netloc, pairing_path, urlencode(query), ""))
qrcode.make(pairing_url).save(path)
PY
unset AGENT_HUB_PAIRING_TOKEN

printf 'קוד הצימוד פתוח. סרוק אותו באייפון וסגור את החלון בסיום.\n'
case "$(basename "$QR_VIEWER")" in
  eog) "$QR_VIEWER" --new-instance "$QR_PATH" ;;
  *) "$QR_VIEWER" "$QR_PATH" ;;
esac
