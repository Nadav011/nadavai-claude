#!/usr/bin/env bash
# heavy-slot: run a heavy local job (a build, a full suite, e2e, DoD, a DB replay) when this
# machine has room for it, so agents never stack more of them than the machine holds.
#
#   heavy-slot [--slots N] -- <command...>
#   heavy-slot --status        what runs, what waits and what the machine measures now
#
# Admission is by measured load, not by a fixed count. The first heavy_floor jobs start
# without looking at the CPU or the disk (the first two whatever the machine measures, the
# others while memory and swap have room). A job beyond the floor starts when all of these
# hold, and otherwise says which one does not, once a minute:
#   - 10 s have passed since the last such start, so the job before it shows in the numbers;
#   - at least heavy_mem_min_gb GB of memory is available, swap is under heavy_swap_max percent
#     used (systemd-oomd kills a terminal at 90), and memory pressure is under 10%;
#   - disk pressure is under 40% (iowait looks like an idle CPU, so it is asked separately);
#   - CPU pressure is under 40% and the CPU is under heavy_cpu_max percent busy over one second.
# Pressure is the kernel's own "some avg10" in /proc/pressure. heavy_slots is only the ceiling.
# Waiting jobs start in arrival order. Why not a count: on 2026-11-10 six jobs that used a
# third of the CPU held all six slots for over an hour while fifteen waited; started together,
# the same jobs took the CPU to 100% busy, so no fixed number is right.
#
# Settings, one per line as key=value (# for comments), in
# ${XDG_CONFIG_HOME:-~/.config}/nadavai/capacity, one file per host:
#   heavy_slots=24         # ceiling (default: the number of CPUs)
#   heavy_floor=8          # always admitted (default: a third of the CPUs, at least 2)
#   heavy_cpu_max=85       # percent busy at which jobs beyond the floor wait (default 85)
#   heavy_mem_min_gb=8     # GB available under which they wait (default 8)
#   heavy_swap_max=80      # percent of swap used at which they wait (default 80)
#   pg_pool_leases=12      # live pg-pool databases at once (pg-pool)
#   browser_agents=3       # browser-driving subagents at once (rules/machine-load.md)
# --slots N is a strict count for one call: N at once, no load check and no queue.
#
# Slot files live in ~/.cache/heavy-slot/ for every caller, so all of them share one pool, and
# the queue in ~/.cache/heavy-slot/queue/. Each slot is taken with flock. This process holds
# the lock and runs the command as its child, in the same process group (a group kill or
# `timeout -s KILL` reaches both; /dev/tty and Ctrl-Z behave as without heavy-slot), without
# the lock fd, so a daemon the command leaves behind never keeps a slot. TERM, INT and HUP sent
# to this process are passed to the command, and the slot stays held until the command has
# ended; then this exits 128+signal. Otherwise the command's exit code is passed through. The
# command runs through `bash -c 'exec "$@"'`, so its words mean what they would to bash
# (FOO=bar cmd is a command named FOO=bar, an error).
# What still escapes: a SIGKILL of this process frees the slot at once. The command itself then
# gets TERM (setpriv --pdeathsig, where setpriv exists), but its own children do not, and a
# signal sent to this process alone (not the group) reaches only the command, not its children.
#
# Nested calls do not deadlock: the command runs with HEAVY_SLOT_HELD=<pid>:<start time> of
# this process, and a heavy-slot whose ancestors include that live process runs its command
# directly. Any other value is ignored.
set -uo pipefail

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit "${1:-0}"; }

slots="" strict=0 want_status=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --status) want_status=1 ;;
    --slots) slots=${2:-}; strict=1; shift ;;
    --slots=*) slots=${1#*=}; strict=1 ;;
    --) shift; break ;;
    -*) echo "heavy-slot: unknown option $1" >&2; usage 64 >&2 ;;
    *) break ;;
  esac
  shift
done
[ "$want_status" = 1 ] || [ $# -gt 0 ] || usage 64 >&2

stat_field() { [ -r "/proc/$1/stat" ] && awk -v f="$2" '{ sub(/^.*\) /, ""); print $(f - 2) }' "/proc/$1/stat"; }

# HEAVY_SLOT_HELD counts only when its process is alive and one of this process's ancestors.
held=${HEAVY_SLOT_HELD:-}
if [ "$want_status" = 0 ] && [[ $held =~ ^([0-9]+):([0-9]+)$ ]] && [ "$(stat_field "${BASH_REMATCH[1]}" 22)" = "${BASH_REMATCH[2]}" ]; then
  holder=${BASH_REMATCH[1]} p=$$
  while [ "$p" -gt 1 ] && [ "$p" != "$holder" ]; do p=$(stat_field "$p" 4) || break; done
  # shellcheck disable=SC2016  # expanded by the inner bash
  [ "$p" = "$holder" ] && exec bash -c 'exec "$@"' _ "$@"
fi

# --all: plain nproc follows OMP_NUM_THREADS and the CPU affinity, and every caller must see one pool.
cores=$(nproc --all 2>/dev/null || echo 4)
floor="" cpu_max="" mem_min="" swap_max=""
conf=${XDG_CONFIG_HOME:-$HOME/.config}/nadavai/capacity
if [ -r "$conf" ]; then
  while IFS='=' read -r k v; do
    k=${k//[[:space:]]/}; v=${v%%#*}; v=${v//[[:space:]]/}
    case $k in
      heavy_slots) [ "$strict" = 0 ] && slots=$v ;;
      heavy_floor) floor=$v ;;
      heavy_cpu_max) cpu_max=$v ;;
      heavy_mem_min_gb) mem_min=$v ;;
      heavy_swap_max) swap_max=$v ;;
    esac
  done <"$conf"
fi
slots=${slots:-$cores}
if [ -z "$floor" ]; then floor=$((cores / 3)); [ "$floor" -lt 2 ] && floor=2; fi
cpu_max=${cpu_max:-85} mem_min=${mem_min:-8} swap_max=${swap_max:-80}
[[ $slots =~ ^[1-9][0-9]*$ ]] || { echo "heavy-slot: slots must be a positive whole number, got '$slots'" >&2; exit 64; }
[[ $floor =~ ^[1-9][0-9]*$ ]] || { echo "heavy-slot: heavy_floor must be a positive whole number, got '$floor'" >&2; exit 64; }
[[ $cpu_max =~ ^[1-9][0-9]*$ ]] && [ "$cpu_max" -le 100 ] || { echo "heavy-slot: heavy_cpu_max must be 1-100, got '$cpu_max'" >&2; exit 64; }
[[ $mem_min =~ ^[0-9]+$ ]] || { echo "heavy-slot: heavy_mem_min_gb must be a whole number, got '$mem_min'" >&2; exit 64; }
[[ $swap_max =~ ^[1-9][0-9]*$ ]] && [ "$swap_max" -le 100 ] || { echo "heavy-slot: heavy_swap_max must be 1-100, got '$swap_max'" >&2; exit 64; }
# A strict count, or a ceiling under the floor, leaves no job to the load check.
{ [ "$strict" = 1 ] || [ "$floor" -gt "$slots" ]; } && floor=$slots
gap=10 cpu_psi_max=40 io_psi_max=40 mem_psi_max=10
# The tests point this at a directory with meminfo, pressure/{cpu,memory,io}, busy (a number)
# and, to run faster, gap and stale (seconds).
proc=${HEAVY_SLOT_TEST_PROC:-/proc}
stale=20   # a waiting job that gave no sign of life for this long keeps its ticket but not its turn
if [ "$proc" != /proc ]; then
  [ -r "$proc/gap" ] && read -r gap <"$proc/gap"
  [ -r "$proc/stale" ] && read -r stale <"$proc/stale"
fi

dir=$HOME/.cache/heavy-slot
qdir=$dir/queue
mkdir -p "$qdir" || { echo "heavy-slot: cannot create $qdir" >&2; exit 1; }

cpu_busy() { # percent of all CPUs busy over one second; iowait counts as idle
  if [ "$proc" != /proc ]; then cat "$proc/busy" 2>/dev/null || echo 0; return; fi
  local u n s i w q sq st u2 n2 s2 i2 w2 q2 sq2 st2 busy total
  read -r _ u n s i w q sq st _ </proc/stat || { echo 0; return; }
  sleep 1
  read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ </proc/stat || { echo 0; return; }
  busy=$(((u2 + n2 + s2 + q2 + sq2 + st2) - (u + n + s + q + sq + st)))
  total=$((busy + (i2 + w2) - (i + w)))
  if [ "$total" -gt 0 ]; then echo $((100 * busy / total)); else echo 0; fi
}
psi() { # whole percent of "some avg10" for cpu, memory or io; 0 when the kernel has no PSI
  local l=""
  read -r l <"$proc/pressure/$1" || true
  [[ $l == some*avg10=* ]] || { echo 0; return; }
  l=${l#*avg10=}; l=${l%%.*}
  [[ $l =~ ^[0-9]+$ ]] && echo "$l" || echo 0
} 2>/dev/null
mem_state() { # "<GB available> <percent of swap used>"; a failed read never blocks a job
  awk '/^MemAvailable:/ { a = $2; fa = 1 } /^SwapTotal:/ { t = $2 } /^SwapFree:/ { f = $2 }
       END { printf "%d %d\n", (fa ? a / 1048576 : 999), (t > 0 ? 100 * (t - f) / t : 0) }' "$proc/meminfo" 2>/dev/null || echo "999 0"
}

why=""
mem_ok() { # is there memory for one more job? Sets $why when not. Two cheap reads, no sampling.
  local mem swap
  read -r mem swap < <(mem_state)
  if [ "$mem" -lt "$mem_min" ]; then why="memory: $mem GB available, under the $mem_min GB floor"; return 1; fi
  if [ "$swap" -ge "$swap_max" ]; then why="swap $swap% used, the limit is $swap_max%"; return 1; fi
  return 0
}
load_ok() { # may a job beyond the floor start now? Sets $why when not.
  local now last age v
  printf -v now '%(%s)T' -1; last=$(stat -c %Y "$dir/last-admit" 2>/dev/null || echo 0)
  age=$((now - last))   # negative after a clock step back: treated as long ago
  if [ "$age" -ge 0 ] && [ "$age" -lt "$gap" ]; then why="another job started $age s ago"; return 1; fi
  mem_ok || return 1
  v=$(psi memory); if [ "$v" -ge "$mem_psi_max" ]; then why="memory pressure $v%, the limit is $mem_psi_max%"; return 1; fi
  v=$(psi io); if [ "$v" -ge "$io_psi_max" ]; then why="disk pressure $v%, the limit is $io_psi_max%"; return 1; fi
  v=$(psi cpu); if [ "$v" -ge "$cpu_psi_max" ]; then why="CPU pressure $v%, the limit is $cpu_psi_max%"; return 1; fi
  v=$(cpu_busy); if [ "$v" -ge "$cpu_max" ]; then why="CPU $v% busy, the limit is $cpu_max%"; return 1; fi
  return 0
}

# Which files hold a flock, by inode, read from the kernel instead of probing: a probe takes the
# lock for a moment, and `flock <file>` creates a file that was just removed.
declare -A locked=()
have_locks=0
read_locks() {
  local type id
  locked=() have_locks=0
  [ -r /proc/locks ] || return 0
  have_locks=1
  while read -r _ type _ _ _ id _; do [ "$type" = FLOCK ] && locked[$id]=1; done </proc/locks
}
# stat format and its conversion to the kernel's "major:minor:inode" (major and minor in hex)
lock_stat='%Hd %Ld %i %Y'
lock_id() { printf '%02x:%02x:%s' "$1" "$2" "$3"; }
is_locked() { # $1 file, $2 its lock id; call read_locks first
  [ "$have_locks" = 1 ] && [ -n "${locked[$2]:-}" ] && return 0
  # Not in the kernel's list (or no list: another PID namespace, a filesystem whose device
  # number differs there): ask the file itself, opened for reading so nothing is created.
  ! { flock -n 6; } 2>/dev/null 6<"$1"
}

describe() { # pid, start (epoch s), note -> two lines
  local pid=$1 since=$2 cmd now
  printf -v now '%(%s)T' -1
  cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null); cmd=${cmd#*heavy-slot }; cmd=${cmd#-- }
  printf '  %-8s %6s s  %s%s\n           %s\n' "$pid" "$((now - since))" "$(readlink "/proc/$pid/cwd" 2>/dev/null)" "${3:-}" "${cmd:0:150}"
}

if [ "$want_status" = 1 ]; then
  read -r mem swap < <(mem_state)
  echo "CPU $(cpu_busy)% busy (limit $cpu_max%), pressure: CPU $(psi cpu)% (limit $cpu_psi_max%), disk $(psi io)% ($io_psi_max%), memory $(psi memory)% ($mem_psi_max%)"
  echo "memory $mem GB available (floor $mem_min GB), swap $swap% used (limit $swap_max%)"
  echo "always admitted: $floor; ceiling: $slots"
  read_locks
  printf -v now '%(%s)T' -1
  running=0 out=""
  for f in "$dir"/slot.*; do
    [[ $f =~ /slot\.[0-9]+$ ]] || continue
    read -r maj min ino _ < <(stat -c "$lock_stat" "$f" 2>/dev/null) || continue
    is_locked "$f" "$(lock_id "$maj" "$min" "$ino")" || continue
    running=$((running + 1)); pid="" since=""
    read -r pid since <"$f" 2>/dev/null
    if [[ $pid =~ ^[0-9]+$ ]] && grep -qs heavy-slot "/proc/$pid/cmdline"; then out+=$(describe "$pid" "${since:-0}")$'\n'
    else out+="  (${f##*/}: held by a job started before this version)"$'\n'; fi
  done
  echo "running: $running"; printf '%s' "$out"
  waiting=0 out=""
  for t in "$qdir"/*; do
    read -r maj min ino mt < <(stat -c "$lock_stat" "$t" 2>/dev/null) || continue
    is_locked "$t" "$(lock_id "$maj" "$min" "$ino")" || continue
    n=${t##*/}; pid=${n#*.}; since=${n%%.*}; since=${since:0:10}; note=""
    [ $((now - mt)) -gt "$stale" ] && note="  (stopped: others go first)"
    waiting=$((waiting + 1)); out+=$(describe "$pid" "$since" "$note")$'\n'
  done
  echo "waiting, in order: $waiting"; printf '%s' "$out"
  exit 0
fi

run() { # holds fd 9's lock while the command runs as a child, without the fd
  local child="" rc sig=0 pre=()
  command -v setpriv >/dev/null 2>&1 && pre=(setpriv --pdeathsig TERM --)
  # shellcheck disable=SC2329  # called from the traps
  fwd() { sig=$1; [ -n "$child" ] && kill "-$2" "$child" 2>/dev/null; }
  trap 'fwd 15 TERM' TERM
  trap 'fwd 2 INT' INT
  trap 'fwd 1 HUP' HUP
  # env undoes the SIGINT/SIGQUIT ignore that bash gives a background job; stdin is passed on
  # explicitly, since a background job would get /dev/null. setpriv, env and bash all exec, so
  # $! stays the command's pid.
  # shellcheck disable=SC2016  # expanded by the inner bash
  HEAVY_SLOT_HELD="$$:$(stat_field $$ 22)" "${pre[@]}" env --default-signal=INT,QUIT \
    bash -c 'exec "$@"' _ "$@" 9>&- <&0 &
  child=$!
  # A signal that came before the command started is passed on now.
  case $sig in 15) kill -TERM "$child" ;; 2) kill -INT "$child" ;; 1) kill -HUP "$child" ;; esac 2>/dev/null
  while :; do
    wait "$child"; rc=$?
    # 127: the command was not found, or there is no such child (already reaped).
    [ "$rc" = 127 ] && break
    kill -0 "$child" 2>/dev/null || break
  done
  [ "$sig" != 0 ] && exit $((128 + sig))
  exit "$rc"
}

# The queue: one ticket per waiting job, named by arrival time, locked by its owner for as long
# as it waits and written to on every pass. Only the oldest live ticket may take a slot. A
# ticket nobody holds a lock on belongs to a job that is gone, and whoever finds it removes it.
# A locked ticket that was not written to for 20 s belongs to a stopped job (Ctrl-Z, a
# debugger): the others pass it, and it has its place back when it runs again.
# A --slots call is outside the queue: its slots are not the ones the others wait for, so in the
# queue it could hold everybody behind a slot only it wants.
cmd=("$@")
ticket=""
[ "$strict" = 0 ] && ticket=$qdir/$(date +%s%N).$$
trap '[ -n "$ticket" ] && rm -f -- "${ticket:?}"' EXIT
take_ticket() { exec 8>>"$ticket" && flock 8; }
ahead=""
am_head() { # sets $ahead to the live ticket in front of this one when there is one
  local t maj min ino mt now
  [ -n "$ticket" ] || return 0
  [ -e "$ticket" ] || take_ticket || return 0   # no queue is better than no job
  echo >&8                                      # the sign of life
  read_locks
  printf -v now '%(%s)T' -1
  for t in "$qdir"/*; do
    [ "$t" = "$ticket" ] && return 0
    read -r maj min ino mt < <(stat -c "$lock_stat" "$t" 2>/dev/null) || continue
    if ! is_locked "$t" "$(lock_id "$maj" "$min" "$ino")"; then rm -f -- "${qdir:?}/${t##*/}"; continue; fi
    [ $((now - mt)) -gt "$stale" ] && continue
    ahead=$t
    return 1
  done
  return 0
}
admit() { # fd 9 holds slot $1
  echo "$$ $(date +%s)" >"$dir/slot.$1" 2>/dev/null   # for --status; the lock is on the inode
  [ "$1" -ge "$floor" ] && : >"$dir/last-admit"
  if [ -n "$ticket" ]; then rm -f -- "${ticket:?}"; ticket=""; exec 8>&-; fi
  run "${cmd[@]}"
}
said=-60
say() { # the reason, at most once a minute; the short gap between two starts is not worth a line
  case $why in another\ job\ started*) return 0 ;; esac
  [ $((SECONDS - said)) -ge 60 ] || return 0
  echo "heavy-slot: waiting ($why); $SECONDS s so far" >&2
  said=$SECONDS
}

[ -n "$ticket" ] && take_ticket
round=0
while :; do
  if am_head; then
    # The first two slots take a job whatever the machine measures, so heavy work never stops
    # altogether; the rest of the floor still waits for memory, because memory and swap are
    # what systemd-oomd kills a terminal for. A --slots call checks nothing.
    hard=$floor; [ "$strict" = 0 ] && [ "$hard" -gt 2 ] && hard=2
    for ((i = 0; i < hard; i++)); do
      exec 9>>"$dir/slot.$i"
      flock -n 9 && admit "$i"
    done
    why="all $slots slots busy"
    if [ "$floor" -gt "$hard" ] && mem_ok; then
      why="all $slots slots busy"
      for ((i = hard; i < floor; i++)); do
        exec 9>>"$dir/slot.$i"
        flock -n 9 && admit "$i"
      done
    fi
    if [ "$slots" -gt "$floor" ] && load_ok; then
      for ((i = floor; i < slots; i++)); do
        exec 9>>"$dir/slot.$i"
        flock -n 9 && admit "$i"
      done
    fi
    say
    # Blocks up to 2 s on one always-admitted slot, so a freed one is taken at once and the
    # loop never spins; the load is measured again on the next pass.
    exec 9>>"$dir/slot.$((round % floor))"
    flock -w 2 9 && admit "$((round % floor))"
    round=$((round + 1))
  else
    why="earlier jobs are ahead in the queue"
    say
    # Wakes as soon as the job in front has started (it drops its ticket's lock) or is gone.
    # Opened for reading, which never creates a ticket that was just removed.
    { flock -w 2 7; } 2>/dev/null 7<"$ahead" || sleep 0.2
  fi
done
