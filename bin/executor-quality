#!/usr/bin/env -S python3 -I
"""executor-quality [days] [-v] - how executor subagents' work fared, by model, from local transcripts.

For every oh-my-claudecode:executor subagent (plain subagents; Workflow agents are not covered)
started in the last N days (default: all), in its parent session:
  - the model it actually ran on, and its size (tool calls)
  - review: the verdict of the first review that started after the executor ended (a
    code-reviewer / verifier / security-reviewer subagent, or `omc ask codex|antigravity`). A review
    counts for every executor that ended since the previous review, so a parallel batch shares it.
  - CI: the first ci-wait verdict after it ended, read from ci-wait's own GREEN:/RED: line (or the
    exit code when the command did not pipe or chain it). Same sharing rule as reviews.
Observational: Opus tends to get the harder tasks, so compare by size bucket too, and treat small
counts as small. -v prints one row per run with the start of the review text.
"""
import collections, glob, json, os, re, sys, time
from datetime import datetime

args = [a for a in sys.argv[1:] if a != '-v']
try:
    if len(args) > 1:
        raise ValueError
    DAYS = float(args[0]) if args else 0.0
except ValueError:
    sys.exit('usage: ' + __doc__.split('\n')[0])
CUT = time.time() - DAYS * 86400 if DAYS else 0
ROOTS = [os.path.expanduser('~/.claude/projects')] + glob.glob(os.path.expanduser('~/.config/orca/claude-profiles/*/home/projects'))
REVIEWERS = ('code-reviewer', 'verifier', 'security-reviewer')
LABEL = re.compile(r'verdict|recommendation|status|overall|bottom line', re.I)
TOKEN_NEG = ('FIX', 'REVISE', 'BLOCK', 'REQUEST', 'REJECT', 'FAIL', 'CHANGES', 'NOT ', 'DO NOT', 'NO-GO', 'NO GO', 'HOLD')
TOKEN_POS = ('APPROVE', 'SHIP', 'PASS', 'LGTM', 'ACCEPT', 'GO', 'MERGE')
NEG = re.compile(r'REQUEST[ _-]?CHANGES|\bREVISE\b|\bREJECT(ED)?\b|\bNOT APPROVED\b|CHANGES REQUESTED|\bdo not (ship|merge|land)\b'
                 r'|נדרשים שינויים|דרושים שינויים|לא מאושר|לא לאשר|\b(finding|issue)s? blocks\b', re.I)
POS = re.compile(r'\bAPPROV(E|ED|ING)\b|\bLGTM\b|מאושר|אין חוסם|לא מצאתי (חוסם|בעיה חוסמת)'
                 r'|nothing (here )?(is a confirmed )?blocks?|no(thing)? blocking|found no (P0|blocking|blocker|high)|no issue blocks', re.I)
NEGATION = re.compile(r"\b(not|no|don't|never|would not|wouldn't)\W+(\w+\W+){0,2}$", re.I)
PAST = re.compile(r'previous|earlier|last round|were|are (all )?(fixed|closed)|now fixed', re.I)


def ts(s):
    try:
        return datetime.fromisoformat(str(s).replace('Z', '+00:00')).timestamp()
    except Exception:
        return None


def lines(path):
    try:
        fh = open(path, errors='ignore')
    except OSError:
        return
    with fh:
        for line in fh:
            try:
                d = json.loads(line)
            except Exception:
                continue
            if isinstance(d, dict):
                yield d


def verdict(text):
    if not text:
        return None
    t = text.replace('*', '').replace('`', '')
    # 1. an explicit label: "Verdict: X", "Recommendation: X", or a heading with X on the next line
    for m in LABEL.finditer(t):
        nxt = re.match(r'\W{0,8}([A-Za-z][A-Za-z_\-]*(?: [A-Za-z_\-]+){0,3})', t[m.end():m.end() + 60])
        if not nxt:
            continue
        tok = nxt.group(1).upper()
        if LABEL.fullmatch(tok.split()[0].lower()):
            continue  # "Verdict / Status: X": the next label carries the value
        if tok.startswith(TOKEN_NEG):
            return 'neg'
        if tok.startswith(TOKEN_POS):
            return 'pos'
    for m in re.finditer(r'^#+\s*(verdict|recommendation)\s*$\n+\s*(\S[^\n]{0,40})', t, re.I | re.M):
        tok = m.group(2).strip().upper()
        if tok.startswith(TOKEN_NEG):
            return 'neg'
        if tok.startswith(TOKEN_POS):
            return 'pos'
    # 2. keywords in the opening, skipping negated approvals and rejections from an earlier round
    head = t[:1500]
    hits = []
    for m in NEG.finditer(head):
        sent = head[max(0, head.rfind('.', 0, m.start())):m.end() + 80]
        if not PAST.search(sent):
            hits.append((m.start(), 'neg'))
    for m in POS.finditer(head):
        if not NEGATION.search(head[max(0, m.start() - 30):m.start()]):
            hits.append((m.start(), 'pos'))
    return min(hits)[1] if hits else None


def sub_info(path):
    i = dict(model=None, t0=None, t1=None, tools=0, last='')
    for d in lines(path):
        t = ts(d.get('timestamp'))
        if t:
            i['t0'] = i['t0'] or t; i['t1'] = t
        m = d.get('message')
        if d.get('type') != 'assistant' or not isinstance(m, dict):
            continue
        if m.get('model') and m['model'] != '<synthetic>':
            i['model'] = i['model'] or m['model']
        for b in m.get('content') or []:
            if isinstance(b, dict) and b.get('type') == 'tool_use':
                i['tools'] += 1
            elif isinstance(b, dict) and b.get('type') == 'text' and b.get('text'):
                i['last'] = b['text']
    return i


def at_command_position(cmd, name):
    """True when `name` runs as a command (not as text in grep/ps/echo), and whether its exit code survives."""
    for seg in re.split(r'&&|\|\||[;\n]', cmd):
        first = seg.split('|')[0].strip()
        first = re.sub(r'^((\w+=\S*|timeout\s+\S+|heavy-slot\s+--|exec|command)\s+)*', '', first)
        if re.match(r'(\S*/)?' + name + r'(\s|$)', first):
            plain = '|' not in seg and not re.search(r'[;&]|\n', cmd.split(first, 1)[-1].split('\n', 1)[0])
            return True, plain
    return False, False


def ci_verdict(text):
    m = re.findall(r'^\s*(GREEN|RED|green|red):', text, re.M)
    return None if not m else (0 if m[-1].lower() == 'green' else 1)


def parent_events(parent):
    """Reviews done with `omc ask` and ci-wait verdicts in the parent transcript: [(t, kind, value)]."""
    ev, pend = [], {}
    for d in lines(parent):
        m = d.get('message')
        if not isinstance(m, dict):
            continue
        c = m.get('content')
        t = ts(d.get('timestamp'))
        if d.get('type') == 'assistant' and isinstance(c, list):
            for b in c:
                if not (isinstance(b, dict) and b.get('type') == 'tool_use' and b.get('name') == 'Bash'):
                    continue
                cmd = str((b.get('input') or {}).get('command') or '')
                ci, plain = at_command_position(cmd, r'ci-wait(-wp)?')
                if ci and '--help' not in cmd:
                    pend[b.get('id')] = ('ci', t, plain)
                elif at_command_position(cmd, r'omc\s+ask\s+(codex|antigravity)')[0]:
                    pend[b.get('id')] = ('review', t, False)
        elif d.get('type') == 'user' and pend and isinstance(c, list):
            for b in c:
                if not (isinstance(b, dict) and b.get('type') == 'tool_result' and b.get('tool_use_id') in pend):
                    continue
                kind, t0, plain = pend.pop(b['tool_use_id'])
                text = b.get('content') if isinstance(b.get('content'), str) else json.dumps(b.get('content'), ensure_ascii=False)
                if 'Command running in background' in text:
                    mo = re.search(r'Output is being written to: (\S+?\.output)', text)
                    if mo and os.path.exists(mo.group(1)):
                        try:
                            text = open(mo.group(1), errors='ignore').read()[-20000:]
                        except OSError:
                            continue
                    else:
                        continue
                if kind == 'ci':
                    v = ci_verdict(text)
                    if v is None and plain:
                        mo = re.search(r'Exit code (\d+)', text)
                        v = int(mo.group(1)) if mo else (0 if not b.get('is_error') else None)
                    if v in (0, 1):
                        ev.append((t0, 'ci', v))
                else:
                    ev.append((t0, 'review', (verdict(text[:6000]), text[:6000])))
    return ev


# one entry per (session id, agent file): ~/.config/orca/... holds real copies, not links
seen, by_session = set(), collections.defaultdict(dict)
for root in ROOTS:
    for meta in glob.glob(root + '/*/*/subagents/agent-*.meta.json'):
        p = meta[:-10] + '.jsonl'
        sess_dir = os.path.dirname(os.path.dirname(p))
        key = (os.path.basename(sess_dir), os.path.basename(p))
        if key in seen:
            continue
        try:
            md = json.load(open(meta)); st = os.stat(p)
        except Exception:
            continue
        seen.add(key)
        if st.st_mtime < CUT:
            continue
        s = by_session[os.path.basename(sess_dir)]
        s.setdefault('parent', sess_dir + '.jsonl')
        s.setdefault('subs', []).append((p, md if isinstance(md, dict) else {}))

rows = []
for sid, s in by_session.items():
    subs = s['subs']
    if not any(str(md.get('agentType', '')).endswith('executor') for _, md in subs):
        continue
    infos = []
    for p, md in subs:
        i = sub_info(p)
        if i['t0']:
            i['type'] = str(md.get('agentType') or '?'); infos.append(i)
    execs = sorted((i for i in infos if i['type'].endswith('executor')), key=lambda x: x['t1'])
    pev = parent_events(s['parent'])
    reviews = sorted([(i['t0'], verdict(i['last']), i['last']) for i in infos if any(r in i['type'] for r in REVIEWERS)]
                     + [(t, v[0], v[1]) for t, k, v in pev if k == 'review' and t], key=lambda x: x[0])
    cis = sorted([(t, v, '') for t, k, v in pev if k == 'ci' and t], key=lambda x: x[0])

    def credit(events):
        """executor index -> (value, text) of the first event after it ended; a batch shares one event."""
        out, prev = {}, -1.0
        for t, v, text in events:
            for k, e in enumerate(execs):
                if prev < e['t1'] <= t and k not in out:
                    out[k] = (v, text)
            prev = t
        return out
    rv, ci = credit(reviews), credit(cis)
    for k, e in enumerate(execs):
        if e['t0'] < CUT:
            continue
        r = rv.get(k)
        rows.append(dict(model=(e['model'] or '?').replace('claude-', ''), tools=e['tools'],
                         reviewed=r is not None, rev=r[0] if r else None, ci=ci[k][0] if k in ci else None,
                         text=(r[1] if r else '')[:200].replace('\n', ' ')))


def line(rs):
    rv = [r for r in rs if r['reviewed']]
    ci = [r for r in rs if r['ci'] is not None]
    neg = sum(r['rev'] == 'neg' for r in rv); unc = sum(r['rev'] is None for r in rv)
    red = sum(r['ci'] == 1 for r in ci)
    distinct = {(r['text'], r['rev']) for r in rv if r['text']}
    dneg = sum(v == 'neg' for _, v in distinct)
    return (f"runs {len(rs):4}  review rejected {neg:3}/{len(rv):<3} (unclear {unc:2}; distinct reviews {dneg}/{len(distinct)})"
            f"  CI red {red:3}/{len(ci):<3}")


print(f"executor-quality: {'last %g days' % DAYS if DAYS else 'all transcripts'}, {len(rows)} executor runs")
models = sorted({r['model'] for r in rows}, key=lambda m: -sum(r['model'] == m for r in rows))
for m in models:
    rs = [r for r in rows if r['model'] == m]
    sz = sorted(r['tools'] for r in rs)
    print(f"  {m:12} {line(rs)}  median tool calls {sz[len(sz)//2]}")
print('by size (tool calls):')
for lo, hi in ((0, 20), (20, 60), (60, 10**9)):
    for m in models:
        rs = [r for r in rows if r['model'] == m and lo <= r['tools'] < hi]
        if rs:
            print(f"  {lo:>3}-{'' if hi > 10**6 else hi:<4} {m:12} {line(rs)}")
if '-v' in sys.argv:
    for r in rows:
        print(f"{r['model']:12} tools {r['tools']:4} review {str(r['rev']):5} ci {str(r['ci']):4} | {r['text']}")
