#!/usr/bin/env -S python3 -I
"""executor-quality [days | --since YYYY-MM-DD] [-v] - how executor subagents' work fared, by model.

Reads the local transcripts. For every oh-my-claudecode:executor, nadavai:executor (reported as '<model> own') or nadavai:executor-compact ('<model> compact') subagent (plain subagents; Workflow
agents are not covered) started in the window (default: all), in its parent session:
  - the model it actually ran on, and its size (tool calls)
  - review: the first review within 6 h after the executor ended (a code-reviewer / verifier /
    security-reviewer / nadavai:reviewer subagent, or `omc ask codex|antigravity`), preferring one whose text names the
    branch or a commit sha from the executor's own final text. Reviews that only report a usage
    limit, or have no text, are skipped. A batch of executors can share one review.
  - CI: the first ci-wait verdict within 6 h, from ci-wait's own GREEN:/RED: line (foreground
    result or the task notification of a background run); an infrastructure kill is not counted.
The rejection rate counts clear verdicts only (rejected / (rejected + approved)); unclear ones are
reported apart. Observational: compare by size, and treat small counts as small.
"""
import collections, glob, json, math, os, re, sys, time
from datetime import datetime

USAGE = 'usage: ' + __doc__.split('\n')[0]
argv = sys.argv[1:]
if '-h' in argv or '--help' in argv:
    print(__doc__); sys.exit(0)
VERBOSE = '-v' in argv
argv = [a for a in argv if a != '-v']
CUT = 0.0
try:
    if argv[:1] == ['--since'] and len(argv) == 2:
        CUT = datetime.fromisoformat(argv[1]).timestamp(); WINDOW = 'since ' + argv[1]
    elif len(argv) == 1:
        days = float(argv[0])
        if not math.isfinite(days) or days <= 0:
            raise ValueError
        CUT = time.time() - days * 86400; WINDOW = 'last %g days' % days
    elif not argv:
        WINDOW = 'all transcripts'
    else:
        raise ValueError
except ValueError:
    sys.exit(USAGE)

GAP = 6 * 3600
ROOTS = []
for r in [os.path.expanduser('~/.claude/projects')] + glob.glob(os.path.expanduser('~/.config/orca/claude-profiles/*/home/projects')):
    if os.path.realpath(r) not in [os.path.realpath(x) for x in ROOTS]:
        ROOTS.append(r)
REVIEWERS = ('code-reviewer', 'verifier', 'security-reviewer', 'nadavai:reviewer')
LIMIT = re.compile(r"hit your .{0,30}limit|usage limit|rate[- ]limit(ed)?\b|limit will reset|out of (extra )?usage", re.I)
STRONG_LABEL = re.compile(r'\b(verdict|recommendation|bottom line)\b', re.I)
WEAK_LABEL = re.compile(r'\b(overall|status)\b', re.I)
TOKEN_NEG = re.compile(r'(FIX\b|FIX-|REVISE|BLOCK|REQUEST|REJECT|FAIL|CHANGES|NOT\b|DO NOT|NO-GO|NO GO|HOLD\b)')
TOKEN_POS = re.compile(r'(APPROVE|SHIP\b|PASS(ED)?\b|LGTM|ACCEPT|GO\b|MERGE\b|COMMENT\b)')
NEG = re.compile(r'REQUEST[ _-]?CHANGES|\bREVISE\b|\bREJECT(ED)?\b|\bNOT APPROVED\b|CHANGES REQUESTED|\bdo not (ship|merge|land)\b'
                 r'|נדרשים שינויים|דרושים שינויים|לא מאושר|לא לאשר|\b(finding|issue)s? blocks\b', re.I)
POS = re.compile(r'\bAPPROV(E|ED|ING)\b|\bLGTM\b|מאושר|אין חוסם|לא מצאתי (חוסם|בעיה חוסמת)'
                 r'|nothing (here )?(is a confirmed )?blocks?|no(thing)? blocking|found no (P0|blocking|blocker|high)|no issue blocks', re.I)
NEGATION = re.compile(r"\b(not|no|don't|never|cannot|can't|won't|would not|wouldn't|will not)\W+(\w+\W+){0,2}$", re.I)
PAST = re.compile(r'\b(previous|earlier|last round|(are|were) (all )?(fixed|closed|addressed)|now fixed)\b', re.I)
REF = re.compile(r'\b(?:[a-z][\w.-]*/[\w./-]{3,})\b|\b[0-9a-f]{7,40}\b')


def ts(s):
    try:
        return datetime.fromisoformat(str(s).replace('Z', '+00:00')).timestamp()
    except Exception:
        return None


def lines(path):
    try:
        fh = open(path, errors='ignore')
    except OSError:
        return
    with fh:
        for line in fh:
            try:
                d = json.loads(line)
            except Exception:
                continue
            if isinstance(d, dict):
                yield d


def token_verdict(tok):
    tok = tok.strip().upper()
    if TOKEN_NEG.match(tok):
        return 'neg'
    if TOKEN_POS.match(tok):
        return 'pos'
    return None


def sentence(text, start, end):
    a = max(text.rfind(c, 0, start) for c in '.;\n') + 1
    b = min([i for i in (text.find(c, end) for c in '.;\n') if i >= 0] or [len(text)])
    return text[a:b]


def verdict(text):
    if not text:
        return None
    t = text.replace('*', '').replace('`', '')
    for label in (STRONG_LABEL, WEAK_LABEL):  # "Verdict:" wins over "Typecheck status:"
        for m in label.finditer(t):
            nxt = re.match(r'[ \t:#\-–—]{0,8}\n?\s*([A-Za-z][A-Za-z_\-]*(?: [A-Za-z_\-]+){0,3})', t[m.end():m.end() + 80])
            if not nxt:
                continue
            tok = nxt.group(1)
            if STRONG_LABEL.match(tok) or WEAK_LABEL.match(tok):
                continue  # "Verdict / Status: X": the next label carries the value
            v = token_verdict(tok)
            if v:
                return v
    head, hits = t[:1500], []
    for m in NEG.finditer(head):
        if not PAST.search(sentence(head, m.start(), m.end())):
            hits.append((m.start(), 'neg'))
    for m in POS.finditer(head):
        if not NEGATION.search(head[max(0, m.start() - 30):m.start()]) and not PAST.search(sentence(head, m.start(), m.end())):
            hits.append((m.start(), 'pos'))
    return min(hits)[1] if hits else None


def sub_info(path):
    i = dict(model=None, t0=None, t1=None, tools=0, last='')
    for d in lines(path):
        t = ts(d.get('timestamp'))
        if t:
            i['t0'] = i['t0'] or t; i['t1'] = t
        m = d.get('message')
        if d.get('type') != 'assistant' or not isinstance(m, dict):
            continue
        if m.get('model') and m['model'] != '<synthetic>':
            i['model'] = i['model'] or m['model']
        for b in m.get('content') or []:
            if isinstance(b, dict) and b.get('type') == 'tool_use':
                i['tools'] += 1
            elif isinstance(b, dict) and b.get('type') == 'text' and b.get('text'):
                i['last'] = b['text']
    return i


def strip_heredocs(cmd):
    return re.sub(r"<<-?\s*['\"]?(\w+)['\"]?.*?\n\1\s*$", '', cmd, flags=re.S | re.M)


def at_command_position(cmd, name):
    """(runs as a command, its exit code is the whole command's exit code)."""
    cmd = strip_heredocs(cmd)
    segs = [s for s in re.split(r'&&|\|\||[;\n]', cmd) if s.strip()]
    for n, seg in enumerate(segs):
        first = re.sub(r'^((\w+=\S*|timeout\s+\S+|heavy-slot\s+--|exec|command)\s+)*', '', seg.split('|')[0].strip())
        if re.match(r'(\S*/)?' + name + r'(\s|$)', first):
            return True, '|' not in seg and n == len(segs) - 1 and '>' not in seg
    return False, False


def ci_verdict(text):
    m = re.findall(r'^\s*(GREEN(?: with notes)?|RED|green|red):(.*)$', text, re.M)
    if not m:
        return None
    word, rest = m[-1]
    if word.lower().startswith('green'):
        return 0
    return None if re.search(r'killed|infrastructure', rest, re.I) else 1


def text_of(c):
    if isinstance(c, str):
        return c
    out = []
    for b in c if isinstance(c, list) else []:
        if isinstance(b, dict):
            out.append(b.get('text') or (b.get('content') if isinstance(b.get('content'), str) else json.dumps(b.get('content'), ensure_ascii=False)))
    return '\n'.join(x for x in out if x)


def parent_events(parent):
    """`omc ask` reviews and ci-wait verdicts in the parent transcript: [(t, kind, verdict, text)]."""
    ev, pend, bg = [], {}, {}
    for d in lines(parent):
        m = d.get('message')
        if not isinstance(m, dict):
            continue
        c = m.get('content')
        t = ts(d.get('timestamp'))
        if d.get('type') == 'assistant' and isinstance(c, list):
            for b in c:
                if not (isinstance(b, dict) and b.get('type') == 'tool_use' and b.get('name') == 'Bash'):
                    continue
                cmd = str((b.get('input') or {}).get('command') or '')
                ci, plain = at_command_position(cmd, r'ci-wait(-wp)?')
                if ci and '--help' not in cmd:
                    pend[b.get('id')] = ('ci', t, plain)
                elif at_command_position(cmd, r'omc\s+ask\s+(codex|antigravity)')[0]:
                    pend[b.get('id')] = ('review', t, False)
            continue
        if d.get('type') != 'user':
            continue
        text = text_of(c)
        if '<task-notification>' in text:
            for tid in re.findall(r'<tool-use-id>(\S+?)</tool-use-id>', text):
                if tid in bg:
                    kind, t0, plain = bg.pop(tid)
                    add(ev, kind, t0, plain, text, re.search(r'exit code (\d+)', text))
        if not isinstance(c, list):
            continue
        for b in c:
            if not (isinstance(b, dict) and b.get('type') == 'tool_result' and b.get('tool_use_id') in pend):
                continue
            kind, t0, plain = pend.pop(b['tool_use_id'])
            res = text_of([b])
            if 'Command running in background' in res:
                bg[b['tool_use_id']] = (kind, t0, plain)
                continue
            add(ev, kind, t0, plain, res, re.search(r'Exit code (\d+)', res) or (None if b.get('is_error') else '0'))
    return ev


def add(ev, kind, t0, plain, text, exit_match):
    if kind == 'ci':
        v = ci_verdict(text)
        if v is None and plain and exit_match is not None:
            code = int(exit_match if isinstance(exit_match, str) else exit_match.group(1))
            v = code if code in (0, 1) else None
        if v is not None:
            ev.append((t0, 'ci', v, ''))
    elif text and not LIMIT.search(text[:400]):
        ev.append((t0, 'review', verdict(text[:6000]), text[:6000]))


# one entry per (session id, agent file); some Orca profile dirs are real copies, not links
seen, by_session = set(), collections.defaultdict(dict)
for root in ROOTS:
    for meta in glob.glob(root + '/*/*/subagents/agent-*.meta.json'):
        p = meta[:-10] + '.jsonl'
        sess_dir = os.path.dirname(os.path.dirname(p))
        sid = os.path.basename(sess_dir)
        parent = sess_dir + '.jsonl'
        s = by_session[sid]
        try:
            if os.path.getsize(parent) > s.get('psize', -1):
                s['parent'], s['psize'] = parent, os.path.getsize(parent)
        except OSError:
            pass
        key = (sid, os.path.basename(p))
        if key in seen:
            continue
        try:
            md = json.load(open(meta)); st = os.stat(p)
        except Exception:
            continue
        seen.add(key)
        if st.st_mtime >= CUT:
            s.setdefault('subs', []).append((p, md if isinstance(md, dict) else {}))

rows = []
for sid, s in by_session.items():
    subs = s.get('subs', [])
    if not s.get('parent') or not any(str(md.get('agentType', '')).endswith(('executor', 'executor-compact')) for _, md in subs):
        continue
    infos = []
    for p, md in subs:
        i = sub_info(p)
        if i['t0']:
            i['type'] = str(md.get('agentType') or '?'); infos.append(i)
    execs = [i for i in infos if i['type'].endswith(('executor', 'executor-compact')) and not LIMIT.search(i['last'][:400] or 'x')]
    pev = parent_events(s['parent'])
    reviews = [(i['t0'], verdict(i['last']), i['last']) for i in infos
               if any(r in i['type'] for r in REVIEWERS) and i['last'] and not LIMIT.search(i['last'][:400])]
    reviews += [(t, v, x) for t, k, v, x in pev if k == 'review' and t]
    reviews.sort(key=lambda x: x[0])
    cis = sorted([(t, v) for t, k, v, _ in pev if k == 'ci' and t], key=lambda x: x[0])
    for e in execs:
        if e['t0'] < CUT:
            continue
        cand = [r for r in reviews if e['t1'] <= r[0] <= e['t1'] + GAP]
        refs = {x for x in REF.findall(e['last']) if not x.isdigit()}
        r = next((r for r in cand if any(x in r[2] for x in refs)), cand[0] if cand else None)
        c = next((v for t, v in cis if e['t1'] <= t <= e['t1'] + GAP), None)
        rows.append(dict(model=(e['model'] or '?').replace('claude-', '') + (' compact' if e['type'].endswith('-compact') else ' own' if e['type'] == 'nadavai:executor' else ''), tools=e['tools'], reviewed=r is not None,
                         rev=r[1] if r else None, ci=c, text=(r[2] if r else '')[:200].replace('\n', ' ')))


def line(rs):
    rv = [r for r in rs if r['reviewed']]
    ci = [r for r in rs if r['ci'] is not None]
    neg = sum(r['rev'] == 'neg' for r in rv); pos = sum(r['rev'] == 'pos' for r in rv)
    distinct = {(r['text'], r['rev']) for r in rv}
    dneg = sum(v == 'neg' for _, v in distinct); dpos = sum(v == 'pos' for _, v in distinct)
    pct = lambda a, b: f"{a / b * 100:3.0f}%" if b else '  - '
    red = sum(r['ci'] == 1 for r in ci)
    return (f"runs {len(rs):4}  rejected {neg:3}/{neg + pos:<3} {pct(neg, neg + pos)} (unclear {len(rv) - neg - pos:2})"
            f"  distinct reviews rejected {dneg:3}/{dneg + dpos:<3} {pct(dneg, dneg + dpos)}  CI red {red:2}/{len(ci):<3}")


print(f"executor-quality: {WINDOW}, {len(rows)} executor runs (rejection rate over clear verdicts)")
models = sorted({r['model'] for r in rows}, key=lambda m: -sum(r['model'] == m for r in rows))
for m in models:
    rs = [r for r in rows if r['model'] == m]
    sz = sorted(r['tools'] for r in rs)
    print(f"  {m:12} {line(rs)}  median tool calls {sz[len(sz)//2]}")
print('by size (tool calls):')
for lo, hi in ((0, 20), (20, 60), (60, 10**9)):
    for m in models:
        rs = [r for r in rows if r['model'] == m and lo <= r['tools'] < hi]
        if rs:
            print(f"  {lo:>3}-{'' if hi > 10**6 else hi:<4} {m:12} {line(rs)}")
if VERBOSE:
    for r in rows:
        rv = '-' if not r['reviewed'] else str(r['rev'])
        print(f"{r['model']:12} tools {r['tools']:4} review {rv:5} ci {'-' if r['ci'] is None else r['ci']} | {r['text']}")
