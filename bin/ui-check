#!/usr/bin/env node
// ui-check: turns a web page into layout numbers, so agents stop judging screens from screenshots.
// Per width and theme: dir/lang, page overflow, elements past or wholly beyond the viewport, clipped
// text, controls and text cut by a clipping ancestor, overlapping controls (also content a fixed
// bar covers for good), small touch targets, the phone viewport meta, console errors, axe-core
// violations and an RTL text-align hint. Uses the globally installed @playwright/test and the
// axe-core bundled with @axe-core/cli (resolved through `npm root -g`); it adds no dependency.
'use strict';
const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const USAGE = 'usage: ui-check <url> [--width 375,1440] [--theme light,dark] [--storage-state <file>]\n' +
  '                [--ignore <css selector>]... [--wait <ms>] [--timeout <s per viewport, 60>] [--json]\n' +
  'exit: 0 clean, 1 findings, 2 usage, navigation, timeout or internal error';
const MAX = 5;
// Page strings are data: control characters and bidi overrides never reach the terminal, and
// --json escapes the ones JSON.stringify leaves raw.
const CTL = /[\x00-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]/g;
const RAW = /[\x7f-\x9f\u202a-\u202e\u2066-\u2069]/g;

function fail(msg) { process.stderr.write(`ui-check: ${msg}\n`); process.exit(2); }

function parseArgs(argv) {
  const o = { url: null, widths: [375, 1440], themes: ['light'], storage: null, ignores: [], wait: 500, timeout: 60, json: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const val = () => { if (i + 1 >= argv.length) fail(`${a} needs a value\n${USAGE}`); return argv[++i]; };
    if (a === '-h' || a === '--help') { process.stdout.write(USAGE + '\n'); process.exit(0); }
    else if (a === '--width') o.widths = val().split(',').map((w) => parseInt(w, 10));
    else if (a === '--theme') o.themes = val().split(',');
    else if (a === '--storage-state') o.storage = val();
    else if (a === '--ignore') o.ignores.push(val());
    else if (a === '--wait') o.wait = parseInt(val(), 10);
    else if (a === '--timeout') o.timeout = Number(val());
    else if (a === '--json') o.json = true;
    else if (a.startsWith('-')) fail(`unknown option ${a}\n${USAGE}`);
    else if (o.url) fail(`one url only\n${USAGE}`);
    else o.url = a;
  }
  if (!o.url) fail(USAGE);
  if (o.widths.some((w) => !(w > 0 && w < 10000))) fail('--width takes positive integers, e.g. 375,1440');
  if (o.themes.some((t) => t !== 'light' && t !== 'dark')) fail('--theme takes light, dark or light,dark');
  if (!(o.wait >= 0)) fail('--wait takes milliseconds');
  if (!(o.timeout > 0)) fail('--timeout takes seconds, e.g. 60');
  if (o.storage && !fs.existsSync(o.storage)) fail(`storage state not found: ${o.storage}`);
  if (/^[a-z][a-z0-9+.-]*:/i.test(o.url) === false) {
    o.url = fs.existsSync(o.url) ? 'file://' + path.resolve(o.url) : 'https://' + o.url;
  }
  return o;
}

function loadDeps() {
  let root;
  try { root = execSync('npm root -g', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); }
  catch { fail('npm root -g failed; is node/npm on PATH?'); }
  let chromium, devices;
  try { ({ chromium, devices } = require(path.join(root, '@playwright/test'))); }
  catch { fail(`@playwright/test not found under ${root}`); }
  const axePath = [path.join(root, '@axe-core/cli/node_modules/axe-core/axe.min.js'), path.join(root, 'axe-core/axe.min.js')]
    .find((p) => fs.existsSync(p));
  if (!axePath) fail(`axe-core not found under ${root} (expected via @axe-core/cli)`);
  return { chromium, phoneUA: devices['Pixel 7'].userAgent, axeSrc: fs.readFileSync(axePath, 'utf8') };
}

// Runs inside the page. Everything it needs is passed in or defined here; `hold.sel` hands the
// selector builder to runAxe without a page global.
function domChecks({ ignores, phone, max }, hold) {
  for (const s of ignores) { try { document.querySelector(s); } catch { return { badIgnore: s }; } }
  const html = document.documentElement;
  const vw = html.clientWidth, vh = window.innerHeight;
  const ignored = (el) => ignores.some((s) => el.closest(s));
  const box = (r) => [r.x, r.y, r.width, r.height].map(Math.round);
  const uniq = (s) => { try { return document.querySelectorAll(s).length === 1; } catch { return false; } };
  const sel = (el) => {
    // Leaf part first; going up, try "ancestor leaf" (short) before the full child chain.
    const parts = [];
    for (let cur = el; cur && cur.nodeType === 1 && cur !== html; cur = cur.parentElement) {
      let p = cur.id && uniq('#' + CSS.escape(cur.id)) ? '#' + CSS.escape(cur.id) : null;
      if (!p) {
        p = cur.localName;
        const cls = [...cur.classList].filter((c) => /^[a-zA-Z_][\w-]*$/.test(c)).slice(0, 2);
        if (cls.length) p += '.' + cls.join('.');
        const par = cur.parentElement;
        const same = par ? [...par.children].filter((c) => c.localName === cur.localName) : [];
        if (same.length > 1 && same.filter((c) => c.matches(p)).length > 1) p += `:nth-of-type(${same.indexOf(cur) + 1})`;
      }
      parts.unshift(p);
      if (parts.length > 2 && uniq(`${parts[0]} ${parts[parts.length - 1]}`)) return `${parts[0]} ${parts[parts.length - 1]}`;
      if (uniq(parts.join(' > '))) break;
    }
    return parts.join(' > ');
  };
  if (hold) hold.sel = sel;
  const styles = new Map(), rects = new Map();
  const st = (e) => { let s = styles.get(e); if (!s) styles.set(e, s = getComputedStyle(e)); return s; };
  const rect = (e) => { let r = rects.get(e); if (!r) rects.set(e, r = e.getBoundingClientRect()); return r; };
  const visible = (el, r) => r.width > 1 && r.height > 1 &&
    el.checkVisibility({ opacityProperty: true, visibilityProperty: true }) &&
    !el.closest('[aria-hidden="true"],[inert],[hidden],dialog:not([open])');
  const ownText = (el) => [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
  const mk = () => ({ count: 0, examples: [] });
  const add = (c, ex) => { c.count++; if (c.examples.length < max) c.examples.push(ex); };
  const vm = document.querySelector('meta[name="viewport" i]');
  const vmc = vm ? vm.getAttribute('content') || '' : '';
  const out = { dir: html.getAttribute('dir') || getComputedStyle(html).direction, lang: html.getAttribute('lang') || '',
    pageOverflow: html.scrollWidth > html.clientWidth ? { scrollWidth: html.scrollWidth, clientWidth: html.clientWidth } : null,
    viewportMeta: !phone || /(^|[\s,;])width\s*=\s*device-width/i.test(vmc) ? null
      : vm ? { problem: 'no width=device-width', content: vmc.slice(0, 100) } : { problem: 'missing' },
    overflow: mk(), offscreen: mk(), clipped: mk(), clippedByAncestor: mk(), overlap: mk(), touch: mk(), rtlTextLeft: mk() };
  const rtl = out.dir === 'rtl' || getComputedStyle(document.body).direction === 'rtl';
  const flagged = new Set(), offFlagged = new Set(), cutFlagged = new Set(), clippedSet = new Set();
  const inter = [];
  // tabindex=-1 marks a focus target for scripts (carousel slides, regions), not a control; so does an a without href.
  const CTRL = 'a[href], button, input:not([type="hidden"]), select, textarea, summary, ' +
    '[contenteditable]:not([contenteditable="false"]), [role="button"], [role="link"], [role="tab"], [role="checkbox"], ' +
    '[role="switch"], [role="menuitem"], [tabindex]:not([tabindex^="-"])';
  const isInter = (el) => el.matches(CTRL);
  const clipsX = (s) => /hidden|clip/.test(s.overflowX), clipsY = (s) => /hidden|clip/.test(s.overflowY);
  const inVp = (r) => r.left >= -1 && r.right <= vw + 1;
  const pad = (a) => { const r = rect(a); const pl = r.left + a.clientLeft, pt = r.top + a.clientTop; return { pl, pt, pr: pl + a.clientWidth, pb: pt + a.clientHeight }; };
  const past = (t, c, x, y) => (x && (t.left < c.pl - 1 || t.right > c.pr + 1)) || (y && (t.top < c.pt - 1 || t.bottom > c.pb + 1));
  // A row: side-by-side boxes running past the container's width; null when they do not.
  const rowOf = (els, a) => {
    const kr = els.filter((e) => !/absolute|fixed/.test(st(e).position)).map(rect)
      .filter((r) => r.width > 1 && r.height > 1).sort((p, q) => p.left - q.left);
    return kr.length > 1 && kr.every((r, i) => i === 0 || r.left >= kr[i - 1].right - 1) &&
      kr[kr.length - 1].right - kr[0].left > a.clientWidth + 1 ? kr : null;
  };
  // A carousel: scroll-snap on it or its parent, a row of slide-sized boxes (each 60% of the width or
  // more) here or one level down, or a single track that a script has moved (a non-zero translate) or
  // that has prev/next controls beside it (slick, swiper). A row of tabs is not one, even on a GPU layer.
  const kinds = new Map(), carousels = new Map();
  const moved = (p) => {
    const m = st(p).transform.match(/^matrix(3d)?\(([^)]*)\)/), v = m ? m[2].split(',').map(Number) : [];
    return m ? (m[1] ? v[12] || v[13] : v[4] || v[5]) !== 0 : false;
  };
  const arrows = (a) => [...(a.parentElement || a).querySelectorAll('button, [role="button"], a')].some((b) =>
    /prev|next|arrow|הקודם|הבא/i.test(`${b.getAttribute('aria-label') || ''} ${typeof b.className === 'string' ? b.className : ''}`));
  const carousel = (a) => carousels.has(a) ? carousels.get(a) : carousels.set(a, st(a).scrollSnapType !== 'none' ||
    (a.parentElement && a.parentElement !== html && st(a.parentElement).scrollSnapType !== 'none') ||
    [a, a.children.length === 1 ? a.children[0] : null].some((p) => {
      const kr = p && rowOf([...p.children], a);
      return kr && (kr.every((r) => r.width >= 0.6 * a.clientWidth) || (p !== a && (moved(p) || arrows(a))));
    })).get(a);
  // Built to scroll sideways: overflow-x auto/scroll and either overflow-y hidden, its own children in a
  // row past its width (a chip row), or a carousel. A vertical shell that also scrolls sideways is not.
  const sideScroller = (a) => kinds.has(a) ? kinds.get(a) : kinds.set(a, /auto|scroll/.test(st(a).overflowX) &&
    (clipsY(st(a)) || (a.scrollWidth > a.clientWidth + 1 && (!!rowOf([...a.children], a) || carousel(a))))).get(a);
  const range = document.createRange();
  const textRect = (n) => { range.selectNodeContents(n); return range.getBoundingClientRect(); };
  // Text this element cuts itself; text inside a control or a nested clipping box is left to those.
  const textCut = (el, x, y) => {
    const c = pad(el), w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    for (let n, i = 0; (n = w.nextNode()) && i < 300; i++) {
      if (!n.textContent.trim()) continue;
      let tx = x, ty = y;
      for (let p = n.parentElement; p && p !== el && (tx || ty); p = p.parentElement) {
        const s = st(p);
        if (isInter(p) || s.position === 'fixed') tx = ty = false;
        if (s.overflowX !== 'visible') tx = false;
        if (s.overflowY !== 'visible') ty = false;
      }
      const t = (tx || ty) && textRect(n);
      if (t && t.width >= 1 && t.height >= 1 && past(t, c, tx, ty)) return true;
    }
    return false;
  };
  // A skip link is off screen until focused; measure it focused, with no transition in the way.
  // Run only after every box is measured, since focus can move things.
  const shownOnFocus = (el) => {
    const prev = document.activeElement, tr = el.style.transition;
    el.style.transition = 'none'; el.focus({ preventScroll: true });
    const fr = el.getBoundingClientRect(); el.style.transition = tr;
    if (prev && prev !== el && prev.focus) prev.focus({ preventScroll: true }); else el.blur();
    return fr.right > 0 && fr.left < vw;
  };
  const bodyIsViewport = st(html).overflowX === 'visible' && st(html).overflowY === 'visible';
  const probes = [], barEls = [];
  for (const el of document.body.querySelectorAll('*')) {
    if (el.closest('svg') && el.localName !== 'svg') continue;
    const r = rect(el);
    if (!visible(el, r) || ignored(el)) continue;
    const cs = st(el);
    const own = ownText(el), ctl = isInter(el);
    // A fixed or sticky layer (the outermost one): any size when it is or holds a control (a floating
    // chat button), else a bar at least 24px high and half the viewport wide (a text banner).
    if (/fixed|sticky/.test(cs.position) && (ctl || el.querySelector(CTRL) || (r.height >= 24 && r.width >= vw / 2)) &&
        !barEls.some((b) => b.contains(el))) barEls.push(el);
    // Walk the boxes that clip this one: a positioned box skips those below its containing block.
    // A box clipped away whole is fine inside a scroller or carousel; elsewhere a control there is a defect.
    let mode = cs.position, scroller = false, hiddenVp = false, cutAway = false, awayBad = null, cut = null;
    let underPast = false, underOff = false, underCut = false;
    for (let a = el.parentElement; a && a !== html; a = a.parentElement) {
      if (flagged.has(a)) underPast = true;
      if (offFlagged.has(a)) underOff = true;
      if (cutFlagged.has(a) || clippedSet.has(a)) underCut = true;
      const s = st(a);
      const cb = s.transform !== 'none' || s.filter !== 'none' || s.perspective !== 'none' || /paint|layout|strict|content/.test(s.contain);
      if (mode === 'fixed' ? !cb : mode === 'absolute' && !cb && s.position === 'static') continue;
      mode = s.position;
      if ((s.overflowX === 'visible' && s.overflowY === 'visible') || (a === document.body && bodyIsViewport)) continue;
      const side = sideScroller(a), x = clipsX(s), y = clipsY(s), ar = rect(a), c = pad(a);
      if (side && inVp(ar)) scroller = true;
      if (x && inVp(ar)) hiddenVp = true;
      if (((x || side) && (r.right <= c.pl + 1 || r.left >= c.pr - 1)) || (y && (r.bottom <= c.pt + 1 || r.top >= c.pb - 1))) {
        // The innermost box that clips it away decides: a carousel's slides stay fine in outer clippers.
        if (!cutAway && !side && !carousel(a)) awayBad = a;
        cutAway = true;
      // A hidden box holding a carousel: slides peek at its edges by design.
      } else if (!cut && past(r, c, x && !carousel(a), y)) cut = { a, c, x: x && !carousel(a), y };
    }
    const onScreen = r.right > 0 && r.left < vw;
    // Past the viewport, partly visible, and not inside a sideways scroller or a clipping box that fits.
    if ((r.left < -1 || r.right > vw + 1) && onScreen && !underPast && !scroller && !hiddenVp && !cutAway) {
      flagged.add(el); add(out.overflow, { selector: sel(el), box: box(r) });
    }
    // Wholly beyond the viewport sideways: a control or text nobody can reach. Report the outermost
    // such box once. Carousel slides, clipped-away text, skip links and screen-reader-only text far off are fine.
    if (!onScreen) {
      if ((ctl || own) && (ctl ? !cutAway || awayBad : !cutAway && r.right > -999 && r.left < vw + 999) && !underPast && !underOff && !(scroller && !awayBad)) {
        let top = el;
        for (let p = el.parentElement, pr; p && p !== document.body && visible(p, pr = rect(p)) && (pr.right <= 0 || pr.left >= vw); p = p.parentElement) top = p;
        if (el.matches('a[href^="#"]')) probes.push({ el, top });
        else if (!offFlagged.has(top)) { offFlagged.add(top); add(out.offscreen, { selector: sel(top), box: box(rect(top)) }); }
      }
      continue;
    }
    // On screen but clipped away whole by a box that is no scroller: a control nobody sees, still in the tab order.
    if (ctl && awayBad && !underCut) { cutFlagged.add(el); add(out.clippedByAncestor, { selector: sel(el), box: box(r), by: sel(awayBad) }); }
    const cx = clipsX(cs) || (cs.textOverflow !== 'clip' && cs.overflowX !== 'visible'), cy = clipsY(cs);
    if (((cx && el.scrollWidth > el.clientWidth + 1) || (cy && el.scrollHeight > el.clientHeight + 1)) &&
        el.clientWidth > 0 && el.textContent.trim() && textCut(el, cx, cy)) {
      clippedSet.add(el);
      add(out.clipped, { selector: sel(el), box: box(r), scroll: [el.scrollWidth, el.scrollHeight], client: [el.clientWidth, el.clientHeight] });
    }
    // A form field or label text cut by an ancestor's hidden/clip box. What counts is what people
    // see: a cropped image or an empty inline fragment below a media frame is not a cut.
    const labelCut = () => {
      if (el.matches('input, select, textarea')) return true;
      const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      for (let n, t, i = 0; (n = w.nextNode()) && i < 50; i++) {
        if (n.textContent.trim() && (ctl || n.parentNode === el) && (t = textRect(n)).width >= 1 && t.height >= 1 && past(t, cut.c, cut.x, cut.y)) return true;
      }
      return false;
    };
    if (cut && !underCut && (ctl || own) && labelCut()) {
      cutFlagged.add(el); add(out.clippedByAncestor, { selector: sel(el), box: box(r), by: sel(cut.a) });
    }
    if (own && rtl && cs.textAlign === 'left' && cs.direction === 'rtl') add(out.rtlTextLeft, { selector: sel(el), box: box(r) });
    if (ctl) {
      // For overlap: the part left after every clipping ancestor, and whether it sits on a fixed layer.
      let fixed = /fixed|sticky/.test(cs.position);
      const v = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
      for (let a = el.parentElement; a && a !== html; a = a.parentElement) {
        const s = st(a);
        if (/fixed|sticky/.test(s.position)) fixed = true;
        if (s.overflowX !== 'visible' || s.overflowY !== 'visible') {
          const ar = rect(a);
          Object.assign(v, { left: Math.max(v.left, ar.left), top: Math.max(v.top, ar.top), right: Math.min(v.right, ar.right), bottom: Math.min(v.bottom, ar.bottom) });
        }
      }
      if (v.right - v.left > 0 && v.bottom - v.top > 0) inter.push({ el, r: v, rr: r, box: box(r), fixed });
      // A link inside a sentence is exempt (WCAG 2.5.8 inline exception).
      const inline = cs.display === 'inline' && el.parentElement && ownText(el.parentElement);
      if (phone && !inline && (r.width < 44 || r.height < 44)) add(out.touch, { selector: sel(el), box: box(r) });
    }
  }
  // Containment allows 4 px of slack (a caption link laid over its image link); two links to
  // the same href do the same thing wherever they are tapped. A fixed or sticky bar covers the
  // content scrolling under it by design, so a pair is checked only within the same kind of layer.
  const inside = (a, b) => a.left - 4 <= b.left && a.top - 4 <= b.top && a.right + 4 >= b.right && a.bottom + 4 >= b.bottom;
  const sameHref = (a, b) => a.localName === 'a' && b.localName === 'a' && a.href && a.href === b.href;
  for (let i = 0; i < inter.length; i++) {
    for (let j = i + 1; j < inter.length; j++) {
      const A = inter[i], B = inter[j];
      const ox = Math.min(A.r.right, B.r.right) - Math.max(A.r.left, B.r.left);
      const oy = Math.min(A.r.bottom, B.r.bottom) - Math.max(A.r.top, B.r.top);
      if (ox <= 4 || oy <= 4 || A.fixed !== B.fixed) continue;
      if (A.el.contains(B.el) || B.el.contains(A.el) || inside(A.r, B.r) || inside(B.r, A.r) || sameHref(A.el, B.el)) continue;
      add(out.overlap, { selector: sel(A.el), box: A.box, other: sel(B.el), otherBox: B.box });
    }
  }
  // ...unless the content can never scroll clear of the bar: under a bottom bar even at the deepest
  // scroll the page and its scroll boxes allow, or under a top bar already at scroll 0.
  const se = document.scrollingElement || html;
  const bars = barEls.map((el) => ({ el, r: rect(el) }))
    .filter(({ r }) => r.top >= -1 && r.bottom <= vh + 1 && r.height < vh / 2 && (r.top >= vh / 2 || r.bottom <= vh / 2));
  for (const bar of bars) {
    const bottom = bar.r.top >= vh / 2;
    for (const c of inter) {
      if (c.fixed || bar.el.contains(c.el)) continue;
      const scs = [];  // scroll boxes around it, outermost first
      for (let a = c.el.parentElement; a && a !== html && a !== document.body; a = a.parentElement) if (/auto|scroll/.test(st(a).overflowY) && a.scrollHeight > a.clientHeight + 1) scs.unshift(a);
      let shift = bottom ? se.scrollHeight - vh - window.scrollY : -window.scrollY, top = -Infinity, bot = Infinity;
      for (const a of scs) {
        const ar = rect(a);
        top = Math.max(top, ar.top - shift); bot = Math.min(bot, ar.bottom - shift);
        shift += bottom ? a.scrollHeight - a.clientHeight - a.scrollTop : -a.scrollTop;
      }
      top = Math.max(top, c.rr.top - shift); bot = Math.min(bot, c.rr.bottom - shift);
      const ox = Math.min(c.rr.right, bar.r.right) - Math.max(c.rr.left, bar.r.left);
      const oy = Math.min(bot, bar.r.bottom) - Math.max(top, bar.r.top);
      if (ox <= 4 || oy <= 4) continue;
      const hit = document.elementFromPoint(Math.max(c.rr.left, bar.r.left) + ox / 2, Math.max(top, bar.r.top) + oy / 2);
      if (hit && bar.el.contains(hit)) add(out.overlap, { selector: sel(c.el), box: c.box, other: sel(bar.el), otherBox: box(bar.r), fixedBar: true });
    }
  }
  for (const { el, top } of probes) {
    if (!offFlagged.has(top) && !shownOnFocus(el)) { offFlagged.add(top); add(out.offscreen, { selector: sel(top), box: box(rect(top)) }); }
  }
  return out;
}

async function runAxe(axe, sel, { ignores, max }) {
  const ctx = ignores.length ? { exclude: ignores.map((s) => [s]) } : document;
  const res = await axe.run(ctx, { runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag22aa'] }, resultTypes: ['violations'] });
  const find = (t) => { try { return typeof t === 'string' ? document.querySelector(t) : null; } catch { return null; } };
  const box = (el) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return [r.x, r.y, r.width, r.height].map(Math.round);
  };
  return res.violations.map((v) => {
    const rule = { id: v.id, impact: v.impact, count: v.nodes.length };
    if (v.id === 'color-contrast' || v.id === 'target-size') {
      rule.examples = v.nodes.slice(0, Math.min(3, max)).map((n) => {
        const d = (n.any[0] || n.none[0] || n.all[0] || {}).data || {};
        const t = n.target[n.target.length - 1];
        const el = find(t);
        const ex = { selector: el ? sel(el) : [].concat(t).join(' >>> '), box: box(el) };
        if (v.id === 'color-contrast') Object.assign(ex, { ratio: d.contrastRatio, need: parseFloat(d.expectedContrastRatio), fg: d.fgColor, bg: d.bgColor });
        else Object.assign(ex, { size: d.width && d.height ? [Math.round(d.width), Math.round(d.height)] : undefined, min: d.minSize });
        return ex;
      });
    }
    return rule;
  });
}

async function checkViewport(browser, deps, o, width, theme) {
  // Phone widths get a phone UA and touch, so sites that serve a separate mobile page are checked
  // on it. No isMobile: it widens the layout viewport to fit overflowing content and hides overflow.
  const phone = width <= 480;
  const height = phone ? 812 : 900;
  const ctx = await browser.newContext({ viewport: { width, height }, colorScheme: theme,
    ...(phone ? { hasTouch: true, userAgent: deps.phoneUA } : {}),
    ...(o.storage ? { storageState: o.storage } : {}) });
  const run = (async () => {
    const page = await ctx.newPage();
    const errors = [];
    page.on('console', (m) => { if (m.type() === 'error') errors.push(m.text()); });
    page.on('pageerror', (e) => errors.push(String(e && e.message || e)));
    let resp;
    try { resp = await page.goto(o.url, { waitUntil: 'domcontentloaded', timeout: 30000 }); }
    catch (e) { throw Object.assign(new Error(`navigation failed: ${e.message.split('\n')[0]}`), { nav: true }); }
    if (resp && resp.status() >= 400) throw Object.assign(new Error(`navigation failed: HTTP ${resp.status()} for ${o.url}`), { nav: true });
    await page.waitForLoadState('load', { timeout: 15000 }).catch(() => {});
    if (o.wait) await page.waitForTimeout(o.wait);
    // One evaluate through CDP (a page CSP cannot block it): axe is injected with define/module
    // shadowed and used through module.exports, never through a window.axe the page may have replaced.
    const res = await page.evaluate(`(async () => {
      const args = ${JSON.stringify({ ignores: o.ignores, phone, max: MAX })}, hold = {};
      const dom = (${domChecks})(args, hold);
      if (dom.badIgnore) return { dom };
      var define, exports, module = { exports: {} };
      ${deps.axeSrc}
      ;return { dom, axe: await (${runAxe})(module.exports, hold.sel, args) };
    })()`);
    const { dom, axe } = res;
    if (dom.badIgnore) throw Object.assign(new Error(`invalid --ignore selector: ${dom.badIgnore}`), { nav: true });
    const vp = { width, height, theme, dir: dom.dir, lang: dom.lang, pageOverflow: dom.pageOverflow, viewportMeta: dom.viewportMeta,
      overflow: dom.overflow, offscreen: dom.offscreen, clipped: dom.clipped, clippedByAncestor: dom.clippedByAncestor,
      overlap: dom.overlap, touch: phone ? dom.touch : null, rtlTextLeft: dom.rtlTextLeft,
      console: { count: errors.length, messages: errors.slice(0, 3) },
      axe: { count: axe.reduce((n, r) => n + r.count, 0), rules: axe } };
    vp.findings = (vp.pageOverflow ? 1 : 0) + (vp.viewportMeta ? 1 : 0) + vp.overflow.count + vp.offscreen.count +
      vp.clipped.count + vp.clippedByAncestor.count + vp.overlap.count + (vp.touch ? vp.touch.count : 0) +
      vp.rtlTextLeft.count + vp.console.count + vp.axe.count;
    return vp;
  })();
  run.catch(() => {});
  let timer, hung = false;
  const limit = new Promise((_, reject) => { timer = setTimeout(() => { hung = true; reject(Object.assign(
    new Error(`timed out after ${o.timeout}s at ${width} ${theme}: the page is busy or hung (raise --timeout)`), { nav: true, timeout: true })); }, o.timeout * 1000); });
  try {
    return await Promise.race([run, limit]);
  } finally {
    clearTimeout(timer);
    // A hung renderer can stall a graceful close; the browser close in main() ends it.
    const closing = ctx.close().catch(() => {});
    if (!hung) await closing;
  }
}

function fmtBox(b) { return b ? `[${b.join(',')}]` : ''; }
function clip(s, n = 200) { s = String(s).replace(/[\r\n\t]+/g, ' ').replace(CTL, ''); return s.length > n ? s.slice(0, n - 1) + '…' : s; }

function human(o, vps) {
  const lines = [`ui-check ${o.url}`];
  const row = (name, c, f) => { if (c && c.count) lines.push(clip(`  ${name} ${c.count}: ${c.examples.slice(0, 3).map(f).join('; ')}`)); };
  const plain = (e) => `${e.selector} ${fmtBox(e.box)}`;
  for (const v of vps) {
    if (v.timedOut) { lines.push(clip(`${v.width} ${v.theme}  ${v.error}`)); continue; }
    const po = v.pageOverflow ? `  page-overflow ${v.pageOverflow.scrollWidth}>${v.pageOverflow.clientWidth}` : '';
    lines.push(`${v.width} ${v.theme}  dir=${clip(v.dir || '-', 20)} lang=${clip(v.lang || '-', 20)}${po}  ${v.findings ? `findings ${v.findings}` : 'clean'}`);
    if (v.viewportMeta) lines.push(clip(`  viewport-meta ${v.viewportMeta.problem}${v.viewportMeta.content !== undefined ? ` "${v.viewportMeta.content}"` : ''}`));
    row('past-viewport', v.overflow, plain);
    row('off-screen', v.offscreen, plain);
    row('clipped-text', v.clipped, plain);
    row('clipped-by-ancestor', v.clippedByAncestor, (e) => `${e.selector} ${fmtBox(e.box)} by ${e.by}`);
    row('overlap', v.overlap, (e) => `${e.selector} ${fmtBox(e.box)} x ${e.fixedBar ? 'fixed bar ' : ''}${e.other} ${fmtBox(e.otherBox)}`);
    row('touch<44', v.touch, plain);
    row('rtl text-align:left', v.rtlTextLeft, plain);
    if (v.console.count) lines.push(clip(`  console-errors ${v.console.count}: ${v.console.messages.map((m) => JSON.stringify(clip(m, 70))).join(' | ')}`));
    if (v.axe.count) {
      lines.push(clip(`  axe ${v.axe.rules.length} rules/${v.axe.count} nodes: ${v.axe.rules.map((r) => `${r.id}(${r.impact})x${r.count}`).join(', ')}`, 240));
      for (const r of v.axe.rules.filter((x) => x.examples)) {
        const f = r.id === 'color-contrast' ? (e) => `${e.selector} ${e.ratio}:1<${e.need} ${e.fg}/${e.bg} ${fmtBox(e.box)}`
          : (e) => `${e.selector} ${e.size ? e.size.join('x') : '?'}<${e.min || 24} ${fmtBox(e.box)}`;
        lines.push(clip(`    ${r.id}: ${r.examples.map(f).join('; ')}`));
      }
    }
  }
  const total = vps.reduce((n, v) => n + v.findings, 0);
  lines.push(`total findings ${total} -> exit ${vps.some((v) => v.timedOut) ? 2 : total ? 1 : 0}${o.json ? '' : '  (--json for all fields)'}`);
  return lines.map((l) => l.replace(CTL, '')).join('\n');
}

async function main() {
  const o = parseArgs(process.argv.slice(2));
  const deps = loadDeps();
  let browser;
  const vps = [];
  try {
    browser = await deps.chromium.launch({ headless: true, chromiumSandbox: true, ignoreDefaultArgs: ['--disable-dev-shm-usage'] });
    viewports: for (const w of o.widths) for (const t of o.themes) {
      // A timeout keeps the viewports already done and is reported with them; the rest are skipped.
      try { vps.push(await checkViewport(browser, deps, o, w, t)); }
      catch (e) { if (!e.timeout) throw e; vps.push({ width: w, theme: t, timedOut: true, error: e.message, findings: 0 }); break viewports; }
    }
  } catch (e) {
    process.stderr.write(`ui-check: ${e.nav ? clip(e.message, 400) : (e.stack || e)}\n`);
    process.exitCode = 2;
    return;
  } finally {
    if (browser) await Promise.race([browser.close().catch(() => {}), new Promise((r) => setTimeout(r, 3000).unref())]);
  }
  const total = vps.reduce((n, v) => n + v.findings, 0);
  const timedOut = vps.find((v) => v.timedOut);
  process.stdout.write((o.json ? JSON.stringify({ url: o.url, findings: total, timedOut: !!timedOut, viewports: vps }, null, 2)
    .replace(RAW, (c) => '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0')) : human(o, vps)) + '\n');
  if (timedOut) process.stderr.write(`ui-check: ${clip(timedOut.error, 400)}\n`);
  process.exitCode = timedOut ? 2 : total ? 1 : 0;
}

main().catch((e) => { process.stderr.write(`ui-check: internal error: ${e && e.stack || e}\n`); process.exit(2); });
