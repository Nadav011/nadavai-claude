#!/usr/bin/env bash
# Launch Claude Code with:
#   - MAIN model = Opus on your Max SUBSCRIPTION (via LiteLLM OAuth passthrough)
#   - background SUBAGENTS = kimi-k2.6 on NVIDIA NIM (cheap/free)
# One command. Ensures the proxy is up first, then launches Claude connected.

bash ~/litellm/start-proxy.sh

# wait until the proxy answers (max ~30s)
for _ in $(seq 1 30); do
  curl -s -m 2 http://localhost:4000/health/readiness 2>/dev/null | grep -q healthy && break
  sleep 1
done

export ANTHROPIC_BASE_URL=http://localhost:4000
export ANTHROPIC_CUSTOM_HEADERS="x-litellm-api-key: Bearer sk-local-smoke"
export CLAUDE_CODE_SUBAGENT_MODEL=nim-kimi
unset ANTHROPIC_API_KEY

exec claude "$@"
