#!/usr/bin/env bash
# ci-wait-wp: wait for the Woodpecker landing run (ci.nadavc.ai) of one commit. ci-wait hands over
# to it for every repo listed in lib/woodpecker-repos.txt; run it directly the same way.
#
#   ci-wait-wp <repo> <sha|branch|pr:N> [--timeout MIN] [--slice SEC] [--land | --check] [--detach]
#
#   --check    a CI answer on a branch without a landing: a manual run of the branch head (every
#              step; statuses ci/woodpecker/manual/*, never counted as a landing). For a branch
#              that must not be merged.
#
#   --land     make sure the commit is a landing: an open, non-draft PR into main. A branch with no
#              PR gets one (title = its newest commit's subject); a draft PR is marked ready.
#   --timeout  default 90 minutes. --require full is accepted and ignored (a landing is the full
#              answer for what the PR changed; the night runs everything).
#   --detach   keep waiting when the process that started it is gone.
#   --slice    give up after SEC seconds (at least 60) with exit 7 when CI is still going; the same
#              command run again picks the wait up: --timeout, the 10- and 15-minute checks and the
#              one automatic restart all count from the first slice. Not with --check (each call
#              starts a run). For subagents and Workflow agents, whose prompt cache lives 5 minutes:
#              --slice 140 with the Bash tool's timeout at 175000 (Bash moves a longer call to the
#              background, after 120 s by default and after 180 s in a background subagent).
#
# CI runs only on a non-draft PR into main and at night; a branch push alone runs nothing.
# Run it with run_in_background: true and continue when it ends; never a status loop.
#
# Exit codes: 0 green; 1 red (failed steps and the log tail of the first are printed); 2 timeout;
# 3 Woodpecker unreachable 3 times in a row, or no run appeared; 4 the starting process is gone;
# 5 nothing to wait on (no landing PR for this commit, a draft, or a run Woodpecker blocked or
# skipped); 6 superseded (a newer push to the PR cancelled this run: wait on the new head);
# 7 still running at the end of --slice (run the same command again).
set -uo pipefail

OWNER=Nadav011
ENV_FILE=${WOODPECKER_ENV_FILE:-$HOME/.claude/secrets/woodpecker.env}
POLL=${CI_WAIT_POLL:-20}
PENDING_WARN_S=300

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

repo="" ref="" timeout_min=90 land="" follow=${CI_WAIT_FOLLOW_PARENT:-1} branch="" slice=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --timeout) timeout_min=${2:-}; shift ;;
    --timeout=*) timeout_min=${1#*=} ;;
    --slice) slice=${2:-}; slice_given=1; shift ;;
    --slice=*) slice=${1#*=}; slice_given=1 ;;
    --require) shift ;;
    --require=*) ;;
    --land) land=1 ;;
    --check) check=1 ;;
    --detach) follow=0 ;;
    -*) echo "ci-wait-wp: unknown option $1" >&2; usage 64 >&2 ;;
    *) if [ -z "$repo" ]; then repo=$1; elif [ -z "$ref" ]; then ref=$1; else usage 64 >&2; fi ;;
  esac
  shift
done
[ -n "$repo" ] && [ -n "$ref" ] || usage 64 >&2
[[ $timeout_min =~ ^[0-9]+$ ]] || { echo "ci-wait-wp: --timeout takes whole minutes" >&2; exit 64; }
if [ -n "${slice_given:-}" ]; then
  [[ $slice =~ ^[0-9]+$ && $slice -ge 60 ]] || { echo "ci-wait-wp: --slice takes whole seconds, at least 60" >&2; exit 64; }
  [ -z "${check:-}" ] || { echo "ci-wait-wp: --slice does not go with --check: every --check call starts a new run" >&2; exit 64; }
fi
slice_end=$(( $(date +%s) + ${slice:-0} )) phase_msg=""
sliced() { # exit 7 when --slice is up: the caller runs the same command again
  [ -n "$slice" ] && [ "$(date +%s)" -ge "$slice_end" ] || return 0
  local k=0
  if [ -n "${sd:-}" ]; then [ -r "$sd/slices" ] && read -r k <"$sd/slices"; [[ $k =~ ^[0-9]+$ ]] || k=0; fi
  k=$(( k + 1 )); [ -n "${sd:-}" ] && echo "$k" >"$sd/slices"
  if [ -n "${n:-}" ]; then
    echo "ci-wait-wp: still running on ${sha:0:7} (pipeline $n)${phase_msg:+, $phase_msg} after slice $k: run the same command again to keep waiting"
  else
    echo "ci-wait-wp: no Woodpecker run for ${sha:0:7} yet after slice $k: run the same command again to keep waiting"
  fi
  [ "$k" -ge 12 ] && echo "ci-wait-wp: this wait has taken $k slices; if CI needs much longer, return and give the caller this command without --slice, to run in the background (its cache lasts an hour)"
  exit 7
}
nap() { # sleep POLL, or what is left of the slice, then check the slice
  local t=$POLL left
  if [ -n "$slice" ]; then left=$(( slice_end - $(date +%s) )); [ "$left" -lt "$t" ] && t=$left; fi
  [ "$t" -ge 1 ] && sleep "$t"
  sliced
}
repo=${repo#"$OWNER/"}
[[ $repo =~ ^[A-Za-z0-9._-]+$ ]] || { echo "ci-wait-wp: $repo is not a repository name" >&2; exit 64; }

if [ -z "${WOODPECKER_TOKEN:-}" ]; then
  # shellcheck disable=SC1090
  [ -r "$ENV_FILE" ] && { set -a; . "$ENV_FILE"; set +a; }
fi
SERVER=${WOODPECKER_SERVER:-https://ci.nadavc.ai}
[ -n "${WOODPECKER_TOKEN:-}" ] || { echo "ci-wait-wp: no WOODPECKER_TOKEN (vault file $ENV_FILE)" >&2; exit 3; }

# The token goes to curl through a file descriptor, never on its command line (/proc/*/cmdline).
api() { curl -sf --max-time 20 -H @<(printf 'Authorization: Bearer %s\n' "$WOODPECKER_TOKEN") "$SERVER/api/$1"; }

# gh with three tries: a reset connection to api.github.com must not read as "no such commit".
ghr() { local i out; for i in 1 2 3; do out=$(timeout 20 gh "$@" 2>/dev/null) && { printf '%s\n' "$out"; return 0; }; sleep 3; done; return 1; }

parent=$PPID
parent_alive() { [ "$follow" = 0 ] || kill -0 "$parent" 2>/dev/null; }

for _ in 1 2 3; do
  rid=$(api "repos/lookup/$OWNER/$repo" | jq -r 'select(.active == true) | .id' 2>/dev/null)
  [ -n "$rid" ] && break; sleep 3
done
[ -n "$rid" ] || { echo "ci-wait-wp: $OWNER/$repo is not active on Woodpecker ($SERVER), or Woodpecker is unreachable" >&2; exit 3; }

# Resolve the ref to a head sha once; a later push does not move what this waits for.
sha="" pr=""
case "$ref" in
  pr:*|'#'*) pr=${ref#pr:}; pr=${pr#\#}
             [[ $pr =~ ^[0-9]+$ ]] || { echo "ci-wait-wp: pr:N takes a PR number" >&2; exit 64; }
             sha=$(ghr pr view "$pr" -R "$OWNER/$repo" --json headRefOid --jq .headRefOid 2>/dev/null) ;;
  *) [[ $ref =~ ^[0-9a-f]{7,40}$ ]] || branch=$ref
     sha=$(ghr api "repos/$OWNER/$repo/commits/$ref" --jq .sha 2>/dev/null) ;;
esac
[[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "ci-wait-wp: cannot resolve $ref in $OWNER/$repo" >&2; exit 64; }

# --check: a CI answer on a branch without a landing (no PR, nothing to merge, e.g. a DO-NOT-MERGE
# integration branch). A manual Woodpecker run of the branch head runs every step; its statuses are
# ci/woodpecker/manual/*, which the merge guard never counts as a landing.
if [ -n "${check:-}" ]; then
  [ -n "$branch" ] || { echo "ci-wait-wp: --check takes a branch name" >&2; exit 64; }
  n=$(curl -sf --max-time 20 -X POST -H @<(printf 'Authorization: Bearer %s\n' "$WOODPECKER_TOKEN") -H 'Content-Type: application/json' \
      "$SERVER/api/repos/$rid/pipelines" -d "$(jq -cn --arg b "$branch" '{branch: $b}')" | jq -r '.number // empty')
  [ -n "$n" ] || { echo "ci-wait-wp: could not start a manual run of $branch" >&2; exit 3; }
  echo "ci-wait-wp: started a manual check run of $branch (${sha:0:7}): $SERVER/repos/$rid/pipeline/$n"
  prj="" prnum="" land=""
  skip_pr=1
fi

if [ -z "${skip_pr:-}" ]; then
# The open PR whose head is this sha (the landing request).
prs=$(ghr pr list -R "$OWNER/$repo" --state open --base main --json number,isDraft,headRefOid,headRefName --limit 200 2>/dev/null)
prj=$(jq -c --arg s "$sha" '[.[] | select(.headRefOid == $s)][0] // empty' <<<"${prs:-[]}" 2>/dev/null)
if [ -n "$land" ]; then
  if [ -z "$prj" ]; then
    [ -n "$branch" ] || { echo "ci-wait-wp: --land needs a branch name (or an open PR) for ${sha:0:7}" >&2; exit 5; }
    title=$(ghr api "repos/$OWNER/$repo/commits/$sha" --jq '.commit.message | split("\n")[0]' 2>/dev/null)
    url=$(gh pr create -R "$OWNER/$repo" --base main --head "$branch" --title "${title:-$branch}" \
      --body "Landing request opened by ci-wait --land." 2>/dev/null) \
      || { echo "ci-wait-wp: could not open a PR for $branch (is it pushed, and is its head ${sha:0:7}?)" >&2; exit 5; }
    echo "ci-wait-wp: opened landing PR $url"
    prj=$(jq -cn --arg n "${url##*/}" '{number: ($n | tonumber), isDraft: false}')
  elif [ "$(jq -r .isDraft <<<"$prj")" = true ]; then
    # Marking a draft ready sends GitHub's ready_for_review event, which Woodpecker does not turn into
    # a run (it only builds opened/synchronize). A landing then needs one more push.
    gh pr ready "$(jq -r .number <<<"$prj")" -R "$OWNER/$repo" >/dev/null 2>&1 \
      && echo "ci-wait-wp: marked PR #$(jq -r .number <<<"$prj") ready"
    echo "ci-wait-wp: Woodpecker starts a landing run only on a push, not on 'ready'. Push the branch once more (an empty commit works: git commit --allow-empty -m 'ci: land' && git push), then run ci-wait $repo ${branch:-pr:$(jq -r .number <<<"$prj")} again."
    exit 5
  fi
elif [ -n "$prj" ] && [ "$(jq -r .isDraft <<<"$prj")" = true ]; then
  echo "ci-wait-wp: PR #$(jq -r .number <<<"$prj") is a draft: drafts run no CI. Mark it ready (gh pr ready) or pass --land." >&2
  exit 5
fi
prnum=""; [ -n "$prj" ] && prnum=$(jq -r '.number // empty' <<<"$prj" 2>/dev/null)
# A commit on main is not tested again (rule 7): it answers with the landing of the PR it was merged
# from, so a wait on main after a merge reports that PR's run.
if [ -z "$prj" ] && [ -z "$land" ]; then
  pulls=$(ghr api "repos/$OWNER/$repo/commits/$sha/pulls" 2>/dev/null)
  mp=$(jq -c --arg s "$sha" '[.[] | select(.merged_at != null and .base.ref == "main" and .merge_commit_sha == $s)][0] // empty | {number, head: .head.sha}' <<<"${pulls:-[]}" 2>/dev/null)
  if [ -n "$mp" ]; then
    prnum=$(jq -r .number <<<"$mp"); merged_from=${sha:0:7}; sha=$(jq -r .head <<<"$mp"); prj=$mp
    echo "ci-wait-wp: $merged_from on main is the merge of PR #$prnum; main is not tested again, so this reports PR #$prnum's landing (head ${sha:0:7})"
  else
    # An earlier head of a PR: keep its number for the flake check (which files the PR changed).
    prnum=$(jq -r '[.[] | select(.base.ref == "main")][0].number // empty' <<<"${pulls:-[]}" 2>/dev/null)
    [ -n "$prnum" ] && prj=$(jq -cn --arg n "$prnum" '{number: ($n | tonumber), isDraft: false}')
  fi
fi
fi

# A landing waits on the PR's own pull_request run; with no PR, a cron or manual run of the sha counts.
if [ -n "$prj" ]; then sel='select(.commit == $s and .event == "pull_request")'; else sel='select(.commit == $s)'; fi

# One automatic restart per wait (rule 8: an infrastructure stop or a suspected flake), logged.
retried=""
FLAKE_LOG=${CI_WAIT_FLAKE_LOG:-$HOME/.cache/ci-wait/flakes.log}
restart_seen() { # a sliced wait runs this script several times: a restart an earlier slice of it made counts
  [ -n "$slice" ] && [ -r "$FLAKE_LOG" ] || return 0
  awk -F'\t' -v s="$(date -d "@$start" -Iseconds)" -v r="$repo" -v h="${sha:0:9}" -v h0="${sha0:0:9}" \
    '$1 >= s && $2 == r && ($3 == h || $3 == h0) { f = 1 } END { exit !f }' "$FLAKE_LOG" && retried=1
  return 0
}
restart_run() { # reason: restart pipeline $n, switch the wait to the new run
  local new
  [ -n "${CI_WAIT_DRY_RESTART:-}" ] && { echo "ci-wait-wp: [dry run] would restart pipeline $n once ($1)"; return 1; }
  new=$(curl -sf --max-time 20 -X POST -H @<(printf 'Authorization: Bearer %s\n' "$WOODPECKER_TOKEN") "$SERVER/api/repos/$rid/pipelines/$n" | jq -r '.number // empty' 2>/dev/null)
  [ -n "$new" ] || return 1
  mkdir -p "${FLAKE_LOG%/*}"
  printf '%s\t%s\t%s\tpipeline %s -> %s\t%s\n' "$(date -Iseconds)" "$repo" "${sha:0:9}" "$n" "$new" "$1" >>"$FLAKE_LOG"
  echo "ci-wait-wp: restarted pipeline $n as $new once ($1); logged in $FLAKE_LOG"
  n=$new retried=1
  nap
}

# A sliced wait keeps its clocks in $sd (first slice, no-run since, security wait since), so --timeout
# and the 10- and 15-minute checks count from the first slice; removed when the wait ends.
# Keyed by the ref as given (pr:N, branch or sha), with the head it moved to in $sd/head, so a PR that
# moves keeps one set of clocks. A folder with no write in 10 minutes is an abandoned wait.
sd=""
find "$HOME/.cache/ci-wait" -maxdepth 1 -type d -name 'slice-*' -mmin +1440 -exec rm -rf {} + 2>/dev/null
if [ -n "$slice" ]; then
  sd="$HOME/.cache/ci-wait/slice-$repo-$(printf '%s' "$ref" | tr -c 'A-Za-z0-9._-' '_')"
  if [ -d "$sd" ] && [ -z "$(find "$sd" -type f -mmin -10 2>/dev/null | head -1)" ]; then rm -rf "${sd:?}"; fi
  mkdir -p "$sd"
  trap 'rc=$?; [ "$rc" = 7 ] || [ -z "${sd:-}" ] || rm -rf "${sd:?}"' EXIT
  h=""; [ -r "$sd/head" ] && read -r h <"$sd/head"
  if [[ $h =~ ^[0-9a-f]{40}$ ]] && [ "$h" != "$sha" ]; then
    echo "ci-wait-wp: an earlier slice followed PR #$prnum to ${h:0:7}; waiting on that head"; sha=$h
  fi
fi
clock() { # clock <name>: when <name> started in this sliced wait (now, and remembered, when unset)
  local now t=""; now=$(date +%s)
  if [ -n "$sd" ]; then [ -r "$sd/$1" ] && read -r t <"$sd/$1"; [[ $t =~ ^[0-9]+$ ]] || { t=$now; echo "$t" >"$sd/$1"; }; fi
  echo "${t:-$now}"
}
start=$(clock start)
sha0=$sha
[ -n "$sd" ] && [ -r "$sd/head0" ] && read -r sha0 <"$sd/head0"
[ -n "$sd" ] && [ ! -e "$sd/head0" ] && echo "$sha" >"$sd/head0"
restart_seen
deadline=$(( start + timeout_min * 60 ))
down=0 warned="" since=$(clock "norun-${sha:0:12}") n=""
while :; do
  parent_alive || { echo "ci-wait-wp: the process that started this wait is gone"; exit 4; }
  sliced
  [ "$(date +%s)" -lt "$deadline" ] || { echo "ci-wait-wp: timeout after ${timeout_min} min on ${sha:0:7}${n:+ (pipeline $n)}"; exit 2; }
  if [ -z "$n" ]; then
    if ! list=$(api "repos/$rid/pipelines?per_page=50"); then
      down=$((down + 1)); [ "$down" -ge 3 ] && { echo "ci-wait-wp: Woodpecker ($SERVER) unreachable 3 times in a row"; exit 3; }
      nap; continue
    fi
    down=0
    n=$(jq -r --arg s "$sha" "[.[] | $sel] | sort_by(.number) | last | .number // empty" <<<"$list" 2>/dev/null)
    if [ -z "$n" ]; then
      waited=$(( $(date +%s) - since ))
      # Right after a push GitHub can still report the PR's previous head: follow the PR if it moved.
      if [ -n "$prnum" ] && [ "$waited" -ge 30 ]; then
        now=$(ghr pr view "$prnum" -R "$OWNER/$repo" --json headRefOid --jq .headRefOid)
        if [[ $now =~ ^[0-9a-f]{40}$ ]] && [ "$now" != "$sha" ]; then
          echo "ci-wait-wp: PR #$prnum moved to ${now:0:7}; waiting on that head"
          sha=$now
          [ -n "$sd" ] && echo "$sha" >"$sd/head"
          since=$(clock "norun-${sha:0:12}")
          restart_seen
          nap; continue
        fi
      fi
      if [ -z "$prj" ] && [ "$waited" -ge 60 ]; then
        echo "ci-wait-wp: no landing run for ${sha:0:7}: a branch push runs no CI. Open a non-draft PR into main, or run ci-wait $repo <branch> --land."
        exit 5
      fi
      [ "$waited" -ge 600 ] && { echo "ci-wait-wp: PR #$prnum exists but Woodpecker created no run in 10 min (webhook, or no .woodpecker/ on the PR): $SERVER/repos/$rid"; exit 3; }
      nap; continue
    fi
    echo "ci-wait-wp: $repo ${sha:0:7} -> $SERVER/repos/$rid/pipeline/$n"
  fi
  if ! d=$(api "repos/$rid/pipelines/$n"); then
    down=$((down + 1)); [ "$down" -ge 3 ] && { echo "ci-wait-wp: Woodpecker ($SERVER) unreachable 3 times in a row"; exit 3; }
    nap; continue
  fi
  down=0
  st=$(jq -r '.status // empty' <<<"$d")
  case "$st" in
    success)
      dur=$(jq -r '((.finished // 0) - (.started // 0))' <<<"$d" 2>/dev/null); [[ $dur =~ ^[0-9]+$ ]] || dur=0
      echo "green: $repo ${sha:0:7} pipeline $n in $((dur / 60))m$((dur % 60))s"
      jq -r '.workflows[]?.children[]? | "  \(.name): \(.state)"' <<<"$d" 2>/dev/null
      # The merge also needs nadavai-security (secscan on omarchy, a separate status), so a landing
      # wait covers it too: up to 15 more minutes for it to post, then its verdict.
      sdead=$(( $(clock security) + 900 )) phase_msg="Woodpecker green, waiting for nadavai-security"
      while :; do
        sj=$(ghr api "repos/$OWNER/$repo/commits/$sha/statuses?per_page=100" --jq '[.[] | select(.context == "nadavai-security")] | sort_by(.id) | last // {} | [.state // "none", (.description // "")] | @tsv')
        IFS=$'\t' read -r sst sdesc <<<"${sj:-none}"
        case "$sst" in
          success) echo "  nadavai-security: success ($sdesc)"; exit 0 ;;
          failure|error) echo "red: nadavai-security is $sst on ${sha:0:7}: $sdesc (details: ssh omarchy ls ~/secscan/logs)"; exit 1 ;;
        esac
        parent_alive || { echo "ci-wait-wp: the process that started this wait is gone"; exit 4; }
        sliced
        [ "$(date +%s)" -lt "$sdead" ] || { echo "ci-wait-wp: Woodpecker is green but nadavai-security has not answered in 15 min (state: $sst); check secscan on omarchy (systemctl --user status secscan-poll.timer)"; exit 2; }
        nap
      done ;;
    killed)
      now=""
      [ -n "$prnum" ] && now=$(ghr pr view "$prnum" -R "$OWNER/$repo" --json headRefOid --jq .headRefOid 2>/dev/null)
      if [ -n "$now" ] && [ "$now" != "$sha" ]; then
        echo "superseded: pipeline $n of ${sha:0:7} was cancelled by a newer push (PR #$prnum head is now ${now:0:7}). Wait on that: ci-wait $repo pr:$prnum"
        exit 6
      fi
      # Woodpecker cancels the other steps when one fails and may call the run killed: report the
      # failed step like a failure; a kill with no failed step is an infrastructure stop.
      if ! jq -e '[.workflows[]?.children[]? | select(.state == "failure")] | length > 0' <<<"$d" >/dev/null 2>&1; then
        # An infrastructure stop (agent restart, cancel of an orphaned run): restart it once.
        if [ -z "$retried" ] && restart_run "infrastructure stop: killed with no failed step"; then continue; fi
        echo "red: $repo ${sha:0:7} pipeline $n was killed with no failed step (agent restart or manual cancel; infrastructure): $SERVER/repos/$rid/pipeline/$n"
        exit 1
      fi ;&
    failure|error|declined)
      echo "red: $repo ${sha:0:7} pipeline $n is $st: $SERVER/repos/$rid/pipeline/$n"
      jq -r '.workflows[]?.children[]? | select(.state != "success" and .state != "skipped") | "  \(.name): \(.state) (exit \(.exit_code))"' <<<"$d" 2>/dev/null
      sid=$(jq -r '[.workflows[]?.children[]? | select(.state == "failure")][0].id // empty' <<<"$d" 2>/dev/null)
      if [ -n "$sid" ]; then
        # The failure lines of the first failed step (test runners interleave output, so its last
        # lines are often passing tests), then its last 15 lines.
        log=$(api "repos/$rid/logs/$n/$sid" | jq -r '.[] | .data // empty' 2>/dev/null \
          | while IFS= read -r l; do printf '%s' "$l" | base64 -d 2>/dev/null; echo; done | sed 's/\x1b\[[0-9;]*m//g; /^$/d')
        fails=$(grep -E '(^| )(FAIL|×|✗|✘|ERROR|Error:|error:|failed|Test Files|Tests  |exit status)' <<<"$log" | grep -v -E '^ *✓' | tail -25 | cut -c1-300)
        # A suspected flake (rule 8): every failed step is a test step, every failing test file is
        # one this PR did not change, and this is the first run of the sha. Restart once and log it;
        # a real regression fails again and is reported red with "failed twice".
        if [ -z "$retried" ] && [ -n "$prnum" ]; then
          # Vitest/Jest name the file on the FAIL line; Deno names it in its ERRORS list ("name => ./dir/x.test.ts:306:6").
          ftests=$( { grep -E '(^| )(FAIL|×|✗|✘|FAILED)' <<<"$log" | grep -oE '[A-Za-z0-9_./-]+\.(test|spec)\.[cm]?[jt]sx?'
                      grep -oE '=> \.?/?[A-Za-z0-9_./-]+\.(test|spec)\.[cm]?[jt]sx?:[0-9]+' <<<"$log" | sed -E 's|^=> \.?/?||; s|:[0-9]+$||'; } | sort -u)
          nontest=$(jq -r '[.workflows[]?.children[]? | select(.state == "failure") | .name | select(test("^(unit|integration|e2e|edge|sql|test)") | not)] | length' <<<"$d" 2>/dev/null)
          if [ -n "$ftests" ] && [ "${nontest:-1}" = 0 ]; then
            prf=$(ghr api --paginate "repos/$OWNER/$repo/pulls/$prnum/files?per_page=100" --jq '.[].filename')
            touched=""
            while IFS= read -r t; do grep -qF "$t" <<<"$prf" && touched=1; done <<<"$ftests"
            if [ -z "$touched" ] && restart_run "suspected flake in tests this PR did not change: $(tr '\n' ' ' <<<"$ftests")"; then continue; fi
          fi
        fi
        [ -n "$retried" ] && echo "failed twice (also after the one automatic restart): not a flake"
        echo "--- failures in the first failed step:"
        printf '%s\n' "$fails"
        echo "--- its last lines:"
        tail -15 <<<"$log" | cut -c1-300
      fi
      exit 1 ;;
    blocked|skipped)
      echo "ci-wait-wp: pipeline $n is $st (Woodpecker did not run it): $SERVER/repos/$rid/pipeline/$n"
      exit 5 ;;
    pending)
      created=$(jq -r '.created // 0' <<<"$d")
      if [ -z "$warned" ] && [ $(( $(date +%s) - created )) -ge "$PENDING_WARN_S" ]; then
        echo "ci-wait-wp: warning: pipeline $n has waited over 5 min for a free agent ($SERVER/admin/agents)"
        warned=1
      fi ;;
  esac
  nap
done
