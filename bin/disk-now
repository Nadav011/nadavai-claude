#!/usr/bin/env bash
# disk-now: where the disk space is on the home machines, in seconds. For Nadav, so the
# report is Hebrew.
#
#   disk-now                 this machine and the other one (LENOVO <-> MSI): free space, the
#                            biggest folders and what grew since the scan before
#   disk-now --local         this machine only (what the remote call runs)
#   disk-now --in <path>     the folders and files right under <path>, from the last map
#   disk-now --scan          map this machine now (what the nightly disk-map.timer runs)
#   disk-now --min <GB>      the size from which a folder is listed (default 5)
#
# The report reads a map, not the disk: `--scan` runs du over / (through `sudo -n` and
# `heavy-slot --`; it refuses to start without passwordless sudo) and keeps every folder and
# file of 100 MB or more, to depth 8,
# in ~/.cache/disk-map/<host>.tsv; the map before it stays as <host>.prev.tsv for the growth
# lines. Why: on 2026-11-14 a plain `du` of the LENOVO's home did not finish in 2.5 minutes at
# 94% full, so "what takes the space" had no answer; a nightly map answers it at once.
# Free space always comes from `df` live. Changes nothing outside ~/.cache/disk-map.
set -uo pipefail
case "${1:-}" in -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac

dir=${DISK_NOW_DIR:-$HOME/.cache/disk-map}
if [ -n "${DISK_NOW_NO_SLOT:-}" ] || ! command -v heavy-slot >/dev/null; then DISK_NOW_HEAVY=(); else DISK_NOW_HEAVY=(heavy-slot --); fi
host=$(hostname -s)
map=$dir/$host.tsv prev=$dir/$host.prev.tsv
min_gb=5 mode=report in_path=
while [ $# -gt 0 ]; do
  case "$1" in
    --local) mode=local ;;
    --scan) mode=scan ;;
    --in) mode=in; in_path=${2:?--in needs a path}; shift ;;
    --min) min_gb=${2:?--min needs a number}; shift ;;
    *) echo "disk-now: unknown option $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done

scan() {
  mkdir -p "$dir"
  local root=/ tmp start=$SECONDS
  # Always the whole disk: a map of part of it would read as space that vanished. Without
  # passwordless sudo (a sandboxed agent) there is no scan, before anything heavy starts.
  sudo -n true 2>/dev/null || { echo "disk-now: --scan needs passwordless sudo (sudo -n); the map stays" >&2; return 1; }
  # The whole scan holds the lock (machine-checkup rule 7: one heavy disk job at a time), so a
  # second --scan waits instead of writing over the first one's output.
  exec 9>"$HOME/.cache/machine-checkup.heavy.lock"
  flock 9
  tmp=$(mktemp "$dir/.scan.XXXXXX") || return 1
  scan_tmp=$tmp   # global: the EXIT trap runs after this function's locals are gone
  trap 'rm -f -- "${scan_tmp:?}" "${scan_tmp:?}.err"' EXIT
  # du, not gdu: du prints each folder as it finishes and holds only hardlinked inodes, while
  # gdu keeps the whole tree in memory (20 GB on the LENOVO on 2026-11-14, under memory
  # pressure). heavy-slot admits it by measured load; lowest best-effort IO and CPU priority.
  local rc=0
  : >"$tmp.err"
  "${DISK_NOW_HEAVY[@]}" sudo -n ionice -c2 -n7 nice -n 10 "${DISK_NOW_DU:-du}" -x -a -B1 -t 100M -d 8 "$root" 2>"$tmp.err" >"$tmp" || rc=$?
  # du exits 1 both when a file was unreadable or vanished mid-scan (the map is whole) and when
  # it could not write (a full disk: the map has gaps). A map counts only when du printed the
  # root last and wrote no "write error". Anything else keeps the old map.
  local last; last=$(tail -n1 "$tmp" 2>/dev/null | cut -f2-)
  if [ "$rc" -gt 1 ] || [ "$last" != "$root" ] || grep -qi 'write error' "$tmp.err" ||
    ! sed -i "1i # scanned $(date '+%F %H:%M') root $root seconds $((SECONDS - start))" "$tmp"; then
    rm -f -- "$tmp" "$tmp.err"; echo "disk-now: the scan failed (exit $rc); the old map stays" >&2; return 1
  fi
  rm -f -- "$tmp.err"
  if [ -f "$map" ] && ! ln -f -- "$map" "$prev"; then
    rm -f -- "$tmp"; echo "disk-now: could not keep the previous map; the old map stays" >&2; return 1
  fi
  mv -f -- "$tmp" "$map"
}

gb() { awk -v b="$1" 'BEGIN { printf "%.1f", b / 1073741824 }'; }

# Where the space is, at least $2 bytes per line: each folder of that size shows the part its own
# big sub-folders do not explain, so a big sub-folder shows by itself and a folder full of small
# ones still shows (marked "rest of", tab-separated third field "rest").
deepest() { # file threshold-bytes count
  awk -F'\t' -v t="$2" '!/^#/ && $1 >= t { size[$2] = $1; p = $2; sub(/\/[^\/]*$/, "", p); if (p == "") p = "/"; if (p != $2) { kids[p] += $1; hasbig[p] = 1 } }
    END { for (k in size) { r = size[k] - kids[k]; if (r >= t) print r "\t" k "\t" (k in hasbig ? "rest" : "") } }' "$1" | sort -t$'\t' -k1,1nr | head -n "$3"
}

# Growth since the map before: each path that changed by at least $3 bytes, minus what its own
# changed sub-folders explain, the same way as deepest().
growth() { # current previous threshold count
  awk -F'\t' -v t="$3" 'FNR == 1 { f++ } /^#/ { next } f == 1 { cur[$2] = $1; next } { old[$2] = $1 }
    END {
      for (k in cur) d[k] = cur[k] - (k in old ? old[k] : 0)
      for (k in old) if (!(k in cur)) d[k] = -old[k]
      for (k in d) { a = d[k] < 0 ? -d[k] : d[k]; if (a >= t) keep[k] = d[k] }
      # Each kept change counts against its nearest kept ancestor, so a change two levels down
      # is not lost when the folder between them changed by less than the threshold.
      for (k in keep) { p = k; while (p != "/" && p != "") { sub(/\/[^\/]*$/, "", p); if (p == "") p = "/"; if (p in keep) { kids[p] += keep[k]; hasbig[p] = 1; break } } }
      for (k in keep) { r = keep[k] - kids[k]; a = r < 0 ? -r : r; if (a >= t) print a "\t" r "\t" k "\t" (k in hasbig ? "rest" : "") }
    }' "$1" "$2" | sort -t$'\t' -k1,1nr | cut -f2- | head -n "$4"
}

report_local() {
  local name=${host^^} line
  line=$(df -B1 --output=size,used,avail,pcent / | awk 'NR == 2')
  read -r size used avail pct <<<"$line"
  echo "== $name: דיסק $(gb "$size") ג׳יגה, תפוס $pct, פנוי $(gb "$avail") ג׳יגה"
  if [ ! -s "$map" ]; then echo "   אין מפה עדיין: disk-now --scan (רץ כמה דקות, ברקע)"; return; fi
  local head; head=$(head -n1 "$map")
  echo "   מפה מ-$(awk '{ print $3, $4 }' <<<"$head") (סרקה $(awk '{ print $6 }' <<<"$head"), $(awk '{ print $8 }' <<<"$head") שניות)"
  echo "   התיקיות הכי גדולות (מ-$min_gb ג׳יגה):"
  deepest "$map" "$(awk -v g="$min_gb" 'BEGIN { printf "%.0f", g * 1073741824 }')" 15 |
    while IFS=$'\t' read -r b p rest; do printf '   %7s  %s%s\n' "$(gb "$b")" "$p" "${rest:+ (שאר התיקייה)}"; done
  if [ -s "$prev" ]; then
    local g; g=$(growth "$map" "$prev" 1073741824 10)
    echo "   שינוי מאז המפה הקודמת ($(head -n1 "$prev" | awk '{ print $3, $4 }'), מ-1 ג׳יגה):"
    if [ -z "$g" ]; then echo "   אין שינוי של 1 ג׳יגה ומעלה"; else
      while IFS=$'\t' read -r b p rest; do
        rest=${rest:+ (שאר התיקייה)}
        if [ "$b" -ge 0 ]; then printf '   %7s+ %s%s\n' "$(gb "$b")" "$p" "$rest"; else printf '   %7s- %s%s\n' "$(gb "${b#-}")" "$p" "$rest"; fi
      done <<<"$g"
    fi
  fi
}

case $mode in
  scan) scan ;;
  in)
    [ -s "$map" ] || { echo "disk-now: no map yet, run disk-now --scan" >&2; exit 1; }
    p=$(realpath -m -- "$in_path")
    awk -F'\t' -v p="$p" '!/^#/ { q = $2; sub(/\/[^\/]*$/, "", q); if (q == "") q = "/"; if (q == p && $2 != p) print }' "$map" |
      sort -t$'\t' -k1,1nr | head -n 30 | while IFS=$'\t' read -r b x; do printf '%7s  %s\n' "$(gb "$b")" "$x"; done ;;
  local) report_local ;;
  report)
    report_local
    case $host in lenovo) other=msi ;; msi) other=lenovo ;; *) other= ;; esac
    if [ -n "$other" ]; then
      echo
      ssh -o BatchMode=yes -o ConnectTimeout=5 "$other" bash -s <<<"export PATH=\"\$HOME/.local/bin:\$PATH\"; disk-now --local --min $min_gb" 2>/dev/null ||
        echo "== ${other^^}: לא עונה ברשת, או ש-disk-now לא מותקן בו (update.sh)"
    fi ;;
esac
