#!/bin/bash
# Check for nadavai-watch on nadavai-svc: secscan's poll (system unit, every 2 minutes) ran or is
# running in the last 15 minutes and did not fail. The poll exits 1 when GitHub refuses a listing
# or a status (a dead or expired token), so that shows here too. A stale poll means no PR gets
# nadavai-security, so nothing merges or deploys: on 2026-11-09 that lasted 22 hours with no alert.
set -uo pipefail
prop() { systemctl show secscan-poll.service -p "$1" --value; }
[ "$(systemctl is-enabled secscan-poll.timer 2>/dev/null)" = enabled ] || { echo "secscan-poll.timer is not enabled"; exit 1; }
[ "$(prop ActiveState)" = activating ] && { echo "poll running"; exit 0; }
result=$(prop Result)
[ "$result" = success ] || { echo "secscan's last poll ended with: $result (sudo tail /home/secscan/secscan/logs/secscan.log)"; exit 1; }
last=$(prop ExecMainExitTimestamp)
[ -n "$last" ] || { echo "secscan's poll has not run since boot"; exit 1; }
age=$(( $(date +%s) - $(date -d "$last" +%s) ))
[ "$age" -lt 900 ] || { echo "secscan's poll last ran $((age / 60)) minutes ago ($last)"; exit 1; }
# The nightly full scan (04:20): a run that failed is reported until the next one passes.
nresult=$(systemctl show secscan-nightly.service -p Result --value)
[ "$nresult" = success ] || { echo "secscan's last nightly ended with: $nresult (sudo tail /home/secscan/secscan/logs/secscan.log)"; exit 1; }
echo "poll ran ${age}s ago"
