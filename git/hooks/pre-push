#!/usr/bin/env bash
# GLOBAL PRE-PUSH HOOK v5.0.0 — APEX Industry Standard
#
# LAYER 1 (ALL branches): Trivy CRITICAL CVE scan
# LAYER 2 (main/master only): TypeScript typecheck + affected tests, in parallel with
#   Layer 1, so the push waits for the slowest of the three rather than their sum;
#   then Flutter analyze
#
# Philosophy:
#   - CRITICAL CVEs block ALL pushes (any branch) — security is non-negotiable
#   - TypeScript errors block main/master only — feature branches trust CI
#   - The tests that touch the push block main; the FULL suite runs only when the
#     push could reach tests the import graph does not show (see below), otherwise
#     where nobody waits for it (CI, and the deploy)
#   - A sha nadavai-ci already passed in full, and a documentation-only push, skip
#     typecheck and tests on main: CI ran them on that very tree, or nothing they
#     read changed (see ci_full_pass and classify_push)
#   - Every push appends one line to ~/.cache/nadavai/pre-push.log: what it ran and
#     what each check cost
#   - Everything else (Stryker, Lighthouse, LangGraph) → CI + systemd timers
#   - Bypass: git push --no-verify  (emergency only)

# The whole hook is one { } block, so bash reads all of it before running any of it: an edit
# while a push runs cannot shift the lines under that push (a TF push died on a syntax error
# this way on 2026-10-27).
{
set -uo pipefail
HOOK_T0=${EPOCHREALTIME//[!0-9]/}

# Ensure ~/.local/bin is on PATH (needed on both pop-os and MSI for trivy)
export PATH="$HOME/.local/bin:$PATH"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
cd "$REPO_ROOT"

# ── Read what branch is being pushed ─────────────────────────────
PUSH_TARGET_BRANCH=""
PUSH_LOCAL_SHA=""
PUSH_REMOTE_SHA=""
PUSH_LOCALS=() PUSH_REMOTES=()   # every ref of the push, for the trivy layer
MAIN_LOCAL_SHA="" MAIN_REMOTE_SHA=""
PUSH_REMOTE_NAME=${1:-origin} PUSH_REMOTE_URL=${2:-}
while read -r local_ref local_sha remote_ref remote_sha; do
  PUSH_TARGET_BRANCH=$(echo "$remote_ref" | sed 's|refs/heads/||')
  PUSH_LOCAL_SHA="$local_sha"
  PUSH_REMOTE_SHA="$remote_sha"
  PUSH_LOCALS+=("$local_sha"); PUSH_REMOTES+=("$remote_sha")
  # The main line of a push that carries other refs too (main plus a tag, or main and a branch):
  # the landing check reads it whatever order git hands the refs in.
  case "$remote_ref" in refs/heads/main|refs/heads/master) MAIN_LOCAL_SHA=$local_sha MAIN_REMOTE_SHA=$remote_sha ;; esac
done

IS_MAIN=0
if [[ "$PUSH_TARGET_BRANCH" == "main" || "$PUSH_TARGET_BRANCH" == "master" ]]; then
  IS_MAIN=1
fi

# The GitHub repo the push goes to, for reading nadavai-ci's answer: git hands the hook
# the remote's URL as $2; origin's when it does not.
PUSH_URL=${2:-$(git remote get-url origin 2>/dev/null)}
GH_REPO=""
[[ $PUSH_URL =~ github\.com[:/]([^/]+/[^/]+)$ ]] && GH_REPO=${BASH_REMATCH[1]%.git}

# Each check runs as a background job writing <name>.out, <name>.rc and <name>.sec here.
JOBS_DIR=$(mktemp -d)
PUSH_LOG="$HOME/.cache/nadavai/pre-push.log"
DECISION=branch   # on main: ci-pass-skip | docs-only | related | full:<reason> | typecheck-only | none
GH_SEC=-          # how long reading nadavai-ci's answer took
job_sec() { cat "$JOBS_DIR/$1.sec" 2>/dev/null || echo -; }
since() {  # microsecond epoch -> seconds since then, to a tenth
  local us=$(( ${EPOCHREALTIME//[!0-9]/} - $1 ))
  printf '%d.%d' $(( us / 1000000 )) $(( us / 100000 % 10 ))
}
log_push() {  # one tab-separated line per push; a log it cannot write never fails the push
  mkdir -p "${PUSH_LOG%/*}" 2>/dev/null
  printf '%s\t%s\t%s\t%s\t%s\ttypecheck=%s\ttests=%s\ttrivy=%s\ttotal=%s\tgh=%s\tscan=%s\tlanding=%s\n' "$(date -Iseconds)" \
    "${GH_REPO:-${REPO_ROOT##*/}}" "${PUSH_TARGET_BRANCH:--}" "${PUSH_LOCAL_SHA:0:7}" "$DECISION" \
    "$(job_sec typecheck)" "$(job_sec tests)" "$(job_sec trivy)" "$(since "$HOOK_T0")" "$GH_SEC" \
    "$(cat "$JOBS_DIR/trivy.status" 2>/dev/null || { [ "${HAS_TRIVY:-0}" = 1 ] && echo - || echo missing; })" "${LANDING:--}" \
    >>"$PUSH_LOG" 2>/dev/null
}
trap 'log_push; rm -rf "$JOBS_DIR"' EXIT
start_job() {  # name  command...
  local name="$1"; shift
  ( local t0=$SECONDS; "$@" >"$JOBS_DIR/$name.out" 2>&1; echo $? >"$JOBS_DIR/$name.rc"
    echo $((SECONDS - t0)) >"$JOBS_DIR/$name.sec" ) &
}
job_rc() { cat "$JOBS_DIR/$1.rc" 2>/dev/null || echo 1; }

detect_pm() {
  [ -f "pnpm-lock.yaml" ] && echo "pnpm" && return
  [ -f "bun.lockb" ] || [ -f "bun.lock" ] && echo "bun" && return
  echo "npm"
}

has_script() {
  python3 -c "import json,sys; sys.exit(0 if '$1' in json.load(open('package.json')).get('scripts',{}) else 1)" 2>/dev/null
}

# vitest specifically, not any "test" script: `related` is a vitest command, and a
# repo on jest or node:test would be handed an argument it does not understand.
has_vitest() {
  python3 -c "import json,sys; d=json.load(open('package.json')); sys.exit(0 if 'vitest' in {**d.get('dependencies',{}), **d.get('devDependencies',{})} else 1)" 2>/dev/null
}

# ═══════════════════════════════════════════════════════════════
# LAYER 1: Trivy CRITICAL scan — runs on EVERY push, every branch
# ═══════════════════════════════════════════════════════════════
# trivy scans what the push carries, not the folder on disk. Secrets: every file version the
# push adds to the remote (git rev-list --objects of every pushed ref, minus what the remote
# already has; on a first push, the pushed history up to 30k versions or 1 GB, else the pushed
# trees, said aloud), so a key committed and then removed inside one push is still seen. Dependency
# vulnerabilities: only when the push changes a dependency manifest or lockfile, and then the
# pushed heads' versions of those files (Nadav, D3, 2026-10-27; osv in CI checks every
# dependency on every run). Blobs are written raw by `git cat-file --batch`, so no clean or
# smudge filter (git-crypt, LFS) turns them into text the push does not carry.
# Why: scanning the working folder (until 2026-10-27) blocked a docs push to snooker-smart over
# old lockfiles in nested worktrees and a checkout 607 commits behind, flagged a gitignored diff
# in cash-next-app that is never pushed, timed out on 1.8 GB of untracked planning files in
# therapy-flow-v2, and never counted a secret (secret findings are not table rows).
# A trivy that fails, times out or is missing does not block (D9, unchanged).
DEP_RE='(^|/)(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|bun\.lockb?|requirements[^/]*\.txt|Pipfile(\.lock)?|poetry\.lock|pyproject\.toml|uv\.lock|go\.(mod|sum)|Cargo\.(toml|lock)|Gemfile(\.lock)?|composer\.(json|lock)|Package\.(swift|resolved)|pubspec\.(yaml|lock)|[^/]*\.csproj|packages\.lock\.json|[^/]*\.gradle(\.kts)?|gradle\.lockfile|pom\.xml|mix\.lock|deno\.(json|lock))$'
TRIVY_WRITE='
import os, subprocess, sys
out, listing = sys.argv[1], sys.argv[2]
items = [l.rstrip("\n").split("\t", 1) for l in open(listing, encoding="utf-8", errors="surrogateescape") if "\t" in l]
p = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
n = 0
for i, (spec, path) in enumerate(items):
    p.stdin.write(spec.encode("utf-8", "surrogateescape") + b"\n"); p.stdin.flush()
    head = p.stdout.readline().split()
    if len(head) < 3:
        continue
    data = p.stdout.read(int(head[2])); p.stdout.read(1)
    if head[1] != b"blob":
        continue
    rel = os.path.normpath(path).lstrip("/")
    if rel.startswith(".."):
        rel = os.path.basename(path)
    f = os.path.join(out, str(i), rel)
    os.makedirs(os.path.dirname(f), exist_ok=True)
    with open(f, "wb") as fh:
        fh.write(data)
    n += 1
p.stdin.close(); p.wait()
print(n)
'
trivy_status() { echo "$1" >"$JOBS_DIR/trivy.status"; }   # ok|block|fail|skip, for the log
trivy_scan() {
  local tmp heads=() excl=() i l r n=0 w found=0 rc dep=0 hex='^([0-9a-f]{40}|[0-9a-f]{64})$' zero='^0+$' url name cnt bytes
  export GIT_NO_LAZY_FETCH=1   # a partial clone must not download every missing blob for this
  for i in "${!PUSH_LOCALS[@]}"; do
    l=${PUSH_LOCALS[$i]} r=${PUSH_REMOTES[$i]}
    [[ $l =~ $hex && ! $l =~ $zero ]] || continue   # a deletion carries nothing
    heads+=("$l")
    [[ $r =~ $hex && ! $r =~ $zero ]] && git cat-file -e "$r^{commit}" 2>/dev/null && excl+=("$r")
  done
  [ ${#heads[@]} -eq 0 ] && { echo "nothing pushed to scan (deletions only)"; trivy_status ok; return 0; }
  # What the remote already has: its tracking refs, found by name or, for a push to a URL, by URL.
  name=$PUSH_REMOTE_NAME
  if ! git for-each-ref --count=1 --format=x "refs/remotes/$name/" | grep -q x; then
    url=${PUSH_REMOTE_URL:-$name}
    name=$(git config --get-regexp '^remote\..*\.url$' 2>/dev/null | awk -v u="$url" '$2 == u { sub(/^remote\./, "", $1); sub(/\.url$/, "", $1); print $1; exit }')
  fi
  [ -n "$name" ] && git for-each-ref --count=1 --format=x "refs/remotes/$name/" | grep -q x && excl+=("--remotes=$name")
  tmp=$(mktemp -d -p "${JOBS_DIR:-/tmp}") || { echo "trivy skipped: no temp dir"; trivy_status skip; return 0; }
  mkdir -p "$tmp/s" "$tmp/v"
  # Every blob version the push adds, as "<type> <sha> <size> <path>". With nothing to exclude
  # (a first push, a remote with no tracking refs) that is the pushed history, up to a cap.
  if ! git rev-list --objects --missing=allow-promisor "${heads[@]}" ${excl[@]+--not "${excl[@]}"} >"$tmp/objs" 2>"$tmp/rl.err"; then
    echo "trivy skipped, not blocking: cannot list the pushed objects ($(tail -1 "$tmp/rl.err" | cut -c1-120))"
    trivy_status skip; rm -rf -- "$tmp"; return 0
  fi
  git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' <"$tmp/objs" 2>/dev/null |
    awk '$1 == "blob"' >"$tmp/all"
  if [ ${#excl[@]} -eq 0 ]; then
    cnt=$(wc -l <"$tmp/all"); bytes=$(awk '{ s += $3 } END { print s + 0 }' "$tmp/all")
    if [ "$cnt" -gt 30000 ] || [ "$bytes" -gt 1073741824 ]; then
      echo "history not scanned ($cnt file versions, $((bytes >> 20)) MB, nothing on the remote to compare with): the pushed trees only"
      for l in "${heads[@]}"; do git -c core.quotePath=false ls-tree -r --format='%(objectname) %(path)' "$l"; done |
        git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' 2>/dev/null | awk '$1 == "blob"' >"$tmp/all"
    fi
  fi
  awk '{ print substr($0, length($1) + length($2) + length($3) + 4) }' "$tmp/all" | grep -E "$DEP_RE" | sort -u >"$tmp/deps"
  awk '$3 < 5242880 { print $2 "\t" substr($0, length($1) + length($2) + length($3) + 4) }' "$tmp/all" >"$tmp/blobs"
  # The heads' versions of the dependency files the push changed, whatever their size.
  while IFS= read -r l; do
    while IFS= read -r r; do git cat-file -e "$l:$r" 2>/dev/null && printf '%s:%s\t%s\n' "$l" "$r" "$r"; done <"$tmp/deps"
  done < <(printf '%s\n' "${heads[@]}") >"$tmp/deplist"
  w=$(python3 -I -c "$TRIVY_WRITE" "$tmp/s" "$tmp/blobs") || w=-1
  if [ -s "$tmp/deplist" ]; then
    dep=1
    [ "$(python3 -I -c "$TRIVY_WRITE" "$tmp/v" "$tmp/deplist")" = "$(wc -l <"$tmp/deplist")" ] || w=-1
  fi
  if [ "$w" != "$(wc -l <"$tmp/blobs")" ]; then
    echo "trivy skipped, not blocking: could not write every pushed file (${w} of $(wc -l <"$tmp/blobs"))"; trivy_status skip; rm -rf -- "$tmp"; return 0
  fi
  trivy_status ok
  for l in s v; do
    [ "$l" = v ] && [ "$dep" = 0 ] && continue
    trivy fs "$tmp/$l" --severity CRITICAL --quiet --no-progress --timeout 120s \
      --scanners "$([ "$l" = s ] && echo secret || echo vuln)" --format json --output "$tmp/$l.json" >/dev/null 2>"$tmp/$l.err"
    rc=$?
    if [ "$rc" != 0 ] || [ ! -s "$tmp/$l.json" ]; then
      echo "trivy failed (exit $rc), not blocking: $(tail -1 "$tmp/$l.err" | cut -c1-160)"; trivy_status fail; continue
    fi
    if command -v jq >/dev/null 2>&1; then
      n=$(jq '[.Results[]? | (.Vulnerabilities[]?, .Secrets[]?)] | length' "$tmp/$l.json")
      jq -r '.Results[]? | .Target as $t | (.Vulnerabilities[]? | "  \($t): \(.PkgName) \(.InstalledVersion) \(.VulnerabilityID), fixed in \(.FixedVersion // "?")"), (.Secrets[]? | "  \($t):\(.StartLine) \(.Title)")' "$tmp/$l.json"
    else
      n=$(grep -c '"Severity": "CRITICAL"' "$tmp/$l.json")
    fi
    found=$((found + ${n:-0}))
  done
  echo "scanned $(wc -l <"$tmp/blobs") pushed file version(s) for secrets$([ "$dep" = 1 ] && echo " and $(wc -l <"$tmp/deps") dependency file(s) for vulnerabilities"), ${#heads[@]} ref(s): $found CRITICAL"
  rm -rf -- "$tmp"
  [ "$found" -eq 0 ] || { trivy_status block; return 1; }
}
HAS_TRIVY=0
if command -v trivy >/dev/null 2>&1; then
  HAS_TRIVY=1
  start_job trivy trivy_scan
fi

# ═══════════════════════════════════════════════════════════════
# LAYER 2 setup (main/master): what the tests must cover
# ═══════════════════════════════════════════════════════════════
# Not the whole suite by default. On a repo of this size the full run is minutes and
# the tests that touch one push are seconds — and a gate a person waits minutes for is
# a gate they learn to bypass. `vitest related` runs every test that imports, directly
# or not, any file changed anywhere in the pushed range: the base is what the REMOTE
# already has, so a push of five commits checks all five, and a changed test file is
# itself in the list.
#
# The import graph cannot see everything, so the FULL suite runs instead when:
#   - the base is missing (new branch, or a sha this clone cannot resolve);
#   - a force-rerun trigger changed: package.json, a lockfile, tsconfig, vite/vitest
#     config, a setup file, .env*, fixtures or snapshots (tests read those through fs);
#   - a code file was deleted or renamed (its importers are not in the graph any more);
#   - any file is unclassified (SQL, YAML, shell, HTML...: a test may read it via fs).
# Documentation, licences, .github/ and raster images are ignored, unless the repo's
# vite/vitest config sets its own forceRerunTriggers that match them (triggers_miss).
# A push of nothing but ignored files is documentation only (DOCS_ONLY): typecheck and
# tests read none of it, so neither runs. A code file under .github/ (a workflow's own
# script) is ignored by the tests as before but is no documentation: typecheck may read it.
TEST_MODE=related   # related | full
TEST_REASON=""
RELATED_FILES=()
DOCS_ONLY=0

# 0 when the forceRerunTriggers in the config files named in TRIGGER_CONFIGS (one per
# line) match none of the given files. It reads only a plain list of string literals,
# with vitest's own defaults spread in; anything else (a variable, a call, a comment, a
# negated or extglob pattern) is not certain, so it prints the first file and fails, as
# every repo with its own triggers did before this reader. Its match is looser than
# vitest's (a * crosses /, a trailing /** is optional), so a doubt lands on full too.
triggers_miss() {  # files...
  local out
  out=$(python3 - "$@" 2>/dev/null <<'PY'
import fnmatch, os, re, sys
files = sys.argv[1:]
# configDefaults.forceRerunTriggers in vitest 1 to 4.
DEFAULTS = ["**/package.json/**", "**/{vitest,vite}.config.*/**"]
TOK = re.compile(r"""\s+|,|'([^'\\\n]*)'|"([^"\\\n]*)"|\.\.\.configDefaults\.forceRerunTriggers\b|\]""")
def unsure():
    print(files[0]); sys.exit(1)
def expand(g):
    m = re.search(r"\{([^{}]*)\}", g)
    if not m: return [g]
    return [x for alt in m.group(1).split(",") for x in expand(g[:m.start()] + alt + g[m.end():])]
globs = []
for cfg in os.environ["TRIGGER_CONFIGS"].split("\n"):
    src = open(cfg, encoding="utf-8").read()
    starts = [m.end() for m in re.finditer(r"forceRerunTriggers\s*:\s*\[", src)]
    if not starts or len(starts) != len(re.findall(r"(?<!configDefaults\.)forceRerunTriggers", src)): unsure()
    for pos in starts:
        while True:
            m = TOK.match(src, pos)
            if not m: unsure()
            pos = m.end()
            if m.group(0) == "]": break
            if m.group(1) is not None or m.group(2) is not None:
                globs.append(m.group(1) if m.group(1) is not None else m.group(2))
            elif m.group(0).startswith("..."):
                globs += DEFAULTS
pats = []
for g in globs:
    for e in expand(g):
        if e.startswith("!") or re.search(r"[@!+*?]\(|[{}\\]|\[:", e): unsure()
        pats += [e, e[:-3]] if e.endswith("/**") else [e]
for f in files:
    if any(fnmatch.fnmatchcase(p, g) for p in (os.path.abspath(f), f) for g in pats):
        print(f); sys.exit(1)
PY
  ) && return 0
  echo "${out:-$1}"; return 1
}

classify_push() {
  local base="$PUSH_REMOTE_SHA" head="${PUSH_LOCAL_SHA:-HEAD}" files f name
  case "$base" in
    ''|*[!0]*) ;;          # a real sha, keep it
    *) base="" ;;          # all zeros: the remote has no such branch yet
  esac
  case "$head" in ''|*[!0]*) ;; *) head=HEAD ;; esac
  if [ -z "$base" ] || ! git cat-file -e "${base}^{commit}" 2>/dev/null; then
    TEST_MODE=full; TEST_REASON="the base of the push is not known here"; return
  fi
  if ! files=$(git diff --name-only --no-renames "$base" "$head" 2>/dev/null); then
    TEST_MODE=full; TEST_REASON="git could not diff ${base:0:7}..${head:0:7}"; return
  fi
  # A repo with its own forceRerunTriggers may name any file, so an ignored file is
  # ignored there only when its triggers provably miss it.
  local own_triggers="" docs=() n=0 code_in_docs=""
  own_triggers=$(grep -ls forceRerunTriggers vite.config.* vitest.config.* vitest.workspace.* 2>/dev/null)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    n=$((n + 1))
    name=${f##*/}
    case "$name" in
      package.json|pnpm-lock.yaml|pnpm-workspace.yaml|package-lock.json|npm-shrinkwrap.json|\
      yarn.lock|bun.lock|bun.lockb|.npmrc|.nvmrc|.node-version|tsconfig*.json|jsconfig*.json|\
      vitest.config.*|vitest.workspace.*|vitest.*.config.*|vite.config.*|*[sS]etup*.*|.env*|*.snap)
        TEST_MODE=full; TEST_REASON="$f changed (force-rerun trigger)"; return ;;
    esac
    case "/$f" in
      */fixtures/*|*/__fixtures__/*|*/__snapshots__/*|*/testdata/*|*/test-data/*)
        TEST_MODE=full; TEST_REASON="$f changed (fixture read by tests)"; return ;;
    esac
    case "/$f" in
      /.github/*|*.md|*.txt|*/LICENSE*|*/.gitignore|*.png|*.jpg|*.jpeg|*.gif|*.webp|*.avif|*.ico)
        docs+=("$f")
        case "$name" in
          *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts|*.vue|*.svelte|*.css|*.scss|*.json|*.svg) code_in_docs=1 ;;
        esac
        continue ;;
    esac
    case "$name" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts|*.vue|*.svelte|*.css|*.scss|*.json|*.svg)
        if [ -e "$f" ]; then
          RELATED_FILES+=("$f")
        else
          case "$name" in
            *.test.*|*.spec.*) ;;   # a deleted test leaves nothing to run
            *) TEST_MODE=full; TEST_REASON="$f was deleted or renamed"; return ;;
          esac
        fi ;;
      *) TEST_MODE=full; TEST_REASON="$f is not a file type the import graph covers"; return ;;
    esac
  done <<<"$files"
  if [ ${#docs[@]} -gt 0 ] && [ -n "$own_triggers" ] && ! f=$(TRIGGER_CONFIGS=$own_triggers triggers_miss "${docs[@]}"); then
    TEST_MODE=full; TEST_REASON="$f changed and ${own_triggers%%$'\n'*} sets forceRerunTriggers"; return
  fi
  [ "$n" -gt 0 ] && [ ${#docs[@]} -eq "$n" ] && [ -z "$code_in_docs" ] && DOCS_ONLY=1
}

# The nadavai-ci description of a full-scope pass, on either CI host: NadavAI's bare, the
# MSI's with the [msi:<token>] of its winning claim. A partial scope adds "; outside this
# branch scope, not run: ..." and any other tag (a coverage such as [changed@<sha>]) may
# narrow it, so neither matches. The same pattern is FULL_PASS_RE in ~/nadavai/bin/ci-wait;
# change both together.
FULL_PASS_RE='^passed on (NadavAI|MSI) in [0-9]+m( \[msi:[0-9a-f]{8}\])?$'
CI_PASS=""
ci_status() {  # sha -> "<state>\t<description>" of its nadavai-ci status, or nothing
  [ -n "$GH_REPO" ] && command -v gh >/dev/null 2>&1 || return 1
  timeout 5 gh api "repos/$GH_REPO/commits/$1/status" \
    -q '.statuses[] | select(.context == "nadavai-ci") | [.state, .description] | @tsv' 2>/dev/null | head -1
}
# 0 when nadavai-ci passed this sha in full, with its description in CI_PASS. A sha it
# answered from another commit ("same tree as X", "documentation only since X") counts
# only when X itself passed in full; one level, never further. gh missing, down or
# answering anything else is no pass, and the checks run as before.
ci_full_pass() {  # sha [nested]
  local line desc base
  line=$(ci_status "$1")
  [ "${line%%$'\t'*}" = success ] || return 1
  desc=${line#*$'\t'}
  if [[ $desc =~ $FULL_PASS_RE ]]; then CI_PASS=$desc; return 0; fi
  [ -z "${2:-}" ] && [[ $desc =~ ^(same\ tree\ as|documentation\ only\ since)\ ([0-9a-f]{7,40}),\ which\ passed ]] || return 1
  base=${BASH_REMATCH[2]}
  ci_full_pass "$base" nested || return 1
  CI_PASS="$desc; ${base:0:7}: $CI_PASS"
}

# A head nadavai-ci never saw (a record commit pushed straight to main on top of a batch head
# that passed in full) skips the checks when every commit between it and its nearest
# first-parent ancestor with a full pass is documentation only, by classify_push's own rule.
# Prints that ancestor. At most 10 commits up; one status read per commit tried (v4
# coordinator, 2026-10-27: a STATUS.md commit on a green head ran 275 s of local checks).
docs_on_full_pass() {  # head
  local c=$1 p i
  for ((i = 0; i < 10; i++)); do
    p=$(git rev-parse -q --verify "$c^1" 2>/dev/null) || return 1
    [ "$(PUSH_REMOTE_SHA=$p PUSH_LOCAL_SHA=$1; DOCS_ONLY=0; RELATED_FILES=(); classify_push >/dev/null 2>&1; echo "$DOCS_ONLY")" = 1 ] || return 1
    if ci_full_pass "$p"; then echo "$p"; return 0; fi
    c=$p
  done
  return 1
}

run_typecheck() { "$PM" run typecheck; }
run_tests() {
  # timeout: the related run is meant to cost seconds, so if it ever costs five
  # minutes something is wrong and the person should hear about it rather than
  # watch a terminal hang. --passWithNoTests: a push may touch no test at all.
  if [ "$TEST_MODE" = full ]; then
    timeout 900 npx vitest run --passWithNoTests 2>&1 | tail -20
  elif [ ${#RELATED_FILES[@]} -eq 0 ]; then
    echo "  no code file in the push; nothing to run"
  else
    timeout 300 npx vitest related --run --passWithNoTests "${RELATED_FILES[@]}" 2>&1 | tail -20
  fi
}

# ── Main takes only a landed tree (repos on NadavAI CI) ───────────
# A push to main goes through only when nadavai-ci will answer it without a second full run (Nadav,
# 2026-10-31: SportChat's direct pushes of branch-tier train heads made main rerun 12-23 minutes per
# train). The runner answers a main head without a build when:
#   - the same tree passed at main tier: a `ci-wait <repo> <branch> --land` run (a landing pending,
#     then a full pass), main's own full pass of a commit main already has, or "same tree as X" of
#     such an X: the pushed commit itself, a parent, one of its first five first parents, or main;
#   - only documentation changed since a commit that vouches for itself (a full pass, "same tree as"
#     or "documentation only since" a pass, never affected tests only), on an auto-deploy repo only
#     once that commit is live, at most five first parents up and never past main (docs_since_green).
# Anything else makes main build the whole tree again: refused. Same rule as agent-guard's for
# `gh pr merge`. NADAVAI_LAND_URGENT=<reason> lets an urgent fix through; GitHub unreadable lets the
# push through. Both are logged (landing=). The rules mirror the runner's same_tree_pass and
# docs_since_green, FULL_PASS_RE above and agent-guard's merge_guard: change them together.
LANDING=""
# Documentation as the runner's docs_since_green reads it: every file *.md, none under a code
# directory, supabase/*.md excepted.
landing_docs_only() {  # base head
  local f n=0
  while IFS= read -r -d '' f; do
    n=$((n + 1))
    case "$f" in supabase/*.md) continue ;; src/*|app/*|pages/*|public/*|content/*|messages/*|supabase/*|e2e/*|apps/*|mobile/*) return 1 ;; esac
    case "$f" in *.md) ;; *) return 1 ;; esac
  done < <(git -c core.quotePath=false diff -z --name-only --no-renames "$1" "$2" 2>/dev/null)
  [ "$n" -gt 0 ]
}
LAND_UNREAD=0
# The nadavai-ci round of a commit: "main" (a main-tier landing pass), "full" (any other full pass),
# "tree <sha7>" / "docs <sha7>" (answered from another commit), "other", or "unread" (GitHub could
# not be read; LAND_UNREAD counts those), into LAND_R: no subshell, so the count reaches the caller.
land_round() {  # sha
  local r
  r=$(timeout 10 gh api "repos/$GH_REPO/commits/$1/statuses?per_page=100" 2>/dev/null | jq -r --arg re "$FULL_PASS_RE" 'if type == "array" then
    [sort_by(.id) | reverse | .[] | select(.context == "nadavai-ci")] as $s | ($s | map(.state != "pending") | index(true)) as $f
    | if $f != 0 or ($s[0].state != "success") then "other" else ($s[0].description // "") as $d
      | ($s[1:] | map(.state != "pending") | index(true) // length) as $g
      | if ($d | test($re)) then (if any($s[1:][:$g][]; (.description // "") | contains("at main tier (landing request)")) then "main" else "full" end)
        elif ($d | test("^same tree as [0-9a-f]{7,40}, which passed")) then "tree " + ($d | capture("^same tree as (?<x>[0-9a-f]{7,40})").x)
        elif ($d | test("^documentation only since [0-9a-f]{7,40}, which passed")) then "docs " + ($d | capture("since (?<x>[0-9a-f]{7,40})").x)
        else "other" end end
    else "unread" end' 2>/dev/null)
  [ -n "$r" ] || r=unread
  [ "$r" = unread ] && LAND_UNREAD=$((LAND_UNREAD + 1))
  LAND_R=$r
}
# 0 when nadavai-ci has the commit's tree at main tier: a landing pass, main's own full pass of a
# commit main already has, or "same tree as X" of either (one level).
tree_at_main_tier() {  # sha [nested]
  local r x
  land_round "$1"; r=$LAND_R
  case "$r" in
    main) return 0 ;;
    full) [ -n "$MAIN_REMOTE" ] && git merge-base --is-ancestor "$1" "$MAIN_REMOTE" 2>/dev/null ;;
    "tree "*) [ -z "${2:-}" ] || return 1; x=$(git rev-parse -q --verify "${r#tree }^{commit}" 2>/dev/null) || x=${r#tree }
              tree_at_main_tier "$x" nested ;;
    *) return 1 ;;
  esac
}
# 0 when a commit vouches for a documentation commit on top of it: a pass at main tier (a landing,
# or main's own answer of a commit main has), and on an auto-deploy repo a live deploy.
docs_base_ok() {  # sha
  local r
  land_round "$1"; r=$LAND_R
  case "$r" in
    main) ;;
    # Main's own answers vouch only for commits main already has; a branch-tier pass never does.
    full|"docs "*) [ -n "$MAIN_REMOTE" ] && git merge-base --is-ancestor "$1" "$MAIN_REMOTE" 2>/dev/null || return 1 ;;
    "tree "*) tree_at_main_tier "$1" || return 1 ;;
    *) return 1 ;;
  esac
  [ -z "$LAND_DEPLOY" ] && return 0
  r=$(timeout 10 gh api "repos/$GH_REPO/commits/$1/statuses?per_page=100" 2>/dev/null | jq -r '
    if type == "array" then [sort_by(.id) | reverse | .[] | select(.context == "nadavai-deploy")][0] // {} | ((.state == "success") and ((.description // "") | startswith("live"))) else "unread" end' 2>/dev/null)
  [ "$r" = true ] && return 0
  case "$r" in true|false) ;; *) LAND_UNREAD=$((LAND_UNREAD + 1)) ;; esac
  return 1
}
landed_on_main() {  # 0 when the push to main is a landed tree (LANDED says why), 2 when unsure
  local h=$MAIN_LOCAL_SHA c p i tree cands=()
  tree=$(git rev-parse -q --verify "$h^{tree}" 2>/dev/null) || return 2
  # The tree: the commit itself, its parents, five first parents, and main.
  cands=("$h")
  for p in $(git rev-parse -q --verify "$h^1" 2>/dev/null) $(git rev-parse -q --verify "$h^2" 2>/dev/null); do cands+=("$p"); done
  c=$h; for ((i = 0; i < 5; i++)); do c=$(git rev-parse -q --verify "$c^1" 2>/dev/null) || break; cands+=("$c"); done
  [ -n "$MAIN_REMOTE" ] && cands+=("$MAIN_REMOTE")
  for p in $(printf '%s\n' "${cands[@]}" | awk '!seen[$0]++'); do
    [ "$(git rev-parse -q --verify "$p^{tree}" 2>/dev/null)" = "$tree" ] || continue
    tree_at_main_tier "$p" && { LANDED="the tree of ${p:0:7} passed at main tier"; return 0; }
  done
  # Documentation only since a commit that vouches for it, five first parents up, never past main.
  c=$h
  for ((i = 0; i < 5; i++)); do
    p=$(git rev-parse -q --verify "$c^1" 2>/dev/null) || break
    landing_docs_only "$p" "$h" || break
    if docs_base_ok "$p"; then LANDED="documentation only since ${p:0:7}"; return 0; fi
    [ "$p" = "$MAIN_REMOTE" ] && break
    c=$p
  done
  [ "$LAND_UNREAD" -gt 0 ] && return 2
  return 1
}
if [ -n "$MAIN_LOCAL_SHA" ] && [ "${MAIN_LOCAL_SHA//0/}" != "" ]; then
  if [ -z "$GH_REPO" ] || ! command -v gh >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    [ -n "$GH_REPO" ] && echo "⚠️  pre-push [landing]: gh or jq missing; main pushed without the landing check"
    LANDING=skipped
  else
    gh_owner=${GH_REPO%%/*} gh_name=${GH_REPO##*/} on_ci=""
    if [ "${gh_owner,,}" = nadav011 ]; then
      case "${gh_name,,}" in
        therapy-flow-v2|sportchat-web|cash-next-app|snooker-smart) on_ci=1 ;;
        *) timeout 10 gh api "repos/$GH_REPO/commits/main/statuses?per_page=30" 2>/dev/null |
             jq -e 'type == "array" and any(.[]; .context == "nadavai-ci")' >/dev/null 2>&1 && on_ci=1 ;;
      esac
    fi
    if [ -n "$on_ci" ]; then
      # The repos whose main deploys itself (DEPLOY auto in nadavai-ci): a documentation commit on
      # top of a commit that is not live yet still makes main deploy, a full run.
      LAND_DEPLOY=""; case "${gh_name,,}" in therapy-flow-v2|snooker-smart|cash-next-app) LAND_DEPLOY=1 ;; esac
      MAIN_REMOTE=""; case "$MAIN_REMOTE_SHA" in *[!0]*) git cat-file -e "$MAIN_REMOTE_SHA^{commit}" 2>/dev/null && MAIN_REMOTE=$MAIN_REMOTE_SHA ;; esac
      LANDED=""
      if [ -n "${NADAVAI_LAND_URGENT:-}" ]; then
        echo "⚠️  pre-push [landing]: NADAVAI_LAND_URGENT ($NADAVAI_LAND_URGENT): main runs the full CI on ${MAIN_LOCAL_SHA:0:7}"
        LANDING="urgent:${NADAVAI_LAND_URGENT//[$'\t\n']/ }"
      else
        landed_on_main; rc=$?
        if [ "$rc" = 0 ]; then
          echo "✅ pre-push [landing]: $LANDED"; LANDING="ok"
        elif [ "$rc" = 2 ]; then
          echo "⚠️  pre-push [landing]: GitHub unreadable; main pushed without the landing check"; LANDING=unreadable
        else
          echo ""
          echo "🚫 pre-push [landing]: ${MAIN_LOCAL_SHA:0:7} has no main-tier landing pass, so main would run the full CI on it again."
          echo "   Push the branch, rebase it on main, run ci-wait ${GH_REPO##*/} <branch> --land in the background,"
          echo "   and push or merge it to main after it is green; main then answers by tree. Documentation commits"
          echo "   go on the branch before the landing$([ -n "$LAND_DEPLOY" ] && echo ", or on main once its head is live")."
          echo "   If the landing answered \"same tree as X\", push X's commit. Urgent fix:"
          echo "   NADAVAI_LAND_URGENT='<reason>' git push ...   Emergency: git push --no-verify"
          DECISION=landing-refused LANDING=refused
          kill $(jobs -p) 2>/dev/null; wait 2>/dev/null
          exit 1
        fi
      fi
    fi
  fi
fi

RUN_TYPECHECK=0; RUN_TESTS=0
if [ "$IS_MAIN" = 1 ]; then DECISION=none; fi
if [ "$IS_MAIN" = 1 ] && [ -f "package.json" ]; then
  PM=$(detect_pm)
  HAS_TYPECHECK=0; HAS_VITEST=0
  has_script "typecheck" && HAS_TYPECHECK=1
  has_vitest && HAS_VITEST=1
  if [ "$HAS_TYPECHECK$HAS_VITEST" != 00 ]; then
    classify_push
    if [ "$DOCS_ONLY" = 1 ]; then
      DECISION="docs-only"
    elif [[ ${LANDED:-} == "documentation only since "* ]]; then
      # The landing check found only documentation since a commit at main tier (the runner's rule:
      # every file *.md outside code directories), so nadavai-ci answers "documentation only since"
      # with no run, and the local checks would add nothing. Here even when classify_push could not
      # read a config's forceRerunTriggers (a function call: sportchat-web's forceRerunTriggersAt,
      # 2026-10-31, which ran the whole suite for 301 s on a STATUS.md push).
      DECISION=ci-pass-skip; CI_PASS="$LANDED (the landing check)"
    elif GH_T0=${EPOCHREALTIME//[!0-9]/}; ci_full_pass "$PUSH_LOCAL_SHA"; then
      GH_SEC=$(since "$GH_T0")
      DECISION=ci-pass-skip
    elif anc=$(docs_on_full_pass "$PUSH_LOCAL_SHA"); then
      GH_SEC=$(since "$GH_T0")
      DECISION=ci-pass-skip
      CI_PASS="documentation only since ${anc:0:7}, which passed in full ($CI_PASS)"
    else
      [ -n "$GH_REPO" ] && GH_SEC=$(since "$GH_T0")
      DECISION=$TEST_MODE; [ "$TEST_MODE" = full ] && DECISION="full:$TEST_REASON"
      [ "$HAS_VITEST" = 1 ] || DECISION=typecheck-only
      if [ "$HAS_TYPECHECK" = 1 ]; then
        RUN_TYPECHECK=1
        start_job typecheck run_typecheck
      fi
      if [ "$HAS_VITEST" = 1 ]; then
        RUN_TESTS=1
        start_job tests run_tests
      fi
    fi
  fi
fi

wait

ERRORS=0

if [ "$HAS_TRIVY" = 1 ]; then
  echo ""
  echo "⚡ pre-push [security] — trivy CRITICAL scan"
  echo "────────────────────────────────────────────────"
  sed 's/^/   /' "$JOBS_DIR/trivy.out" 2>/dev/null
  if [ "$(job_rc trivy)" != 0 ]; then
    echo "❌ CRITICAL findings (vulnerabilities or secrets) in what this push carries"
    echo "   View:  trivy fs . --severity HIGH,CRITICAL"
    echo "   Fix:   bash ~/.claude/autoresearch/trivy-auto-pr.sh \$(pwd)"
    echo ""
    ERRORS=$((ERRORS + 1))
  else
    echo "✅ Trivy: 0 CRITICAL findings"
    echo "────────────────────────────────────────────────"
  fi
fi

# Block here if CRITICAL CVEs (applies to all branches)
if [ $ERRORS -gt 0 ]; then
  echo "🚫 Push blocked — fix the CRITICAL findings above"
  echo "   Bypass (emergency): git push --no-verify"
  exit 1
fi

# ═══════════════════════════════════════════════════════════════
# LAYER 2: main/master checks — typecheck + tests + flutter analyze
# ═══════════════════════════════════════════════════════════════
if [ "$IS_MAIN" != 1 ]; then
  # Feature branch — Trivy passed, trust CI for the rest
  exit 0
fi

echo ""
echo "⚡ pre-push [main] — typecheck gate"
echo "────────────────────────────────────────────────"

case "$DECISION" in
  ci-pass-skip) echo "✅ typecheck and tests skipped: nadavai-ci passed ${PUSH_LOCAL_SHA:0:7} in full ($CI_PASS)" ;;
  docs-only) echo "✅ typecheck and tests skipped: documentation only since ${PUSH_REMOTE_SHA:0:7}" ;;
esac

if [ "$RUN_TYPECHECK" = 1 ]; then
  echo "  TypeScript typecheck..."
  cat "$JOBS_DIR/typecheck.out"
  if [ "$(job_rc typecheck)" != 0 ]; then
    echo "❌ typecheck failed — fix before pushing to main"
    ERRORS=$((ERRORS + 1))
  else
    echo "✅ typecheck passed"
  fi
fi

if [ "$RUN_TESTS" = 1 ]; then
  if [ "$TEST_MODE" = full ]; then
    echo "  full test suite: $TEST_REASON..."
    RERUN="npx vitest run"
  else
    echo "  tests related to the ${#RELATED_FILES[@]} changed file(s) of this push (base: ${PUSH_REMOTE_SHA:0:7})..."
    RERUN="npx vitest related --run <the changed files>"
  fi
  cat "$JOBS_DIR/tests.out"
  if [ "$(job_rc tests)" != 0 ]; then
    echo "❌ tests touching this push failed — fix before pushing to main"
    echo "   Run them yourself: $RERUN"
    ERRORS=$((ERRORS + 1))
  else
    echo "✅ affected tests passed"
  fi
fi

# Flutter: analyze (main only)
if [ -f "pubspec.yaml" ] && command -v flutter >/dev/null 2>&1; then
  FLUTTER="${HOME}/.local/bin/flutter"
  [ -f "${HOME}/.flutter-sdk/bin/flutter" ] && FLUTTER="${HOME}/.flutter-sdk/bin/flutter"
  echo "  Flutter analyze..."
  if ! "$FLUTTER" analyze --no-fatal-infos 2>&1 | tail -3; then
    echo "❌ flutter analyze failed"
    ERRORS=$((ERRORS + 1))
  else
    echo "✅ flutter analyze passed"
  fi
fi

echo "────────────────────────────────────────────────"
if [ $ERRORS -gt 0 ]; then
  echo "🚫 Push to main blocked — fix errors above"
  echo "   Bypass: git push --no-verify"
  exit 1
fi
# ═══════════════════════════════════════════════════════════════
# LAYER 3: auto-deploy to Cloudflare Pages (main/master only, opt-in)
# A repo opts in by committing a `.cf-deploy` file whose first non-comment
# line is its Cloudflare Pages project name. Runs in the BACKGROUND so it
# never blocks or fails the push; uses the stored wrangler login. It deploys the
# pushed sha only after the push reached the remote (cf_autodeploy_after_push).
# ═══════════════════════════════════════════════════════════════
if { [ "$PUSH_TARGET_BRANCH" = "main" ] || [ "$PUSH_TARGET_BRANCH" = "master" ]; } && [ -f "$REPO_ROOT/.cf-deploy" ]; then
  CF_PROJECT=$(grep -vE '^\s*#' "$REPO_ROOT/.cf-deploy" | head -1 | tr -d '[:space:]')
  if [ -n "$CF_PROJECT" ]; then
    CF_LOG="/tmp/cf-autodeploy-$CF_PROJECT.log"
    CF_LIB="$HOME/.git-hooks/lib/cf-autodeploy.sh"
    echo "🌐 auto-deploy → Cloudflare Pages ($CF_PROJECT) — after the push lands, in background"
    echo "   (log: $CF_LOG)"
    nohup bash -c "source '$CF_LIB' && cf_autodeploy_after_push '$REPO_ROOT' '$CF_PROJECT' '$CF_LOG' '$PUSH_LOCAL_SHA' '$PUSH_REMOTE_NAME' '$PUSH_TARGET_BRANCH' '$PPID'" >"$CF_LOG" 2>&1 &
    disown 2>/dev/null || true
  fi
fi

echo "🚀 Pushing to main..."
exit 0
}
exit
