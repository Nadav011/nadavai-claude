{
  "model": "opus",
  "advisorModel": "fable",
  "availableModels": [
    "opus",
    "sonnet",
    "haiku",
    "fable"
  ],
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "language": "hebrew",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "VITEST_MAX_THREADS": "6",
    "VITEST_MIN_THREADS": "1",
    "VITEST_MAX_FORKS": "6",
    "MAKEFLAGS": "-j6",
    "CARGO_BUILD_JOBS": "6",
    "UV_THREADPOOL_SIZE": "8",
    "NEXT_TELEMETRY_DISABLED": "1",
    "IMPECCABLE_NO_TELEMETRY": "1",
    "POSTHOG_MCP_EXEC_GATE_DISABLE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "disableClaudeAiConnectors": true,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "node \"${NADAVAI_HOME:-$HOME/nadavai}/bin/nadavai-statusline\""
  },
  "enabledPlugins": {
    "nadavai@nadavai": true,
    "oh-my-claudecode@omc": false,
    "i-have-adhd@i-have-adhd": true,
    "context7@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "claude-seo@agricidaniel-claude-seo": false,
    "impeccable@impeccable": true,
    "ux-design@wondelai-skills": false,
    "product-innovation@wondelai-skills": false,
    "product-strategy@wondelai-skills": false,
    "metaskills@wondelai-skills": false,
    "intent@intent": true,
    "posthog@posthog": false,
    "interfaces@interfaces": true,
    "engineering@synced": false,
    "design@synced": false,
    "miro@synced": false,
    "canva@synced": false,
    "contentasoft-cad-converter@synced": false,
    "adobe-for-creativity@synced": false,
    "agents-plus@agents-plus-dev": false
  },
  "extraKnownMarketplaces": {
    "nadavai": {
      "source": {
        "source": "github",
        "repo": "Nadav011/nadavai-claude"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      },
      "autoUpdate": true
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "wondelai-skills": {
      "source": {
        "source": "github",
        "repo": "wondelai/skills"
      },
      "autoUpdate": true
    },
    "intent": {
      "source": {
        "source": "github",
        "repo": "ghaida/intent"
      },
      "autoUpdate": true
    },
    "posthog": {
      "source": {
        "source": "github",
        "repo": "PostHog/ai-plugin"
      },
      "autoUpdate": true
    },
    "interfaces": {
      "source": {
        "source": "github",
        "repo": "jakubkrehel/skills"
      },
      "autoUpdate": true
    }
  },
  "skipWorkflowUsageWarning": true,
  "deniedMcpServers": [
    {
      "serverName": "plugin:chrome-devtools-mcp:chrome-devtools"
    },
    {
      "serverName": "plugin:cloudflare:cloudflare"
    },
    {
      "serverName": "plugin:supabase:supabase"
    },
    {
      "serverName": "plugin:context7:context7"
    }
  ]
}
