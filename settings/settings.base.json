{
  "model": "claude-fable-5-1[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "language": "hebrew",
  "permissions": {
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "disableClaudeAiConnectors": true,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "nadavai@nadavai": true,
    "oh-my-claudecode@omc": true,
    "i-have-adhd@i-have-adhd": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-seo@agricidaniel-claude-seo": false,
    "impeccable@impeccable": true,
    "ux-design@wondelai-skills": true,
    "product-innovation@wondelai-skills": true,
    "product-strategy@wondelai-skills": true,
    "metaskills@wondelai-skills": true,
    "intent@intent": true,
    "posthog@posthog": true,
    "interfaces@interfaces": true
  },
  "extraKnownMarketplaces": {
    "nadavai": {
      "source": {
        "source": "github",
        "repo": "Nadav011/nadavai-claude"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      },
      "autoUpdate": true
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "wondelai-skills": {
      "source": {
        "source": "github",
        "repo": "wondelai/skills"
      },
      "autoUpdate": true
    },
    "intent": {
      "source": {
        "source": "github",
        "repo": "ghaida/intent"
      },
      "autoUpdate": true
    },
    "posthog": {
      "source": {
        "source": "github",
        "repo": "PostHog/ai-plugin"
      },
      "autoUpdate": true
    },
    "interfaces": {
      "source": {
        "source": "github",
        "repo": "jakubkrehel/skills"
      },
      "autoUpdate": true
    }
  }
}
